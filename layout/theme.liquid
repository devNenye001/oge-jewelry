<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#FFFFFF' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <!-- Favicon -->
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% else %}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {% endif %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts: Cormorant Garamond, DM Sans & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

    <!-- Design Tokens, Typography & Theme Stylesheets -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      window.Shopify = window.Shopify || {};
      window.Shopify.money_format = {{ shop.money_format | json }};
      window.Shopify.currency = {{ cart.currency.iso_code | default: shop.currency | json }};
      window.Shopify.routes = {
        root: "{{ routes.root_url }}",
        cart: "{{ routes.cart_url }}",
        cart_add_url: "{{ routes.cart_add_url }}",
        cart_change_url: "{{ routes.cart_change_url }}",
        cart_update_url: "{{ routes.cart_update_url }}",
        cart_clear_url: "{{ routes.cart_clear_url }}"
      };
    </script>

    <!-- Theme Core JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <!-- Main Navigation & Header Section -->
    {% section 'header' %}

    <!-- Search Modal Overlay (Image 1 Upload Match) -->
    {% render 'search-modal' %}

    <!-- Sales Offer Pop-Up Modal Section -->
    {% section 'newsletter-popup' %}

    <!-- Main Page Content Template -->
    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section -->
    {% section 'footer' %}
  </body>
</html>
