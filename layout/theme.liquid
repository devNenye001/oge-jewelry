<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#FFFFFF' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <!-- Favicon -->
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% else %}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {% endif %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts: Cormorant Garamond, DM Sans & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

    <!-- Design Tokens, Typography & Theme Stylesheets -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      window.Shopify = window.Shopify || {};
      window.Shopify.money_format = {{ shop.money_format | json }};
      window.Shopify.currency = {
        active: {{ cart.currency.iso_code | default: shop.currency | json }},
        rate: "1.0"
      };
      window.Shopify.shopCurrency = {{ shop.currency | json }};
      window.Shopify.routes = {
        root: "{{ routes.root_url }}",
        cart: "{{ routes.cart_url }}",
        cart_add_url: "{{ routes.cart_add_url }}",
        cart_change_url: "{{ routes.cart_change_url }}",
        cart_update_url: "{{ routes.cart_update_url }}",
        cart_clear_url: "{{ routes.cart_clear_url }}"
      };
      (function() {
        try {
          var activeCurr = {{ cart.currency.iso_code | default: shop.currency | json }};
          if (activeCurr && document.cookie.indexOf('cart_currency=') === -1) {
            document.cookie = 'cart_currency=' + encodeURIComponent(activeCurr) + '; path=/; SameSite=Lax';
          }
        } catch(e) {}
      })();
    </script>

    <!-- Catalog Dataset & Helpers -->
    <script src="{{ 'catalog-data.js' | asset_url }}"></script>
    <!-- Storefront Translations Engine -->
    <script src="{{ 'translations.js' | asset_url }}"></script>
    <!-- Theme Core JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <!-- Standalone 404 Error Display Overlay -->
    <style id="maintenance-404-style">
      html, body {
        overflow: hidden !important;
        height: 100% !important;
        background-color: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      #maintenance-404-overlay {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background-color: #ffffff !important;
        z-index: 2147483647 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 24px !important;
        box-sizing: border-box !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
        color: #000000 !important;
        text-align: center !important;
      }
      #maintenance-404-overlay .error-card {
        max-width: 500px !important;
        width: 100% !important;
        text-align: center !important;
      }
      #maintenance-404-overlay h1 {
        font-size: 24px !important;
        font-weight: 600 !important;
        line-height: 1.3 !important;
        color: #000000 !important;
        margin: 0 0 8px 0 !important;
        letter-spacing: -0.02em !important;
      }
      #maintenance-404-overlay p.desc {
        font-size: 14px !important;
        line-height: 1.5 !important;
        color: #666666 !important;
        margin: 0 0 32px 0 !important;
      }
      #maintenance-404-overlay .code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        color: #000000 !important;
        margin: 0 0 10px 0 !important;
        letter-spacing: 0.05em !important;
      }
      #maintenance-404-overlay .id {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
        font-size: 12px !important;
        color: #888888 !important;
        margin: 0 !important;
      }
    </style>
    <div id="maintenance-404-overlay">
      <div class="error-card">
        <h1>This page doesn’t exist</h1>
        <p class="desc">It may have been moved, removed, or never existed.</p>
        <div class="code">404 NOT_FOUND</div>
        <div class="id">fra1::g67qk-1793616830527-45b3bd01bf29</div>
      </div>
    </div>
    <!-- Main Navigation & Header Section -->
    {% section 'header' %}

    <!-- Search Modal Overlay (Image 1 Upload Match) -->
    {% render 'search-modal' %}

    <!-- Sales Offer Pop-Up Modal Section -->
    {% section 'newsletter-popup' %}

    <!-- Main Page Content Template -->
    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section -->
    {% section 'footer' %}
  </body>
</html>
