<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg | default: '#FFFFFF' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>{{ shop.name }} &ndash; Opening Soon</title>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>
  <body class="template-password" style="display: flex; align-items: center; justify-content: center; min-height: 100vh; text-align: center; background: #0D0D0D; color: #FFFFFF;">
    <main role="main" id="MainContent" style="width: 100%;">
      {{ content_for_layout }}
    </main>
  </body>
</html>
