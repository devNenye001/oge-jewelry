{% comment %}
  OGÉ Fine Jewelry - Search Modal Overlay
  Features:
  - Top search input bar with search icon & close button
  - Quick access visual cards for Rings (rings-category.jpg) and Earrings (ear.jpg)
  - Shopify Predictive Search suggestions container (live catalog suggestions)
{% endcomment %}

<div class="search-modal-backdrop" data-search-backdrop></div>
<div class="search-modal" data-search-modal role="dialog" aria-modal="true" aria-label="Search Catalog">
  <div class="search-modal__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form" data-search-form>
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <div class="search-modal__bar">
        <span class="search-modal__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" width="22" height="22">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
        </span>
        <input 
          type="search" 
          name="q"
          class="search-modal__input" 
          placeholder="What are you looking for?" 
          data-search-input 
          aria-label="Search products"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button type="button" class="search-modal__close" data-search-close aria-label="Close Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" width="20" height="20">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </form>

    <!-- Category Quick Access Cards -->
    <div class="search-modal__categories" data-search-categories>
      <!-- Rings Card -->
      <a href="{{ routes.collections_url }}/rings" class="search-category-card">
        <div class="search-category-card__media">
          <img src="{{ 'rings-category.jpg' | asset_url }}" alt="Rings" class="search-category-card__image" loading="lazy" width="300" height="300">
        </div>
        <span class="search-category-card__title">Rings</span>
      </a>

      <!-- Earrings Card -->
      <a href="{{ routes.collections_url }}/earrings" class="search-category-card">
        <div class="search-category-card__media">
          <img src="{{ 'sales1.jpg' | asset_url }}" alt="Earrings" class="search-category-card__image" loading="lazy" width="400" height="400">
        </div>
        <span class="search-category-card__title">Earrings</span>
      </a>
    </div>

    <!-- Live Predictive Search Suggestions Container -->
    <div class="search-modal__predictive" data-predictive-search style="display: none;" aria-live="polite"></div>
  </div>
</div>
