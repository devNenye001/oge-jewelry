{% comment %}
  OGÉ Fine Jewelry - Wishlist Page Content Snippet
{% endcomment %}

<section class="wishlist-page-section" data-section-id="{{ section.id }}" data-section-type="wishlist">
  <div class="wishlist-container">

    <!-- Top Navigation Link: Back to Overview -->
    <a href="/collections/all?view=account" class="wishlist-back-link" aria-label="Back to Account Overview">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>{{ section.settings.back_text | default: 'Back to Overview' }}</span>
    </a>

    <!-- Page Heading -->
    <h1 class="wishlist-page-title">{{ page.title | default: 'WISHLIST' }}</h1>
    <hr class="wishlist-title-divider">

    <!-- STATE A: ACTIVE WISHLIST (WHEN ITEMS ARE SAVED) -->
    <div class="wishlist-state-wrapper" id="wishlist-active-state">
      <!-- Sub-header bar: Item Count & Carousel Controls -->
      <div class="wishlist-header-bar">
        <span class="wishlist-count-text">Your saved items (<span data-wishlist-total>0</span>)</span>
        <div class="carousel-nav-btns" id="wishlist-nav-btns">
          <button type="button" class="carousel-nav-btn" id="btn-wishlist-prev" aria-label="Previous saved item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="carousel-nav-btn" id="btn-wishlist-next" aria-label="Next saved item">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <!-- Saved Items Grid Container -->
      <div class="wishlist-grid" id="wishlist-items-container"></div>
    </div>

    <!-- STATE B: EMPTY WISHLIST (WHEN NO ITEMS ARE SAVED) -->
    <div class="wishlist-state-wrapper" id="wishlist-empty-state" style="display: none;">
      <div class="wishlist-empty-state">
        <h2 class="wishlist-empty-title">{{ section.settings.empty_title | default: 'Nothing has been saved to your Wishlist' }}</h2>
        <p class="wishlist-empty-subtitle">{{ section.settings.empty_subtitle | default: "It looks like you haven't saved any items yet, why not check out our best sellers?" }}</p>
        <a href="{{ section.settings.empty_btn_link | default: routes.all_products_collection_url }}" class="btn wishlist-shop-btn">
          {{ section.settings.empty_btn_label | default: 'Shop' }}
        </a>
      </div>

      <!-- Recommendations Section for Empty State -->
      <section class="wishlist-recommendations" aria-label="Recommended Best Sellers">
        <div class="account-recommendations__header">
          <h2 class="account-recommendations__title">{{ section.settings.rec_heading | default: 'YOU MAY ALSO LIKE' }}</h2>
          <div class="account-recommendations__controls">
            <button type="button" class="account-nav-arrow-btn" aria-label="Previous recommendation" id="btn-wishlist-rec-prev">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="account-nav-arrow-btn" aria-label="Next recommendation" id="btn-wishlist-rec-next">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        </div>

        <div class="account-product-grid" id="wishlist-rec-grid">
          {% assign rec_col = collections['all'] %}
          {% if rec_col != blank and rec_col.products.size > 0 %}
            {% for rec_product in rec_col.products limit: 8 %}
              {% render 'product-card', product: rec_product %}
            {% endfor %}
          {% endif %}
        </div>
      </section>
    </div>

  </div>
</section>
