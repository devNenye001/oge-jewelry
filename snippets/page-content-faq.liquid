{% comment %}
  OGÉ Fine Jewelry - FAQ Page Content Snippet
{% endcomment %}

<section class="faq-section" style="padding: 40px 0 64px; background-color: #FFFFFF;">
  <div class="page-container">
    <div style="text-align: center; margin-bottom: 40px;">
      <h1 class="heading-section" style="font-size: 28px; letter-spacing: 0.15em;">{{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}</h1>
    </div>

    <div class="faq-accordion-wrap">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="faq-card-item {% if forloop.first %}is-active{% endif %}" data-faq-item {{ block.shopify_attributes }}>
            <button type="button" class="faq-card-question">
              <span>{{ block.settings.question }}</span>
              <span class="faq-card-icon">{% if forloop.first %}—{% else %}+{% endif %}</span>
            </button>
            <div class="faq-card-answer">
              <p>{{ block.settings.answer }}</p>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- FAQ 1 (Active by default with #995544 rounded border) -->
        <div class="faq-card-item is-active" data-faq-item>
          <button type="button" class="faq-card-question">
            <span>What does OGÉ Jewelry represent?</span>
            <span class="faq-card-icon">—</span>
          </button>
          <div class="faq-card-answer">
            <p>
              OGÉ Jewelry is rooted in self–expression, self-worth, resilience, and transformation. Each piece is designed to be more than an accessory — it is a reminder to honor who you are, where you've been, and who you are becoming.
            </p>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-card-item" data-faq-item>
          <button type="button" class="faq-card-question">
            <span>How long will my order take to arrive?</span>
            <span class="faq-card-icon">+</span>
          </button>
          <div class="faq-card-answer">
            <p>
              Standard delivery within the US typically takes 3–5 business days. Express shipping options are also available at checkout for next-day and 2-day delivery.
            </p>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-card-item" data-faq-item>
          <button type="button" class="faq-card-question">
            <span>Can I change or cancel my order?</span>
            <span class="faq-card-icon">+</span>
          </button>
          <div class="faq-card-answer">
            <p>
              We process orders promptly. If you need to make changes or cancel, please contact our support concierge within 2 hours of placing your order.
            </p>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="faq-card-item" data-faq-item>
          <button type="button" class="faq-card-question">
            <span>Are OGÉ pieces suitable for everyday wear?</span>
            <span class="faq-card-icon">+</span>
          </button>
          <div class="faq-card-answer">
            <p>
              Yes. All our jewelry is sculpted from solid gold and high-grade ethical gemstones engineered to withstand daily wear without tarnishing.
            </p>
          </div>
        </div>

        <!-- FAQ 5 -->
        <div class="faq-card-item" data-faq-item>
          <button type="button" class="faq-card-question">
            <span>Will I receive an order confirmation?</span>
            <span class="faq-card-icon">+</span>
          </button>
          <div class="faq-card-answer">
            <p>
              Yes, you will immediately receive an email confirmation with your order number, itemized receipt, and tracking information once dispatched.
            </p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>
