{% comment %}
  OGÉ Fine Jewelry - Bundle Deals Card Grid Snippet
  Extracts and renders live Bundle Deals from Shopify
{% endcomment %}

{%- comment -%}
  1. UNIVERSAL COLLECTION RESOLUTION
{%- endcomment -%}
{% assign bundle_coll = nil %}
{% if collections['bundle-deals'] != blank and collections['bundle-deals'].products.size > 0 %}
  {% assign bundle_coll = collections['bundle-deals'] %}
{% elsif collections['bundle-deal'] != blank and collections['bundle-deal'].products.size > 0 %}
  {% assign bundle_coll = collections['bundle-deal'] %}
{% elsif collections['bundles'] != blank and collections['bundles'].products.size > 0 %}
  {% assign bundle_coll = collections['bundles'] %}
{% elsif collections['bundle'] != blank and collections['bundle'].products.size > 0 %}
  {% assign bundle_coll = collections['bundle'] %}
{% elsif collections['all-bundle-deals'] != blank and collections['all-bundle-deals'].products.size > 0 %}
  {% assign bundle_coll = collections['all-bundle-deals'] %}
{% elsif collection != blank and collection.handle contains 'bundle' and collection.products.size > 0 %}
  {% assign bundle_coll = collection %}
{% else %}
  {% for c in collections %}
    {% assign c_title = c.title | downcase %}
    {% assign c_handle = c.handle | downcase %}
    {% if c_title contains 'bundle' or c_handle contains 'bundle' %}
      {% if c.products.size > 0 %}
        {% assign bundle_coll = c %}
        {% break %}
      {% elsif bundle_coll == blank %}
        {% assign bundle_coll = c %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{%- comment -%}
  2. EXTRACT HERO PRODUCTS FROM SHOPIFY BUNDLE COLLECTION
{%- endcomment -%}
{% assign card_1_prod = nil %}
{% assign card_2_prod = nil %}

{% if bundle_coll != blank and bundle_coll.products.size > 0 %}
  {% assign card_1_prod = bundle_coll.products[0] %}
  {% if bundle_coll.products.size > 1 %}
    {% assign card_2_prod = bundle_coll.products[1] %}
  {% else %}
    {% assign card_2_prod = bundle_coll.products[0] %}
  {% endif %}
{% endif %}

<div class="bundle-deals-wrapper" style="padding-top: 24px;">
  <h1 class="bundle-deals-heading">{{ heading | default: 'BUNDLE DEALS' }}</h1>
  <hr class="category-divider-line" style="margin: 0 auto 36px; max-width: 100%;">

  <!-- 2-Card Hero Showcase Grid -->
  <div class="bundle-deals-grid">
    <!-- Card 1 -->
    <div class="bundle-card" id="snippet-bundle-hero-card-1">
      {% if card_1_image != blank %}
        {{ card_1_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: 'Bundle Deal 1' }}
      {% elsif card_1_prod != blank and card_1_prod.featured_image != blank %}
        {{ card_1_prod.featured_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: card_1_prod.title }}
      {% else %}
        <img src="{{ 'sales1.jpg' | asset_url }}" alt="Bundle deal" class="bundle-card__img" loading="eager" width="800" height="1000">
      {% endif %}

      <div class="bundle-card__overlay">
        <span class="bundle-card__eyebrow">{{ card_1_eyebrow | default: 'Bundle deal' }}</span>

        <h2 class="bundle-card__title">
          {% if card_1_title != blank %}
            {{ card_1_title }}
          {% elsif card_1_prod != blank %}
            {{ card_1_prod.title | upcase }}
          {% else %}
            2 ALA RINGS FOR $150
          {% endif %}
        </h2>

        {% assign c1_price_str = card_1_price %}
        {% if c1_price_str == blank and card_1_prod != blank %}
          {% assign c1_price_str = card_1_prod.price | divided_by: 100.0 %}
        {% endif %}
        {% if c1_price_str == blank %}{% assign c1_price_str = '150' %}{% endif %}

        <button 
          type="button" 
          class="bundle-card__link bundle-card__add-btn" 
          data-bundle-add="1" 
          data-bundle-title="{% if card_1_title != blank %}{{ card_1_title | strip_html | escape }}{% elsif card_1_prod != blank %}{{ card_1_prod.title | strip_html | escape }}{% else %}2 ALA RINGS FOR $150{% endif %}"
          data-bundle-price="{{ c1_price_str }}"
          data-product-handle="{{ card_1_prod.handle | default: 'ala-ring' }}"
          data-variant-id="{{ card_1_prod.selected_or_first_available_variant.id }}"
          aria-label="Add bundle deal to Bag"
        >
          Shop Now
        </button>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="bundle-card" id="snippet-bundle-hero-card-2">
      {% if card_2_image != blank %}
        {{ card_2_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: 'Bundle Deal 2' }}
      {% elsif card_2_prod != blank and card_2_prod.featured_image != blank %}
        {{ card_2_prod.featured_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: card_2_prod.title }}
      {% else %}
        <img src="{{ 'sales2.jpg' | asset_url }}" alt="Jewelry Set Offer" class="bundle-card__img" loading="eager" width="800" height="1000">
      {% endif %}

      <div class="bundle-card__overlay">
        <span class="bundle-card__eyebrow">{{ card_2_eyebrow | default: 'Jewelry Set Offer' }}</span>

        <h2 class="bundle-card__title">
          {% if card_2_title != blank %}
            {{ card_2_title }}
          {% elsif card_2_prod != blank %}
            {{ card_2_prod.title | upcase }}
          {% else %}
            VALOR EARRING +<br>NECKLACE FOR $200
          {% endif %}
        </h2>

        {% assign c2_price_str = card_2_price %}
        {% if c2_price_str == blank and card_2_prod != blank %}
          {% assign c2_price_str = card_2_prod.price | divided_by: 100.0 %}
        {% endif %}
        {% if c2_price_str == blank %}{% assign c2_price_str = '200' %}{% endif %}

        <button 
          type="button" 
          class="bundle-card__link bundle-card__add-btn" 
          data-bundle-add="2" 
          data-bundle-title="{% if card_2_title != blank %}{{ card_2_title | strip_html | escape }}{% elsif card_2_prod != blank %}{{ card_2_prod.title | strip_html | escape }}{% else %}VALOR EARRING + NECKLACE FOR $200{% endif %}"
          data-bundle-price="{{ c2_price_str }}"
          data-product-handle="{{ card_2_prod.handle | default: 'valor-necklace' }}"
          data-variant-id="{{ card_2_prod.selected_or_first_available_variant.id }}"
          aria-label="Add bundle deal to Bag"
        >
          Shop Now
        </button>
      </div>
    </div>
  </div>

  <!-- 3. ALL PRODUCTS FROM SHOPIFY BUNDLE DEALS COLLECTION -->
  <div class="bundle-products-section" style="margin-top: 64px;">
    <div class="bundle-products-header" style="text-align: center; margin-bottom: 32px;">
      <h2 style="font-family: var(--font-heading); font-size: clamp(1.35rem, 2.5vw, 1.875rem); letter-spacing: -0.02em; text-transform: uppercase; color: #111111; margin: 0 0 8px;">
        Shop All Bundle Deals
      </h2>
      <p style="font-family: var(--font-body); font-size: 0.875rem; color: #666666; margin: 0;">
        All curated sets and special bundle offers directly from our Shopify catalog.
      </p>
    </div>

    <div class="collection-products-grid grid--4-col" id="snippet-bundle-products-grid">
      {% if bundle_coll != blank and bundle_coll.products.size > 0 %}
        {% for product in bundle_coll.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% assign fallback_bundles_count = 0 %}
        {% for product in collections.all.products %}
          {% assign pt = product.title | downcase %}
          {% assign ptype = product.type | downcase %}
          {% if pt contains 'bundle' or pt contains 'deal' or pt contains 'set' or product.tags contains 'bundle' or product.tags contains 'bundles' or ptype contains 'bundle' %}
            {% render 'product-card', product: product %}
            {% assign fallback_bundles_count = fallback_bundles_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if fallback_bundles_count == 0 %}
          {% for product in collections.all.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

<hr class="category-divider-line">
