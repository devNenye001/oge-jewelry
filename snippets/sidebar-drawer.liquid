{% doc %}
Renders the multi-level sliding sidebar drawer navigation matching Figma mockups.
{% enddoc %}

<!-- Drawer Backdrop Overlay -->
<div class="drawer-backdrop" data-drawer-backdrop></div>

<!-- Sidebar Drawer -->
<div class="sidebar-drawer" data-sidebar-drawer role="dialog" aria-modal="true" aria-label="Navigation Menu">
  <div class="sidebar-panels" data-sidebar-panels>

    <!-- ====================================================================
         PANEL 1: MAIN NAVIGATION (LEVEL 1 - Exact Figma Mobile Sidebar)
         ==================================================================== -->
    <div class="sidebar-panel sidebar-panel--main">
      <!-- Sidebar Header Bar: Close on Left, Centered Logo, Search & Profile on Far Right -->
      <div class="sidebar-header-bar">
        <button class="sidebar-close-btn" data-sidebar-close aria-label="{{ 'general.close' | t }}" id="btn-sidebar-close">
          {% render 'icon-close' %}
        </button>
        <a href="{{ routes.root_url }}" class="sidebar-logo-center" aria-label="OGÉ Home">
          <img src="{{ 'logo2.png' | asset_url }}" alt="{{ shop.name | default: '06é' }}" class="site-logo__image">
        </a>
        <div class="sidebar-header-actions">
          <a href="{{ routes.search_url }}" class="header-icon-btn" data-search-open aria-label="{{ 'general.search' | t }}">
            {% render 'icon-search' %}
          </a>
          <a href="{{ routes.account_url | default: '/account/login' }}" class="header-icon-btn" aria-label="{{ 'general.account' | t }}">
            {% render 'icon-account' %}
          </a>
        </div>
      </div>

      <!-- Main Navigation Menu Items -->
      {% assign nav_menu = linklists[menu] | default: linklists['main-menu'] %}
      <nav class="sidebar-nav" aria-label="Main Navigation">
        <ul class="sidebar-nav__list">
          {% if nav_menu != blank and nav_menu.links.size > 0 %}
            {% for link in nav_menu.links %}
              <li class="sidebar-nav__item">
                {% if link.links.size > 0 %}
                  <button type="button" class="sidebar-nav__btn" data-submenu-trigger="submenu-{{ link.handle }}" data-submenu-title="{{ link.title | escape }}">
                    <span>{{ link.title }}</span>
                    <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
                  </button>
                {% else %}
                  <a href="{{ link.url }}" class="sidebar-nav__link">
                    <span>{{ link.title }}</span>
                    <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          {% else %}
            <li class="sidebar-nav__item">
              <a href="/collections/new-in" class="sidebar-nav__link">
                <span>New In</span>
                <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
              </a>
            </li>

            <li class="sidebar-nav__item">
              <button type="button" class="sidebar-nav__btn" data-submenu-trigger="submenu-jewelry" data-submenu-title="Jewelry" id="btn-menu-jewelry">
                <span>Jewelry</span>
                <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
              </button>
            </li>

            <li class="sidebar-nav__item">
              <a href="/collections/men" class="sidebar-nav__link">
                <span>Men</span>
                <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
              </a>
            </li>

            <li class="sidebar-nav__item">
              <a href="/collections/fine-jewelry" class="sidebar-nav__link">
                <span>Fine Jewelry</span>
                <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
              </a>
            </li>

            <li class="sidebar-nav__item">
              <button type="button" class="sidebar-nav__btn" data-submenu-trigger="submenu-collections" data-submenu-title="Collections" id="btn-menu-collections">
                <span>Collections</span>
                <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
              </button>
            </li>

            <li class="sidebar-nav__item">
              <a href="/pages/our-story" class="sidebar-nav__link">
                <span>Our Story</span>
                <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
              </a>
            </li>
          {% endif %}
        </ul>
      </nav>

      <hr class="sidebar-divider">

      <!-- Sidebar Footer (Secondary Links & Currency/Language) -->
      <div class="sidebar-footer">
        {% if shop.customer_accounts_enabled %}
          {% if customer %}
            <a href="{{ routes.account_url }}" class="sidebar-footer__link">{{ 'general.account' | t }}</a>
          {% else %}
            <a href="{{ routes.account_login_url }}" class="sidebar-footer__link">{{ 'general.login' | t }}</a>
          {% endif %}
        {% else %}
          <a href="/account/login" class="sidebar-footer__link">{{ 'general.login' | t }}</a>
        {% endif %}

        <a href="/pages/wishlist" class="sidebar-footer__link">{{ 'general.wishlist' | t }}</a>

        <!-- Localization Selector (US Flag + Country / Language) -->
        <div class="sidebar-localization">
          <svg class="sidebar-localization__flag" viewBox="0 0 20 14" width="18" height="12" fill="none">
            <rect width="20" height="14" fill="#B22234"/>
            <path d="M0 2.154h20M0 4.308h20M0 6.462h20M0 8.615h20M0 10.769h20M0 12.923h20" stroke="#FFFFFF" stroke-width="1.077"/>
            <rect width="8" height="7.538" fill="#3C3B6E"/>
          </svg>
          <span>{{ 'sidebar.united_states' | t }} &nbsp;|&nbsp; {{ 'sidebar.english' | t }}</span>
          {% render 'icon-chevron', direction: 'down' %}
        </div>
      </div>
    </div>


    <!-- ====================================================================
         PANEL 2: SUBMENU NAVIGATION (LEVEL 2 - Exact Figma Screen 5)
         ==================================================================== -->
    <div class="sidebar-panel sidebar-panel--submenu">
      <!-- Submenu Header (Back Arrow + Title + Close Button) -->
      <div class="submenu-header">
        <button type="button" class="submenu-back-btn" data-submenu-back aria-label="{{ 'general.back' | t }}" id="btn-submenu-back">
          {% render 'icon-chevron', direction: 'left' %}
          <span data-submenu-title-display>Jewelry</span>
        </button>
        <button type="button" class="sidebar-close-btn" data-sidebar-close aria-label="{{ 'general.close' | t }}">
          {% render 'icon-close' %}
        </button>
      </div>

      {% if nav_menu != blank and nav_menu.links.size > 0 %}
        {% for link in nav_menu.links %}
          {% if link.links.size > 0 %}
            <div class="submenu-content" data-submenu-content="submenu-{{ link.handle }}" style="display: none;">
              <div class="submenu-grid">
                <div class="submenu-links">
                  {% for child_link in link.links %}
                    <a href="{{ child_link.url }}" class="submenu-link {% if child_link.url contains 'all' %}submenu-link--all{% endif %}">{{ child_link.title }}</a>
                  {% endfor %}
                </div>
                {% assign sub_image = 'sidebar-necklaces.jpg' %}
                {% if link.handle contains 'collection' %}
                  {% assign sub_image = 'SelfRomance-collection.jpg' %}
                {% endif %}
                <a href="{{ link.url | default: link.links.first.url }}" class="submenu-featured-card">
                  <img src="{{ sub_image | asset_url }}" alt="{{ link.title | escape }}" loading="lazy" width="400" height="533">
                  <div class="submenu-featured-card__overlay">
                    <span class="submenu-featured-card__title">{{ link.title }}</span>
                  </div>
                </a>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <!-- Submenu Content 1 (Jewelry Subcategories & Featured Card) -->
        <div class="submenu-content" data-submenu-content="submenu-jewelry">
          <div class="submenu-grid">
            <div class="submenu-links">
              <a href="/collections/earrings" class="submenu-link">Earrings</a>
              <a href="/collections/rings" class="submenu-link">Rings</a>
              <a href="/collections/necklaces" class="submenu-link">Necklaces</a>
              <a href="/collections/bracelets" class="submenu-link">Bracelets</a>
              <a href="/collections/all" class="submenu-link submenu-link--all">Shop all Jewelry</a>
            </div>
            <a href="/collections/necklaces" class="submenu-featured-card">
              <img src="{{ 'sidebar-necklaces.jpg' | asset_url }}" alt="Necklaces Fine Jewelry" loading="lazy" width="400" height="533">
              <div class="submenu-featured-card__overlay">
                <span class="submenu-featured-card__title">Necklaces</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Submenu Content 2 (Collections Subcategories & Featured Card) -->
        <div class="submenu-content" data-submenu-content="submenu-collections" style="display: none;">
          <div class="submenu-grid">
            <div class="submenu-links">
              <a href="/collections/rebirth" class="submenu-link">Rebirth Collection</a>
              <a href="/collections/boundaries" class="submenu-link">Boundaries Collection</a>
              <a href="/collections/victorious" class="submenu-link">Victorious Collection</a>
              <a href="/collections/self-romance" class="submenu-link">Self Romance Collection</a>
              <a href="/collections/alignment" class="submenu-link">The Alignment Collection</a>
              <a href="/collections" class="submenu-link submenu-link--all">Shop all Collections</a>
            </div>
            <a href="/collections/self-romance" class="submenu-featured-card">
              <img src="{{ 'SelfRomance-collection.jpg' | asset_url }}" alt="Self Romance Collection" loading="lazy" width="400" height="533">
              <div class="submenu-featured-card__overlay">
                <span class="submenu-featured-card__title">Self Romance Collection</span>
              </div>
            </a>
          </div>
        </div>
      {% endif %}
    </div>

  </div>
</div>
