{% comment %}
Renders the multi-level sliding sidebar drawer navigation matching the approved OGÉ design.
{% endcomment %}

<!-- Drawer Backdrop Overlay -->
<div class="drawer-backdrop" data-drawer-backdrop></div>

<!-- Sidebar Drawer -->
<div class="sidebar-drawer" data-sidebar-drawer role="dialog" aria-modal="true" aria-label="Navigation Menu">
  <div class="sidebar-panels" data-sidebar-panels>

    <!-- ====================================================================
         PANEL 1: MAIN NAVIGATION (LEVEL 1 - Exact Approved OGÉ Navigation)
         ==================================================================== -->
    <div class="sidebar-panel sidebar-panel--main">
      <!-- Sidebar Header Bar: Close on Left, Centered Logo, Search & Profile on Far Right (Mobile) / Close on Right (Desktop) -->
      <div class="sidebar-header-bar">
        <button class="sidebar-close-btn" data-sidebar-close aria-label="{{ 'general.close' | default: 'Close' }}" id="btn-sidebar-close">
          {% render 'icon-close' %}
        </button>
        <a href="{{ routes.root_url }}" class="sidebar-logo-center" aria-label="OGÉ Home">
          <img src="{{ 'logo2.png' | asset_url }}" alt="{{ shop.name | default: '06é' }}" class="site-logo__image">
        </a>
        <div class="sidebar-header-actions">
          <a href="{{ routes.search_url }}" class="header-icon-btn" data-search-open aria-label="{{ 'general.search' | default: 'Search' }}">
            {% render 'icon-search' %}
          </a>
          {% if customer %}
            <a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="{{ 'general.account' | default: 'Account' }}">
              {% render 'icon-account' %}
            </a>
          {% else %}
            <a href="{{ routes.account_login_url }}" class="header-icon-btn" aria-label="{{ 'general.account' | default: 'Account' }}">
              {% render 'icon-account' %}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Main Navigation Menu Items: EXACT Approved OGÉ Hierarchy -->
      <nav class="sidebar-nav" aria-label="Main Navigation">
        <ul class="sidebar-nav__list">
          <!-- 1. NEW IN -->
          <li class="sidebar-nav__item">
            {% assign new_in_url = collections['new-arrival'].url %}
            {% if new_in_url == blank or new_in_url == '' %}{% assign new_in_url = collections['new-in'].url %}{% endif %}
            {% if new_in_url == blank or new_in_url == '' %}{% assign new_in_url = '/collections/all?view=category&type=new' %}{% endif %}
            <a href="{{ new_in_url }}" class="sidebar-nav__link">
              <span>New In</span>
              <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
            </a>
          </li>

          <!-- 2. JEWELRY -->
          <li class="sidebar-nav__item">
            <button type="button" class="sidebar-nav__btn" data-submenu-trigger="submenu-jewelry" data-submenu-title="Jewelry" id="btn-menu-jewelry">
              <span>Jewelry</span>
              <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
            </button>
          </li>

          <!-- 3. MEN -->
          <li class="sidebar-nav__item">
            {% assign men_url = collections['men-s-signature-collection'].url %}
            {% if men_url == blank or men_url == '' %}{% assign men_url = collections['men'].url %}{% endif %}
            {% if men_url == blank or men_url == '' %}{% assign men_url = '/collections/all?view=category&type=men' %}{% endif %}
            <a href="{{ men_url }}" class="sidebar-nav__link">
              <span>Men</span>
              <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
            </a>
          </li>

          <!-- 4. FINE JEWELRY -->
          <li class="sidebar-nav__item">
            {% assign fine_url = collections['fine-jewelry'].url %}
            {% if fine_url == blank or fine_url == '' %}{% assign fine_url = '/collections/all?view=category&type=fine-jewelry' %}{% endif %}
            <a href="{{ fine_url }}" class="sidebar-nav__link">
              <span>Fine Jewelry</span>
              <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
            </a>
          </li>

          <!-- 5. COLLECTIONS -->
          <li class="sidebar-nav__item">
            <button type="button" class="sidebar-nav__btn" data-submenu-trigger="submenu-collections" data-submenu-title="Collections" id="btn-menu-collections">
              <span>Collections</span>
              <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
            </button>
          </li>

          <!-- 6. OUR STORY -->
          <li class="sidebar-nav__item">
            {% assign story_url = pages['about-oge-jewelry'].url %}
            {% if story_url == blank or story_url == '' %}{% assign story_url = pages['our-story'].url %}{% endif %}
            {% if story_url == blank or story_url == '' %}{% assign story_url = pages['about'].url %}{% endif %}
            {% if story_url == blank or story_url == '' %}{% assign story_url = '/collections/all?view=about' %}{% endif %}
            <a href="{{ story_url }}" class="sidebar-nav__link">
              <span>Our Story</span>
              <span class="sidebar-nav__chevron">{% render 'icon-chevron', direction: 'right' %}</span>
            </a>
          </li>
        </ul>
      </nav>

      <hr class="sidebar-divider">

      <!-- Sidebar Footer (Secondary Links & Currency/Language) -->
      <div class="sidebar-footer">
        {% if shop.customer_accounts_enabled and customer %}
          <a href="{{ routes.account_url }}" class="sidebar-footer__link">{{ 'general.account' | default: 'Account' }}</a>
        {% else %}
          <a href="{{ routes.account_login_url | default: '/account/login' }}" class="sidebar-footer__link">{{ 'general.login' | default: 'Login' }}</a>
        {% endif %}

        {% assign sidebar_wishlist_url = pages['wishlist'].url %}
        {% if sidebar_wishlist_url == blank or sidebar_wishlist_url == '' %}{% assign sidebar_wishlist_url = '/collections/all?view=wishlist' %}{% endif %}
        <a href="{{ sidebar_wishlist_url }}" class="sidebar-footer__link">{{ 'general.wishlist' | default: 'WishList' }}</a>

        <!-- Localization Selector (US Flag + Country / Language) -->
        <div class="sidebar-localization" data-country-trigger role="button" tabindex="0" aria-label="Select Country and Language" style="cursor: pointer;">
          <span class="sidebar-localization__flag-wrap" data-country-display-flag>
            <svg class="sidebar-localization__flag" viewBox="0 0 16 11" width="16" height="11" fill="none" style="border-radius: 1.5px; overflow: hidden; display: block; box-shadow: 0 0 1px rgba(0,0,0,0.25);">
              <rect width="16" height="11" fill="#B22234"/>
              <path d="M0 1.692h16M0 3.385h16M0 5.077h16M0 6.769h16M0 8.462h16M0 10.154h16" stroke="#FFFFFF" stroke-width="0.846"/>
              <rect width="6.5" height="5.923" fill="#3C3B6E"/>
            </svg>
          </span>
          <span class="sidebar-localization__text" data-sidebar-location-text>United States &nbsp;|&nbsp; English</span>
          {% render 'icon-chevron', direction: 'down' %}
        </div>
      </div>
    </div>


    <!-- ====================================================================
         PANEL 2: SUBMENU NAVIGATION (LEVEL 2 - Approved OGÉ Submenus)
         ==================================================================== -->
    <div class="sidebar-panel sidebar-panel--submenu">
      <!-- Submenu Header (Back Arrow + Title + Close Button) -->
      <div class="submenu-header">
        <button type="button" class="submenu-back-btn" data-submenu-back aria-label="{{ 'general.back' | default: 'Back' }}" id="btn-submenu-back">
          {% render 'icon-chevron', direction: 'left' %}
          <span data-submenu-title-display>Jewelry</span>
        </button>
        <button type="button" class="sidebar-close-btn" data-sidebar-close aria-label="{{ 'general.close' | default: 'Close' }}">
          {% render 'icon-close' %}
        </button>
      </div>

      <!-- Submenu Content 1: JEWELRY (Shop All, Rings, Earrings, Necklaces, Bracelets) -->
      <div class="submenu-content" data-submenu-content="submenu-jewelry">
        <div class="submenu-grid">
          <div class="submenu-links">
            <a href="/collections/all?view=shop" class="submenu-link submenu-link--all">Shop All Jewelries</a>
            <a href="/collections/all?view=category&type=rings" class="submenu-link">Rings</a>
            <a href="/collections/all?view=category&type=earrings" class="submenu-link">Earrings</a>
            <a href="/collections/all?view=category&type=necklaces" class="submenu-link">Necklaces</a>
            <a href="/collections/all?view=category&type=bracelets" class="submenu-link">Bracelets</a>
          </div>
          <a href="/collections/all?view=category&type=necklaces" class="submenu-featured-card">
            <img src="{{ 'sidebar-necklaces.jpg' | asset_url }}" alt="Necklaces Fine Jewelry" loading="lazy" width="400" height="533">
            <div class="submenu-featured-card__overlay">
              <span class="submenu-featured-card__title">Necklaces</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Submenu Content 2: COLLECTIONS (All Collections, Rebirth, Boundaries, Victorious, Self Romance) -->
      <div class="submenu-content" data-submenu-content="submenu-collections" style="display: none;">
        <div class="submenu-grid">
          <div class="submenu-links">
            <a href="/collections/all?view=shop" class="submenu-link submenu-link--all">All Collections</a>
            {% assign rebirth_url = collections['the-rebirth-collection'].url %}
            {% if rebirth_url == blank or rebirth_url == '' %}{% assign rebirth_url = collections['rebirth'].url %}{% endif %}
            {% if rebirth_url == blank or rebirth_url == '' %}{% assign rebirth_url = '/collections/all?collection=rebirth' %}{% endif %}
            <a href="{{ rebirth_url }}" class="submenu-link">Rebirth</a>

            {% assign boundaries_url = collections['boundaries-collection'].url %}
            {% if boundaries_url == blank or boundaries_url == '' %}{% assign boundaries_url = collections['boundaries'].url %}{% endif %}
            {% if boundaries_url == blank or boundaries_url == '' %}{% assign boundaries_url = '/collections/all?collection=boundaries' %}{% endif %}
            <a href="{{ boundaries_url }}" class="submenu-link">Boundaries</a>

            {% assign victorious_url = collections['victorious-collection'].url %}
            {% if victorious_url == blank or victorious_url == '' %}{% assign victorious_url = collections['victorious'].url %}{% endif %}
            {% if victorious_url == blank or victorious_url == '' %}{% assign victorious_url = '/collections/all?collection=victorious' %}{% endif %}
            <a href="{{ victorious_url }}" class="submenu-link">Victorious</a>

            {% assign self_romance_url = collections['the-self-romance-collection'].url %}
            {% if self_romance_url == blank or self_romance_url == '' %}{% assign self_romance_url = collections['self-romance'].url %}{% endif %}
            {% if self_romance_url == blank or self_romance_url == '' %}{% assign self_romance_url = collections['self-woman'].url %}{% endif %}
            {% if self_romance_url == blank or self_romance_url == '' %}{% assign self_romance_url = '/collections/all?collection=self-romance' %}{% endif %}
            <a href="{{ self_romance_url }}" class="submenu-link">Self Romance</a>
          </div>
          <a href="{{ self_romance_url }}" class="submenu-featured-card">
            <img src="{{ 'SelfRomance-collection.jpg' | asset_url }}" alt="Self Romance Collection" loading="lazy" width="400" height="533">
            <div class="submenu-featured-card__overlay">
              <span class="submenu-featured-card__title">Self Romance</span>
            </div>
          </a>
        </div>
      </div>
    </div>

  </div>
</div>
