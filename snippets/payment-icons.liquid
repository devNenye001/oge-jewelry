{% doc %}
Renders row of payment provider badges matching Figma footer.
{% enddoc %}
<div class="footer-payments">
  <!-- Visa Debit -->
  <span class="payment-badge" title="Visa Debit">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <path d="M14 8L19 16L24 8" stroke="#333333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>

  <!-- Visa -->
  <span class="payment-badge" title="Visa">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <path d="M15.4 16.5L17.2 5.5H19.5L17.7 16.5H15.4ZM27.1 5.7C26.6 5.5 25.8 5.3 24.8 5.3C22.2 5.3 20.3 6.6 20.3 8.6C20.3 10.1 21.6 10.9 22.6 11.4C23.6 11.9 24 12.2 24 12.7C24 13.4 23.1 13.8 22.3 13.8C21.4 13.8 20.8 13.6 20.1 13.3L19.7 13.1L19.4 15.2C20 15.5 21 15.7 22.1 15.7C24.9 15.7 26.7 14.3 26.7 12.3C26.7 11 25.9 10 24.1 9.2C23.2 8.7 22.7 8.4 22.7 7.9C22.7 7.4 23.3 6.9 24.4 6.9C25.2 6.9 25.9 7.1 26.4 7.3L26.7 7.4L27.1 5.7ZM34.7 5.5H32.9C32.3 5.5 31.9 5.7 31.6 6.3L27.2 16.5H29.7L30.2 15.1H33.3L33.6 16.5H35.8L34.7 5.5ZM30.9 13.2L32.2 9.6L33 13.2H30.9ZM12.7 5.5L10.5 13L10.3 11.9C9.8 10.4 9 7.7 7.8 6.3C7.2 5.6 6.4 5.5 5.5 5.5H2.1L2 5.8C3.7 6.2 5.6 7.4 6.7 8.8L8.7 16.5H11.2L15.1 5.5H12.7Z" fill="#1A1F71"/>
    </svg>
  </span>

  <!-- Apple Pay -->
  <span class="payment-badge" title="Apple Pay">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <path d="M12.8 11.8C12.8 10.2 13.9 9.3 14 9.2C13.2 8.1 12 8 11.6 7.9C10.6 7.8 9.6 8.5 9 8.5C8.5 8.5 7.6 7.9 6.8 7.9C5.8 7.9 4.8 8.5 4.3 9.4C3.2 11.3 4 14.1 5.1 15.6C5.6 16.4 6.2 17.2 7.1 17.2C7.9 17.2 8.2 16.6 9.3 16.6C10.3 16.6 10.6 17.2 11.4 17.2C12.3 17.2 12.9 16.4 13.4 15.6C14 14.7 14.3 13.9 14.4 13.8C14.3 13.7 12.8 13.1 12.8 11.8Z" fill="#000000"/>
      <path d="M11.3 6.9C11.8 6.3 12.1 5.4 12 4.5C11.2 4.5 10.3 5 9.8 5.6C9.3 6.2 8.9 7.1 9 8C9.9 8.1 10.8 7.5 11.3 6.9Z" fill="#000000"/>
      <text x="16" y="15" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="9" font-weight="600" fill="#000000">Pay</text>
    </svg>
  </span>

  <!-- Diners -->
  <span class="payment-badge" title="Diners">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <circle cx="15" cy="12" r="5" stroke="#333333" stroke-width="1.5"/>
      <circle cx="23" cy="12" r="5" stroke="#333333" stroke-width="1.5"/>
    </svg>
  </span>

  <!-- Discover -->
  <span class="payment-badge" title="Discover">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <text x="5" y="15" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="8" font-weight="700" fill="#FF6000">DISCOVER</text>
    </svg>
  </span>

  <!-- Google Pay -->
  <span class="payment-badge" title="Google Pay">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <text x="8" y="15" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="9" font-weight="700" fill="#444444">G Pay</text>
    </svg>
  </span>

  <!-- Mastercard -->
  <span class="payment-badge" title="Mastercard">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <circle cx="15" cy="12" r="6" fill="#EB001B"/>
      <circle cx="23" cy="12" r="6" fill="#F79E1B" fill-opacity="0.9"/>
    </svg>
  </span>

  <!-- PayPal -->
  <span class="payment-badge" title="PayPal">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <path d="M12.5 6.5H16C17.5 6.5 18.5 7.2 18.2 8.7C17.9 10.3 16.8 11.2 15.2 11.2H13.6L12.7 16.5H10.5L12.5 6.5Z" fill="#003087"/>
      <path d="M15.5 8.5H19C20.5 8.5 21.5 9.2 21.2 10.7C20.9 12.3 19.8 13.2 18.2 13.2H16.6L15.7 18.5H13.5L15.5 8.5Z" fill="#0079C1" fill-opacity="0.8"/>
    </svg>
  </span>

  <!-- Shop Pay -->
  <span class="payment-badge" title="Shop Pay">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#5A31F4"/>
      <text x="5" y="15" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="8" font-weight="700" fill="#FFFFFF">shop Pay</text>
    </svg>
  </span>

  <!-- iDeal -->
  <span class="payment-badge" title="iDeal">
    <svg viewBox="0 0 38 24" width="38" height="24" fill="none">
      <rect width="38" height="24" rx="2" fill="#F4F4F4"/>
      <text x="8" y="15" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="8" font-weight="700" fill="#CC0066">ideal</text>
    </svg>
  </span>
</div>
