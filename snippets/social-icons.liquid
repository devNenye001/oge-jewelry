{% doc %}
Renders social media icon buttons matching Figma circular style.
{% enddoc %}
<div class="footer-socials">
  <a href="{{ settings.social_facebook | default: 'https://facebook.com' }}" class="social-circle-btn" target="_blank" rel="noopener" aria-label="Facebook">
    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
  </a>
  <a href="{{ settings.social_tiktok | default: 'https://tiktok.com' }}" class="social-circle-btn" target="_blank" rel="noopener" aria-label="TikTok">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743 2.895 2.895 0 0 1 2.312-4.643c.294 0 .579.04.85.116V9.352a6.347 6.347 0 0 0-.85-.058 6.34 6.34 0 0 0-6.335 6.34 6.34 6.34 0 0 0 10.82 4.49 6.273 6.273 0 0 0 1.96-4.49V8.71a8.28 8.28 0 0 0 4.81 1.48v-3.504Z"/></svg>
  </a>
  <a href="{{ settings.social_instagram | default: 'https://instagram.com' }}" class="social-circle-btn" target="_blank" rel="noopener" aria-label="Instagram">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
  </a>
  <a href="{{ settings.social_youtube | default: 'https://youtube.com' }}" class="social-circle-btn" target="_blank" rel="noopener" aria-label="YouTube">
    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#FFFFFF"></polygon></svg>
  </a>
</div>
