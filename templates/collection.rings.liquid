{% comment %}
  OGÉ Fine Jewelry - Rings Collection View Template
{% endcomment %}

<header class="category-page-header">
  <h1 class="category-page-title" id="category-page-heading">RINGS</h1>
</header>
<hr class="category-divider-line">

<main class="collection-catalog-wrap" id="MainContent">
  <div class="collection-products-grid grid--4-col" id="category-grid">
    {% assign count = 0 %}
    {% for product in collections.all.products %}
      {% assign p_title = product.title | downcase %}
      {% assign p_type = product.type | downcase %}
      {% if p_title contains 'ring' or p_type contains 'ring' or product.tags contains 'ring' or product.tags contains 'rings' or collection.handle == 'rings' %}
        {% render 'product-card', product: product %}
        {% assign count = count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if count == 0 %}
      {% for product in collections.all.products limit: 12 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>
</main>
<hr class="category-divider-line">
