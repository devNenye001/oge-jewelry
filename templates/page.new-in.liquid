{% comment %}
  OGÉ Fine Jewelry - New In Template
{% endcomment %}

<header class="category-page-header">
  <h1 class="category-page-title" id="category-page-heading">NEW IN</h1>
</header>
<hr class="category-divider-line">

<main class="collection-catalog-wrap" id="MainContent">
  <div class="collection-products-grid grid--4-col" id="category-grid">
    {% assign all_prods = collections['new-arrival'].products | default: collections['new-in'].products | default: collections.all.products %}
    {% if all_prods.size > 0 %}
      {% for product in all_prods %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>
</main>
<hr class="category-divider-line">
