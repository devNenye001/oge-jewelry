{% comment %}
  OGÉ Fine Jewelry - Necklaces Collection View Template
{% endcomment %}

<header class="category-page-header">
  <h1 class="category-page-title" id="category-page-heading">NECKLACES</h1>
</header>
<hr class="category-divider-line">

<main class="collection-catalog-wrap" id="MainContent">
  <div class="collection-products-grid grid--4-col" id="category-grid">
    {% assign count = 0 %}
    {% for product in collections.all.products %}
      {% assign p_title = product.title | downcase %}
      {% assign p_type = product.type | downcase %}
      {% if p_title contains 'necklace' or p_title contains 'chain' or p_title contains 'pendant' or p_title contains 'choker' or p_type contains 'necklace' or product.tags contains 'necklace' or product.tags contains 'necklaces' or collection.handle == 'necklaces' %}
        {% render 'product-card', product: product %}
        {% assign count = count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if count == 0 %}
      {% for product in collections.all.products limit: 12 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>
</main>
<hr class="category-divider-line">
