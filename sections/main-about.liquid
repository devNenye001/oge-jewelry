{% comment %}
  OGÉ Fine Jewelry - Main About / Our Story Section (Mockup Match)
  Features:
  - Hero banner with overlay text: "MORE THAN JEWELRY, IT'S A FEELING."
  - Quote & Attribution statement
  - Our Story section (Victorious-collection.jpg)
  - Split Mission & Vision blocks (our-mission.jpg & our-vision.jpg)
  - Jewelry With Intention section (sales2.jpg)
{% endcomment %}

{% render 'page-content-about', section: section %}

{% schema %}
{
  "name": "About / Our Story Page",
  "tag": "section",
  "class": "section-about-page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Banner"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Banner Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Headline",
      "default": "MORE THAN JEWELRY, IT'S A FEELING."
    },
    {
      "type": "header",
      "content": "Philosophy Statement"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Founder Statement Quote"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "-Oge Ikekwem"
    },
    {
      "type": "header",
      "content": "Our Story"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story Title",
      "default": "OUR STORY"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Content"
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story Image"
    },
    {
      "type": "header",
      "content": "Our Mission"
    },
    {
      "type": "text",
      "id": "mission_title",
      "label": "Mission Title",
      "default": "OUR MISSION"
    },
    {
      "type": "richtext",
      "id": "mission_text",
      "label": "Mission Content"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission Image"
    },
    {
      "type": "header",
      "content": "Our Vision"
    },
    {
      "type": "text",
      "id": "vision_title",
      "label": "Vision Title",
      "default": "OUR VISION"
    },
    {
      "type": "richtext",
      "id": "vision_text",
      "label": "Vision Content"
    },
    {
      "type": "image_picker",
      "id": "vision_image",
      "label": "Vision Image"
    },
    {
      "type": "header",
      "content": "Jewelry with Intention"
    },
    {
      "type": "text",
      "id": "intention_title",
      "label": "Intention Title",
      "default": "JEWELRY WITH INTENTION"
    },
    {
      "type": "richtext",
      "id": "intention_desc",
      "label": "Intention Description"
    },
    {
      "type": "image_picker",
      "id": "intention_image",
      "label": "Intention Image"
    }
  ]
}
{% endschema %}
