{% render 'page-content-faq', section: section %}

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What does OGÉ Jewelry represent?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "OGÉ Jewelry is rooted in self–expression, self-worth, resilience, and transformation."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion"
    }
  ]
}
{% endschema %}
