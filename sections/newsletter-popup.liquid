{% if section.settings.enable_popup %}
  <div 
    class="sales-popup-modal" 
    data-sales-popup 
    data-popup-enabled="{{ section.settings.enable_popup }}"
    data-popup-delay="{{ section.settings.delay_seconds | times: 1000 }}"
    role="dialog" 
    aria-modal="true" 
    aria-label="{{ section.settings.heading | default: 'Signup Offer' }}"
    {{ section.shopify_attributes }}
  >
    <div class="sales-popup-card">
      <!-- Close Button (Clean White X matching Figma) -->
      <button type="button" class="sales-popup-close-btn" data-popup-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon-close' %}
      </button>

      <!-- Background Moody Image (sales-popup-bg.jpg) -->
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'sales-popup-card__bg', loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        <img 
          src="{{ 'sales-popup-bg.jpg' | asset_url }}" 
          alt="{{ section.settings.heading | default: 'GET 15% OFF YOUR FIRST ORDER' }}" 
          class="sales-popup-card__bg" 
          loading="lazy"
          width="800" 
          height="1067"
        >
      {% endif %}

      <!-- Dark Overlay with Centered Offer Text -->
      <div class="sales-popup-card__overlay">
        {% if section.settings.eyebrow != blank %}
          <div class="sales-popup-card__eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="sales-popup-card__headline">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        <!-- Interactive Sign up CTA -->
        <button type="button" class="sales-popup-card__cta" data-popup-cta>
          {{ section.settings.cta_text | default: 'Sign up' }}
        </button>

        <!-- Newsletter Input Form (Toggled upon click or direct) -->
        <div data-popup-form-wrapper style="display: none; margin-top: 16px;">
          {% form 'customer', class: 'sales-popup-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter, 15off_signup">
            <div class="sales-popup-form__row">
              <input 
                type="email" 
                name="contact[email]" 
                placeholder="{{ 'popup.email_placeholder' | t }}" 
                required 
                autocomplete="email"
              >
              <button type="submit" class="btn btn-gold" style="padding: 10px 18px; font-size: 0.8125rem;">
                {{ section.settings.cta_text | default: 'Sign up' }}
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Sales Pop-Up",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable Pop-Up Modal",
      "default": true
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Display Delay (seconds)",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Signup Offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET 15% OFF YOUR FIRST ORDER"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Call to Action Text",
      "default": "Sign up"
    }
  ],
  "presets": [
    {
      "name": "Sales Pop-Up"
    }
  ]
}
{% endschema %}
