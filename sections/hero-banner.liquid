<section class="hero-banner" id="hero" data-hero-slideshow data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 }}" {{ section.shopify_attributes }}>
  <div class="hero-slideshow__container">
    {%- comment -%} Slide 1 {%- endcomment -%}
    {% assign s1_heading = section.settings.slide_1_heading | default: section.settings.heading | default: section.settings.title %}
    {% assign s1_subheading = section.settings.slide_1_subheading | default: section.settings.subheading | default: section.settings.text %}
    {% assign s1_eyebrow = section.settings.slide_1_eyebrow | default: section.settings.eyebrow %}
    {% assign s1_btn_text = section.settings.slide_1_btn_text | default: section.settings.btn_1_text %}
    {% assign s1_btn_url = section.settings.btn_1_url | default: collections['new-arrival'].url %}
    <div class="hero-slideshow__slide is-active" data-slide-index="0">
      <a href="{{ s1_btn_url }}" class="hero-slideshow__link" aria-label="OGÉ Fine Jewelry Campaign Slide 1">
        <div class="hero-banner__image-wrap">
          {% if section.settings.image_1 != blank %}
            {{ section.settings.image_1 | image_url: width: 2000 | image_tag: class: 'hero-banner__image', loading: 'eager', alt: 'OGÉ Fine Jewelry Campaign 1' }}
          {% elsif section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-banner__image', loading: 'eager', alt: 'OGÉ Fine Jewelry Campaign 1' }}
          {% else %}
            <img 
              src="{{ 'hero.jpg' | asset_url }}" 
              alt="OGÉ Fine Jewelry Campaign 1" 
              class="hero-banner__image" 
              loading="eager"
              width="2000"
              height="1200"
            >
          {% endif %}
        </div>
      </a>
      {% if s1_heading != blank or s1_subheading != blank or s1_eyebrow != blank or s1_btn_text != blank %}
        <div class="hero-banner__overlay hero-banner__overlay--bottom-left">
          <div class="hero-banner__content hero-banner__content--bottom-left">
            {% if s1_eyebrow != blank %}
              <p class="hero-banner__eyebrow">{{ s1_eyebrow }}</p>
            {% endif %}
            {% if s1_heading != blank %}
              <h1 class="hero-banner__title">{{ s1_heading }}</h1>
            {% endif %}
            {% if s1_subheading != blank %}
              <p class="hero-banner__subheading">{{ s1_subheading }}</p>
            {% endif %}
            {% if s1_btn_text != blank %}
              <div class="hero-banner__actions">
                <a href="{{ s1_btn_url }}" class="btn btn-primary hero-banner__btn">
                  {{ s1_btn_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Slide 2 {%- endcomment -%}
    {% assign slide_2_url = section.settings.btn_2_url %}
    {% if slide_2_url == blank or slide_2_url == '' %}
      {% if pages['men'] != blank %}
        {% assign slide_2_url = pages['men'].url %}
      {% elsif collections['men'] != blank %}
        {% assign slide_2_url = collections['men'].url %}
      {% elsif collections['mens-signature-collection'] != blank %}
        {% assign slide_2_url = collections['mens-signature-collection'].url %}
      {% else %}
        {% assign slide_2_url = '/pages/men' %}
      {% endif %}
    {% endif %}
    {% assign s2_heading = section.settings.slide_2_heading %}
    {% assign s2_subheading = section.settings.slide_2_subheading %}
    {% assign s2_eyebrow = section.settings.slide_2_eyebrow %}
    {% assign s2_btn_text = section.settings.slide_2_btn_text %}
    <div class="hero-slideshow__slide" data-slide-index="1">
      <a href="{{ slide_2_url }}" class="hero-slideshow__link" aria-label="OGÉ Fine Jewelry Campaign Slide 2 - Men's Collection">
        <div class="hero-banner__image-wrap">
          {% if section.settings.image_2 != blank %}
            {{ section.settings.image_2 | image_url: width: 2000 | image_tag: class: 'hero-banner__image', loading: 'lazy', alt: "OGÉ Men's Fine Jewelry Campaign" }}
          {% else %}
            <img 
              src="{{ 'hero-banner.jpg' | asset_url }}" 
              alt="OGÉ Men's Fine Jewelry Campaign" 
              class="hero-banner__image" 
              loading="lazy"
              width="2000"
              height="1200"
            >
          {% endif %}
        </div>
      </a>
      {% if s2_heading != blank or s2_subheading != blank or s2_eyebrow != blank or s2_btn_text != blank %}
        <div class="hero-banner__overlay hero-banner__overlay--bottom-left">
          <div class="hero-banner__content hero-banner__content--bottom-left">
            {% if s2_eyebrow != blank %}
              <p class="hero-banner__eyebrow">{{ s2_eyebrow }}</p>
            {% endif %}
            {% if s2_heading != blank %}
              <h2 class="hero-banner__title">{{ s2_heading }}</h2>
            {% endif %}
            {% if s2_subheading != blank %}
              <p class="hero-banner__subheading">{{ s2_subheading }}</p>
            {% endif %}
            {% if s2_btn_text != blank %}
              <div class="hero-banner__actions">
                <a href="{{ slide_2_url }}" class="btn btn-primary hero-banner__btn">
                  {{ s2_btn_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Slide 3 {%- endcomment -%}
    {% assign s3_btn_url = section.settings.btn_3_url | default: section.settings.btn_1_url | default: collections['new-arrival'].url %}
    {% assign s3_heading = section.settings.slide_3_heading %}
    {% assign s3_subheading = section.settings.slide_3_subheading %}
    {% assign s3_eyebrow = section.settings.slide_3_eyebrow %}
    {% assign s3_btn_text = section.settings.slide_3_btn_text %}
    <div class="hero-slideshow__slide" data-slide-index="2">
      <a href="{{ s3_btn_url }}" class="hero-slideshow__link" aria-label="OGÉ Fine Jewelry Campaign Slide 3">
        <div class="hero-banner__image-wrap">
          {% if section.settings.image_3 != blank %}
            {{ section.settings.image_3 | image_url: width: 2000 | image_tag: class: 'hero-banner__image', loading: 'lazy', alt: 'OGÉ Fine Jewelry Campaign 3' }}
          {% else %}
            <img 
              src="{{ 'about-hero-brand.jpg' | asset_url }}" 
              alt="OGÉ Fine Jewelry Campaign 3" 
              class="hero-banner__image" 
              loading="lazy"
              width="2000"
              height="1200"
            >
          {% endif %}
        </div>
      </a>
      {% if s3_heading != blank or s3_subheading != blank or s3_eyebrow != blank or s3_btn_text != blank %}
        <div class="hero-banner__overlay hero-banner__overlay--bottom-left">
          <div class="hero-banner__content hero-banner__content--bottom-left">
            {% if s3_eyebrow != blank %}
              <p class="hero-banner__eyebrow">{{ s3_eyebrow }}</p>
            {% endif %}
            {% if s3_heading != blank %}
              <h2 class="hero-banner__title">{{ s3_heading }}</h2>
            {% endif %}
            {% if s3_subheading != blank %}
              <p class="hero-banner__subheading">{{ s3_subheading }}</p>
            {% endif %}
            {% if s3_btn_text != blank %}
              <div class="hero-banner__actions">
                <a href="{{ s3_btn_url }}" class="btn btn-primary hero-banner__btn">
                  {{ s3_btn_text }}
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {%- comment -%} 3 Navigation Dots (20px above the bottom of the hero section) {%- endcomment -%}
    <div class="hero-slideshow__dots" aria-label="Hero Slideshow Navigation">
      <button type="button" class="hero-slideshow__dot is-active" data-dot-index="0" aria-label="Slide 1" aria-current="true"></button>
      <button type="button" class="hero-slideshow__dot" data-dot-index="1" aria-label="Slide 2" aria-current="false"></button>
      <button type="button" class="hero-slideshow__dot" data-dot-index="2" aria-label="Slide 3" aria-current="false"></button>
    </div>
  </div>
</section>

<script>
  (function() {
    function initHeroSlideshow() {
      var hero = document.getElementById('hero');
      if (!hero) return;

      var slides = hero.querySelectorAll('.hero-slideshow__slide');
      var dots = hero.querySelectorAll('.hero-slideshow__dot');
      if (slides.length <= 1) return;

      var currentIndex = 0;
      var speedSec = parseInt(hero.getAttribute('data-autoplay-speed'), 10) || 5;
      var intervalTime = speedSec * 1000;
      var timer = null;
      var totalSlides = slides.length;

      function goToSlide(index) {
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;
        currentIndex = index;

        slides.forEach(function(slide, i) {
          if (i === currentIndex) {
            slide.classList.add('is-active');
          } else {
            slide.classList.remove('is-active');
          }
        });

        dots.forEach(function(dot, i) {
          if (i === currentIndex) {
            dot.classList.add('is-active');
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.classList.remove('is-active');
            dot.setAttribute('aria-current', 'false');
          }
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function startAutoplay() {
        stopAutoplay();
        timer = setInterval(nextSlide, intervalTime);
      }

      function stopAutoplay() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      // Dot click navigation
      dots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
          goToSlide(idx);
          startAutoplay();
        });
      });

      // Pause on hover, resume on leave
      hero.addEventListener('mouseenter', stopAutoplay);
      hero.addEventListener('mouseleave', startAutoplay);

      // Touch swipe support for mobile
      var touchStartX = 0;
      var touchEndX = 0;

      hero.addEventListener('touchstart', function(e) {
        if (e.changedTouches && e.changedTouches[0]) {
          touchStartX = e.changedTouches[0].screenX;
        }
      }, { passive: true });

      hero.addEventListener('touchend', function(e) {
        if (e.changedTouches && e.changedTouches[0]) {
          touchEndX = e.changedTouches[0].screenX;
          var diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              goToSlide(currentIndex + 1);
            } else {
              goToSlide(currentIndex - 1);
            }
            startAutoplay();
          }
        }
      }, { passive: true });

      // Start automatic switching
      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlideshow);
    } else {
      initHeroSlideshow();
    }
  })();
</script>

