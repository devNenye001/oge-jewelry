{% comment %}
  OGÉ Fine Jewelry - Main Collection Section
  Features:
  - If viewing "Shop All" / "All Jewelries" / "All Collections":
      Uses the clean Category design (Centered title "SHOP ALL JEWELRIES", fine divider, utility bar with Filter & Sort and density switchers, NO hero banner, NO tabs).
  - If viewing a specific Signature Collection (Rebirth, Victorious, Boundaries, Self Romance):
      Renders the Hero Banner, centered sub-filter tabs (All, Necklaces, Bracelets, Rings), utility bar, and product grid.
{% endcomment %}

{% assign coll_handle = collection.handle | default: '' %}
{% assign is_shop_all = false %}
{% if coll_handle == 'all' or coll_handle == 'frontpage' or coll_handle == 'shop' or coll_handle == 'all-jewelries' or coll_handle == 'jewelries' or coll_handle == blank %}
  {% assign is_shop_all = true %}
{% endif %}

{% if is_shop_all %}
  <!-- Category Design Header for Shop All Jewelries / All Collections -->
  <header class="category-page-header">
    <h1 class="category-page-title" id="category-page-heading">SHOP ALL JEWELRIES</h1>
  </header>
  <hr class="category-divider-line">
{% else %}
  <!-- Collection Hero Banner for Signature Collections -->
  <section class="collection-hero" id="collection-hero-banner">
    {% if collection.image %}
      <img src="{{ collection.image | image_url: width: 1920 }}" alt="{{ collection.title | escape }}" class="collection-hero__image" loading="eager" width="1920" height="400">
    {% elsif collection.handle contains 'bound' %}
      <img src="{{ 'Boundaries-collection.jpg' | asset_url }}" alt="The Boundaries Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
    {% elsif collection.handle contains 'victor' %}
      <img src="{{ 'Victorious-collection.jpg' | asset_url }}" alt="The Victorious Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
    {% elsif collection.handle contains 'align' %}
      <img src="{{ 'alignment-collection.jpg' | asset_url }}" alt="The Alignment Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
    {% elsif collection.handle contains 'rebirth' %}
      <img src="{{ 'Rebirth-collection.jpg' | asset_url }}" alt="The Rebirth Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
    {% else %}
      <img src="{{ 'SelfRomance-collection.jpg' | asset_url }}" alt="{{ collection.title | default: 'The Self Woman Collection' }}" class="collection-hero__image" loading="eager" width="1920" height="400">
    {% endif %}
    <div class="collection-hero__overlay"></div>
    <div class="collection-hero__content">
      <h1 class="collection-hero__title">{{ collection.title | default: 'THE SELF WOMAN COLLECTION' }}</h1>
      {% if collection.description != blank %}
        <p class="collection-hero__desc">{{ collection.description }}</p>
      {% endif %}
    </div>
  </section>

  <!-- Sub-filter Tabs for Signature Collections (All, Necklaces, Bracelets, Rings - Matches Figma Mockup) -->
  <nav class="collection-category-tabs collection-nav-tabs" id="collection-tabs-nav" aria-label="Collection Filter Categories">
    <button type="button" class="collection-tab-btn is-active" data-collection-tab="all">All</button>
    <button type="button" class="collection-tab-btn" data-collection-tab="necklaces">Necklaces</button>
    <button type="button" class="collection-tab-btn" data-collection-tab="bracelets">Bracelets</button>
    <button type="button" class="collection-tab-btn" data-collection-tab="rings">Rings</button>
  </nav>
{% endif %}

<!-- UTILITY BAR (FILTER & SORT + DENSITY SWITCHER) -->
<div class="collection-utility-bar">
  <div class="collection-utility-left" style="position: relative;">
    <button type="button" class="filter-sort-btn" id="filter-sort-toggle" aria-expanded="false" aria-controls="collection-filter-dropdown">
      Filter &amp; Sort
    </button>
    <div class="filter-dropdown-menu" id="collection-filter-dropdown" role="menu">
      <button type="button" class="filter-option-btn is-active" data-sort="featured">Featured</button>
      <button type="button" class="filter-option-btn" data-sort="price-low">Price: Low to High</button>
      <button type="button" class="filter-option-btn" data-sort="price-high">Price: High to Low</button>
      <button type="button" class="filter-option-btn" data-sort="newest">New Arrivals</button>
    </div>
  </div>
  <div class="collection-utility-right">
    <div class="grid-density-switcher" role="group" aria-label="Grid density switcher">
      <button type="button" class="grid-density-btn" data-cols="1" aria-label="1 column view" title="1 Column">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="12" height="12"/></svg>
      </button>
      <button type="button" class="grid-density-btn" data-cols="2" aria-label="2 columns view" title="2 Columns">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="5" height="12"/><rect x="9" y="2" width="5" height="12"/></svg>
      </button>
      <button type="button" class="grid-density-btn is-active" data-cols="4" aria-label="4 columns view" title="4 Columns">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="5" height="5"/><rect x="9" y="2" width="5" height="5"/><rect x="2" y="9" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Product Catalog -->
<main class="collection-catalog-wrap" id="MainContent">
  {% assign products_per_page = section.settings.products_per_page | default: 24 %}
  {% paginate collection.products by products_per_page %}
    <div class="collection-products-grid grid--4-col" id="collection-products-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        <div class="wishlist-empty-box collection-empty-state" id="collection-empty-placeholder" style="grid-column: 1 / -1; padding: 60px 20px; text-align: center;">
          <h2 class="wishlist-empty-title">Loading Jewelry...</h2>
          <p class="wishlist-empty-desc">Discovering handcrafted fine jewelry pieces.</p>
        </div>
      {% endif %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="collection-pagination" aria-label="Pagination">
        {{ paginate | default_pagination: next: 'Next &rarr;', previous: '&larr; Prev' }}
      </nav>
    {% endif %}
  {% endpaginate %}
</main>

<hr class="category-divider-line">

<script>
  (function() {
    function initCollectionPage() {
      const grid = document.getElementById('collection-products-grid');
      if (!grid) return;

      const path = (window.location.pathname || '').toLowerCase();
      const params = new URLSearchParams(window.location.search);
      let queryColl = (params.get('collection') || '').toLowerCase().trim();
      const queryType = (params.get('type') || '').toLowerCase().trim();

      if (!queryColl) {
        if (path.includes('rebirth')) queryColl = 'rebirth';
        else if (path.includes('victor')) queryColl = 'victorious';
        else if (path.includes('bound') || path.includes('bondr')) queryColl = 'boundaries';
        else if (path.includes('romance') || path.includes('self-woman')) queryColl = 'self-woman';
        else if (path.includes('align')) queryColl = 'alignment';
        else if (path.includes('all') || path.includes('shop') || path === '/collections' || path === '/collections/') queryColl = 'all';
      }

      // Check if we are on Shop All / All Collections
      const isShopAllMode = queryColl === 'all' || queryColl === 'shop' || queryColl === '' && ('{{ is_shop_all }}' === 'true');

      if (isShopAllMode) {
        const headingEl = document.getElementById('category-page-heading');
        if (headingEl) headingEl.textContent = 'SHOP ALL JEWELRIES';
        document.title = 'SHOP ALL JEWELRIES — OGÉ Fine Jewelry';
      } else {
        const collData = {
          'victorious': { title: 'THE VICTORIOUS COLLECTION', img: '{{ "Victorious-collection.jpg" | asset_url }}' },
          'boundaries': { title: 'THE BOUNDARIES COLLECTION', img: '{{ "Boundaries-collection.jpg" | asset_url }}' },
          'rebirth': { title: 'THE REBIRTH COLLECTION', img: '{{ "Rebirth-collection.jpg" | asset_url }}' },
          'self-romance': { title: 'THE SELF WOMAN COLLECTION', img: '{{ "SelfRomance-collection.jpg" | asset_url }}' },
          'self-woman': { title: 'THE SELF WOMAN COLLECTION', img: '{{ "SelfRomance-collection.jpg" | asset_url }}' },
          'alignment': { title: 'THE ALIGNMENT COLLECTION', img: '{{ "alignment-collection.jpg" | asset_url }}' }
        };
        if (queryColl && collData[queryColl]) {
          const titleEl = document.querySelector('.collection-hero__title');
          if (titleEl) titleEl.textContent = collData[queryColl].title;
          const imgEl = document.querySelector('.collection-hero__image');
          if (imgEl) imgEl.src = collData[queryColl].img;
          document.title = `${collData[queryColl].title} — OGÉ Fine Jewelry`;
        }
      }

      // Density switchers (1, 2, 4 columns)
      const densityBtns = document.querySelectorAll('.grid-density-btn');
      densityBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          densityBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const cols = btn.getAttribute('data-cols') || '4';
          grid.classList.remove('grid--1-col', 'grid--2-col', 'grid--4-col');
          grid.classList.add(`grid--${cols}-col`);
        });
      });

      // Filter & Sort dropdown toggle
      const filterToggle = document.getElementById('filter-sort-toggle');
      const filterDropdown = document.getElementById('collection-filter-dropdown');
      if (filterToggle && filterDropdown) {
        filterToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = filterDropdown.classList.contains('is-open');
          filterDropdown.classList.toggle('is-open', !isOpen);
          filterToggle.setAttribute('aria-expanded', !isOpen);
        });

        document.addEventListener('click', (e) => {
          if (!filterDropdown.contains(e.target) && e.target !== filterToggle) {
            filterDropdown.classList.remove('is-open');
            filterToggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Catalog dataset fallback if liquid has 0 products
      const placeholder = document.getElementById('collection-empty-placeholder');
      let baseItems = [];
      if (window.OGE_HELPERS && window.OGE_CATALOG) {
        if (isShopAllMode) {
          baseItems = window.OGE_CATALOG;
        } else {
          const handle = queryColl || '{{ collection.handle }}' || 'self-woman';
          baseItems = window.OGE_HELPERS.getProductsByCollection(handle);
          if (!baseItems || baseItems.length === 0) {
            baseItems = window.OGE_CATALOG;
          }
        }

        if (placeholder || grid.children.length === 0) {
          renderGrid(baseItems);
        }
      }

      function renderGrid(items) {
        if (!items || items.length === 0) {
          grid.innerHTML = `
            <div style="grid-column: 1 / -1; padding: 60px 20px; text-align: center;">
              <h2 class="wishlist-empty-title">No products found</h2>
              <p class="wishlist-empty-desc">No products match this selection in this collection.</p>
            </div>
          `;
          return;
        }
        grid.innerHTML = items.map((p, idx) => window.OGE_HELPERS.renderProductCard(p, idx)).join('');
        if (window.OGE_CURRENCY && typeof window.OGE_CURRENCY.updateDOM === 'function') {
          window.OGE_CURRENCY.updateDOM();
        }
      }

      // Sub-filter tabs for signature collections
      const tabs = document.querySelectorAll('[data-collection-tab]');
      tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          tabs.forEach(t => t.classList.remove('is-active'));
          tab.classList.add('is-active');

          const tabType = tab.getAttribute('data-collection-tab');

          // If products were rendered by liquid directly:
          const domCards = Array.from(grid.querySelectorAll('.product-card'));
          if (domCards.length > 0 && (!window.OGE_CATALOG || !placeholder)) {
            domCards.forEach(card => {
              const text = (card.textContent || '').toLowerCase();
              const handle = (card.getAttribute('data-product-handle') || '').toLowerCase();
              if (tabType === 'all') {
                card.style.display = '';
              } else if (tabType === 'rings' && (text.includes('ring') || handle.includes('ring'))) {
                card.style.display = '';
              } else if (tabType === 'necklaces' && (text.includes('necklace') || handle.includes('necklace'))) {
                card.style.display = '';
              } else if (tabType === 'bracelets' && (text.includes('bracelet') || handle.includes('bracelet') || text.includes('bangle'))) {
                card.style.display = '';
              } else {
                card.style.display = 'none';
              }
            });
            return;
          }

          // If products rendered from dataset:
          if (baseItems && baseItems.length > 0) {
            if (tabType === 'all') {
              renderGrid(baseItems);
            } else {
              const filtered = baseItems.filter(p => {
                const cat = (p.category || '').toLowerCase();
                const title = (p.title || '').toLowerCase();
                if (tabType === 'rings') return cat === 'rings' || title.includes('ring');
                if (tabType === 'necklaces') return cat === 'necklaces' || title.includes('necklace');
                if (tabType === 'bracelets') return cat === 'bracelets' || title.includes('bracelet');
                return true;
              });
              renderGrid(filtered);
            }
          }
        });
      });

      // Sort options handling
      const sortBtns = document.querySelectorAll('#collection-filter-dropdown [data-sort]');
      sortBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          sortBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const sortVal = btn.getAttribute('data-sort');
          if (filterDropdown) filterDropdown.classList.remove('is-open');

          const cards = Array.from(grid.querySelectorAll('.product-card'));
          if (cards.length > 0) {
            cards.sort((a, b) => {
              const priceA = parseFloat((a.querySelector('.product-card__current-price')?.textContent || '0').replace(/[^0-9.]/g, '')) || 0;
              const priceB = parseFloat((b.querySelector('.product-card__current-price')?.textContent || '0').replace(/[^0-9.]/g, '')) || 0;
              if (sortVal === 'price-low') return priceA - priceB;
              if (sortVal === 'price-high') return priceB - priceA;
              return 0;
            });
            cards.forEach(card => grid.appendChild(card));
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollectionPage);
    } else {
      initCollectionPage();
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 36,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
