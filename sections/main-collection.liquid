{% comment %}
  OGÉ Fine Jewelry - Main Collection Section
  Online Store 2.0 Shopify collection grid with category navigation and pagination.
{% endcomment %}

<!-- Collection Hero Banner -->
<section class="collection-hero">
  {% if collection.image %}
    <img src="{{ collection.image | image_url: width: 1920 }}" alt="{{ collection.title | escape }}" class="collection-hero__image" loading="eager" width="1920" height="400">
  {% elsif collection.handle contains 'bound' %}
    <img src="{{ 'Boundaries-collection.jpg' | asset_url }}" alt="The Boundaries Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
  {% elsif collection.handle contains 'victor' %}
    <img src="{{ 'Victorious-collection.jpg' | asset_url }}" alt="The Victorious Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
  {% elsif collection.handle contains 'align' %}
    <img src="{{ 'alignment-collection.jpg' | asset_url }}" alt="The Alignment Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
  {% elsif collection.handle contains 'rebirth' %}
    <img src="{{ 'Rebirth-collection.jpg' | asset_url }}" alt="The Rebirth Collection" class="collection-hero__image" loading="eager" width="1920" height="400">
  {% else %}
    <img src="{{ 'SelfRomance-collection.jpg' | asset_url }}" alt="{{ collection.title | default: 'The Self Woman Collection' }}" class="collection-hero__image" loading="eager" width="1920" height="400">
  {% endif %}
  <div class="collection-hero__overlay"></div>
  <div class="collection-hero__content">
    <h1 class="collection-hero__title">{{ collection.title | default: 'ALL JEWELRY' }}</h1>
    {% if collection.description != blank %}
      <p class="collection-hero__desc">{{ collection.description }}</p>
    {% endif %}
  </div>
</section>

<!-- Subcategory Filter Tabs (Mini Navigator - Only Rings, Necklaces, Bracelets, Earrings) -->
<nav class="collection-category-tabs collection-nav-tabs" aria-label="Collection Categories">
  <a href="/collections/all?view=category&type=rings" class="collection-tab-btn {% if collection.handle == 'rings' or collection.handle contains 'ring' %}is-active{% endif %}">Rings</a>
  <a href="/collections/all?view=category&type=necklaces" class="collection-tab-btn {% if collection.handle == 'necklaces' or collection.handle contains 'necklace' %}is-active{% endif %}">Necklaces</a>
  <a href="/collections/all?view=category&type=bracelets" class="collection-tab-btn {% if collection.handle == 'bracelets' or collection.handle contains 'bracelet' %}is-active{% endif %}">Bracelets</a>
  <a href="/collections/all?view=category&type=earrings" class="collection-tab-btn {% if collection.handle == 'earrings' or collection.handle contains 'earring' %}is-active{% endif %}">Earrings</a>
</nav>

<!-- Collection Toolbar: Grid View Switchers (Filtering is handled via native collection category tabs above) -->
<div class="collection-toolbar" style="justify-content: flex-end;">
  <div class="collection-toolbar__right">
    <div class="collection-toolbar__view-switchers" aria-label="View Switchers">
      <!-- 1 Column Switcher -->
      <button type="button" class="grid-switch-btn" data-grid-view="1" aria-label="Single Column View" title="1 Column View">
        <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
      <!-- 2 Column Switcher -->
      <button type="button" class="grid-switch-btn" data-grid-view="2" aria-label="Two Columns View" title="2 Columns View">
        <svg viewBox="0 0 24 24"><rect x="4" y="5" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="5" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
      <!-- 4 Column Switcher (Default Active) -->
      <button type="button" class="grid-switch-btn is-active" data-grid-view="4" aria-label="Four Columns View" title="4 Columns View">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Product Catalog -->
<main class="collection-catalog-wrap">
  {% assign products_per_page = section.settings.products_per_page | default: 16 %}
  {% paginate collection.products by products_per_page %}
    <div class="collection-products-grid grid--4-col" id="collection-products-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        <div class="wishlist-empty-box collection-empty-state" id="collection-empty-placeholder" style="grid-column: 1 / -1; padding: 60px 20px; text-align: center;">
          <h2 class="wishlist-empty-title">Loading Jewelry...</h2>
          <p class="wishlist-empty-desc">Discovering handcrafted fine jewelry pieces.</p>
        </div>
      {% endif %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="collection-pagination" aria-label="Pagination">
        {{ paginate | default_pagination: next: 'Next &rarr;', previous: '&larr; Prev' }}
      </nav>
    {% endif %}
  {% endpaginate %}
</main>

<script>
  (function() {
    function initCollectionGrid() {
      const grid = document.getElementById('collection-products-grid');
      if (!grid) return;

      // Density switchers
      const switchers = document.querySelectorAll('.grid-switch-btn');
      switchers.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          switchers.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const cols = btn.getAttribute('data-grid-view') || '4';
          grid.classList.remove('grid--1-col', 'grid--2-col', 'grid--4-col');
          grid.classList.add(`grid--${cols}-col`);
        });
      });

      const params = new URLSearchParams(window.location.search);
      const queryColl = (params.get('collection') || '').toLowerCase().trim();
      const queryType = (params.get('type') || '').toLowerCase().trim();

      // Update banner and title if query collection is provided
      if (queryColl) {
        const collData = {
          'victorious': { title: 'THE VICTORIOUS COLLECTION', img: '{{ "Victorious-collection.jpg" | asset_url }}' },
          'boundaries': { title: 'THE BOUNDARIES COLLECTION', img: '{{ "Boundaries-collection.jpg" | asset_url }}' },
          'rebirth': { title: 'THE REBIRTH COLLECTION', img: '{{ "Rebirth-collection.jpg" | asset_url }}' },
          'self-romance': { title: 'THE SELF WOMAN COLLECTION', img: '{{ "SelfRomance-collection.jpg" | asset_url }}' },
          'self-woman': { title: 'THE SELF WOMAN COLLECTION', img: '{{ "SelfRomance-collection.jpg" | asset_url }}' },
          'alignment': { title: 'THE ALIGNMENT COLLECTION', img: '{{ "alignment-collection.jpg" | asset_url }}' }
        };
        if (collData[queryColl]) {
          const titleEl = document.querySelector('.collection-hero__title');
          if (titleEl) titleEl.textContent = collData[queryColl].title;
          const imgEl = document.querySelector('.collection-hero__image');
          if (imgEl) imgEl.src = collData[queryColl].img;
          document.title = `${collData[queryColl].title} — OGÉ Fine Jewelry`;
        }
      }

      // If Shopify liquid produced 0 products or query collection is specified, populate from catalog dataset
      const placeholder = document.getElementById('collection-empty-placeholder');
      if (window.OGE_HELPERS && window.OGE_CATALOG) {
        let handle = queryColl || queryType || '{{ collection.handle }}' || '';
        if (queryColl || placeholder) {
          let items = [];
          if (handle.includes('ring') || handle.includes('necklace') || handle.includes('bracelet') || handle.includes('earring') || handle.includes('fine') || handle.includes('men') || handle.includes('new')) {
            items = window.OGE_HELPERS.getProductsByCategory(handle);
          } else {
            items = window.OGE_HELPERS.getProductsByCollection(handle);
          }
          if (!items || items.length === 0) {
            items = window.OGE_CATALOG;
          }
          if (items && items.length > 0) {
            grid.innerHTML = items.map((p, idx) => window.OGE_HELPERS.renderProductCard(p, idx)).join('');
            if (window.OGE_CURRENCY && typeof window.OGE_CURRENCY.updateDOM === 'function') {
              window.OGE_CURRENCY.updateDOM();
            }
          } else if (placeholder) {
            placeholder.innerHTML = `
              <h2 class="wishlist-empty-title">No products found</h2>
              <p class="wishlist-empty-desc">There are currently no products available in this collection.</p>
              <a href="/collections/all" class="wishlist-shop-btn" style="display: inline-block;">Explore All Jewelry</a>
            `;
          }
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCollectionGrid);
    } else {
      initCollectionGrid();
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 36,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
