{% comment %}
  OGÉ Fine Jewelry - Main Register Section (Split Screen Multi-step)
  Left: Form / Right: sign-up-pic.jpg Image
{% endcomment %}

<div class="auth-page-wrapper">
  <div class="auth-split-grid">
    
    <!-- Left Column: Sign Up Multi-Step Form -->
    <div class="auth-form-column">
      <!-- Top Back Link -->
      <a href="{{ routes.account_login_url | default: '/account/login' }}" class="auth-back-link" aria-label="Go Back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back</span>
      </a>

      <!-- Form Inner Container -->
      <div class="auth-form-inner">
        <a href="{{ routes.root_url | default: '/' }}" class="auth-logo-center" aria-label="OGÉ Home">
          <img src="{{ 'logo2.png' | asset_url }}" alt="{{ shop.name }}" class="auth-logo-img" width="90" height="28">
        </a>

        <p class="auth-step-badge" id="signup-step-badge">Step 1 of 2</p>
        <p class="auth-subtitle">More than a Jewelry. Its a feeling.</p>

        {% form 'create_customer', id: 'form-auth-signup' %}
          {{ form.errors | default_errors }}
          
          <!-- ===============================================================
               STEP 1: PERSONAL DETAILS (First Name, Last Name, Email)
               =============================================================== -->
          <div class="auth-step is-active" id="signup-step-1">
            <!-- Name Fields Grid -->
            <div class="auth-form-grid-2">
              <div class="form-group-line">
                <label for="signup-firstname" class="form-label-line">First name *</label>
                <div class="form-input-line-wrap">
                  <input type="text" name="customer[first_name]" id="signup-firstname" class="form-input-line" placeholder="Enter first name" required autocomplete="given-name">
                </div>
              </div>

              <div class="form-group-line">
                <label for="signup-lastname" class="form-label-line">Last name *</label>
                <div class="form-input-line-wrap">
                  <input type="text" name="customer[last_name]" id="signup-lastname" class="form-input-line" placeholder="Enter last name" required autocomplete="family-name">
                </div>
              </div>
            </div>

            <!-- Email Field -->
            <div class="form-group-line">
              <label for="signup-email" class="form-label-line">Email address *</label>
              <div class="form-input-line-wrap">
                <input type="email" name="customer[email]" id="signup-email" class="form-input-line" placeholder="name@email.com" required autocomplete="email">
              </div>
            </div>

            <!-- Next Button -->
            <button type="button" class="auth-btn-primary" id="btn-signup-step1-next">Next</button>

            <!-- Footer Prompt -->
            <p class="auth-footer-prompt">
              Already have an account? <a href="/collections/all?view=login">Log in</a>
            </p>
          </div>

          <!-- ===============================================================
               STEP 2: SECURITY & PASSWORD
               =============================================================== -->
          <div class="auth-step" id="signup-step-2" style="display: none;">
            <!-- Password Field -->
            <div class="form-group-line">
              <label for="signup-password" class="form-label-line">Password*</label>
              <div class="form-input-line-wrap">
                <input type="password" name="customer[password]" id="signup-password" class="form-input-line" placeholder="Enter password" required autocomplete="new-password">
                <button type="button" class="password-eye-btn" data-toggle-password="signup-password" aria-label="Show password" title="Show password">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                      <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                      <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                      <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                      <line x1="2" y1="2" x2="22" y2="22"></line>
                    </svg>
                  </button>
              </div>
            </div>

            <!-- Re-type Password Field -->
            <div class="form-group-line">
              <label for="signup-confirm-password" class="form-label-line">Re-type password*</label>
              <div class="form-input-line-wrap">
                <input type="password" id="signup-confirm-password" class="form-input-line" placeholder="Re-type password" required autocomplete="new-password">
                <button type="button" class="password-eye-btn" data-toggle-password="signup-confirm-password" aria-label="Show password" title="Show password">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                      <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                      <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                      <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                      <line x1="2" y1="2" x2="22" y2="22"></line>
                    </svg>
                  </button>
              </div>
            </div>

            <!-- Buttons Row: Back & Next -->
            <div class="auth-buttons-group">
              <button type="button" class="auth-btn-secondary" id="btn-signup-step2-back">Back</button>
              <button type="submit" class="auth-btn-primary" id="btn-signup-step2-submit">Create Account</button>
            </div>

            <!-- Footer Prompt -->
            <p class="auth-footer-prompt">
              Already have an account? <a href="/collections/all?view=login">Log in</a>
            </p>
          </div>

        {% endform %}
      </div>

      <!-- Empty bottom spacer for symmetrical alignment -->
      <div class="auth-bottom-bar"></div>
    </div>

    <!-- Right Column: Editorial Campaign Image (sign-up-pic.jpg) -->
    <div class="auth-media-column">
      <img src="{{ 'sign-up-pic.jpg' | asset_url }}" alt="OGÉ Fine Jewelry Campaign" class="auth-media-img" loading="eager" width="1000" height="1200">
    </div>

  </div>
</div>

<script>
  (function() {
    var step1 = document.getElementById('signup-step-1');
    var step2 = document.getElementById('signup-step-2');
    var badge = document.getElementById('signup-step-badge');
    var btnNext = document.getElementById('btn-signup-step1-next');
    var btnBack = document.getElementById('btn-signup-step2-back');

    if (btnNext) {
      btnNext.addEventListener('click', function(e) {
        e.preventDefault();
        var fn = document.getElementById('signup-firstname');
        var ln = document.getElementById('signup-lastname');
        var em = document.getElementById('signup-email');

        if (!fn || !fn.value.trim()) { fn && fn.focus(); return; }
        if (!ln || !ln.value.trim()) { ln && ln.focus(); return; }
        if (!em || !em.value.trim() || !em.checkValidity()) { em && em.focus(); return; }

        if (step1) step1.style.display = 'none';
        if (step2) step2.style.display = 'block';
        if (badge) badge.textContent = 'Step 2 of 2';
      });
    }

    if (btnBack) {
      btnBack.addEventListener('click', function(e) {
        e.preventDefault();
        if (step2) step2.style.display = 'none';
        if (step1) step1.style.display = 'block';
        if (badge) badge.textContent = 'Step 1 of 2';
      });
    }

    document.querySelectorAll('[data-toggle-password]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var targetId = btn.getAttribute('data-toggle-password');
        var input = document.getElementById(targetId);
        if (input) {
          input.type = input.type === 'password' ? 'text' : 'password';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
