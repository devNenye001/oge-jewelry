<footer class="site-footer" {{ section.shopify_attributes }}>
  <div class="page-container">

    <!-- ====================================================================
         1. TOP MAIN 3-COLUMN FOOTER SECTION
         ==================================================================== -->
    <div class="site-footer__main">

      <!-- Column 1: SHOP -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col_1_title | default: 'SHOP' }}</h3>
        <nav class="footer-col__nav" aria-label="Shop Navigation">
          {% if section.settings.col_1_menu != blank %}
            {% for link in section.settings.col_1_menu.links %}
              <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
            {% endfor %}
          {% else %}
            <a href="{{ collections['new-arrival'].url | default: '/collections/new-in' }}" class="footer-col__link">New Arrivals</a>
            <a href="{{ collections['bestseller'].url | default: '/collections/all' }}" class="footer-col__link">Best Sellers</a>
            <a href="{{ collections['victorious-collection'].url | default: '/collections/victorious' }}" class="footer-col__link">Victorious Collection</a>
            <a href="{{ collections['the-self-romance-collection'].url | default: '/collections/self-romance' }}" class="footer-col__link">Self Romance Collection</a>
            <a href="{{ collections['boundaries-collection'].url | default: '/collections/boundaries' }}" class="footer-col__link">Boundaries Collection</a>
            <a href="{{ collections['the-rebirth-collection'].url | default: '/collections/rebirth' }}" class="footer-col__link">Rebirth Collection</a>
            <a href="{{ collections['bundled-collection'].url | default: '/pages/bundle-deals' }}" class="footer-col__link">Bundle Deals</a>
          {% endif %}
        </nav>
      </div>

      <!-- Column 2: DISCOVER -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col_2_title | default: 'DISCOVER' }}</h3>
        <nav class="footer-col__nav" aria-label="Discover Navigation">
          {% if section.settings.col_2_menu != blank %}
            {% for link in section.settings.col_2_menu.links %}
              <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
            {% endfor %}
          {% else %}
            <a href="{{ pages['about-oge-jewelry'].url | default: '/pages/about' }}" class="footer-col__link">Our Story</a>
            <a href="/pages/contact" class="footer-col__link">Contact Us</a>
            <a href="{{ pages['faq'].url | default: '/pages/faqs' }}" class="footer-col__link">FAQs</a>
            <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}" class="footer-col__link">Shipping &amp; Returns</a>
          {% endif %}
        </nav>
      </div>

      <!-- Column 3: STAY IN THE OGÉ CIRCLE (Newsletter) -->
      <div class="footer-col footer-col--newsletter">
        <h3 class="footer-col__title">{{ section.settings.newsletter_title | default: 'STAY IN THE OGÉ CIRCLE' }}</h3>
        <p class="footer-newsletter__text">
          {{ section.settings.newsletter_subtext | default: 'Be the first to know about new collections, exclusive offers, and private launches.' }}
        </p>

        {% form 'customer', class: 'footer-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter, footer_signup">
          <div class="footer-newsletter__input-wrapper">
            <input 
              type="email" 
              name="contact[email]" 
              class="footer-newsletter__input"
              placeholder="{{ 'footer.email_placeholder' | default: 'Enter your email' }}" 
              required 
              autocomplete="email"
              aria-label="{{ 'footer.email_placeholder' | default: 'Enter your email' }}"
            >
            <button type="submit" class="footer-newsletter__submit" aria-label="{{ 'footer.newsletter_button' | default: 'Subscribe' }}">
              {% render 'icon-chevron', direction: 'right' %}
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    <!-- ====================================================================
         2. MIDDLE BAR: PAYMENT ICONS & SOCIAL BUTTONS
         ==================================================================== -->
    <div class="site-footer__middle">
      {% render 'payment-icons' %}
      {% render 'social-icons' %}
    </div>

    <!-- ====================================================================
         3. BOTTOM SUB-FOOTER: REGION, COPYRIGHT & LEGAL LINKS
         ==================================================================== -->
    <div class="site-footer__bottom">
      <div class="footer-bottom__left">
        <div class="footer-region" data-country-trigger style="cursor: pointer;" title="Select Country &amp; Currency">
          <span class="region-badge">
            <span class="region-flag" data-country-display-flag>
              <svg viewBox="0 0 20 14" width="18" height="13" style="display:inline-block;vertical-align:middle;border-radius:2px;"><rect width="20" height="14" fill="#003399"/><circle cx="10" cy="7" r="4.2" fill="none" stroke="#FFCC00" stroke-width="1.2" stroke-dasharray="0.8 1.4"/></svg>
            </span>
            <span data-country-display-code>{{ localization.country.iso_code | default: 'EU' }}</span>
            {% render 'icon-chevron', direction: 'down' %}
          </span>
          <span class="footer-sep">&bull;</span>
          <span class="footer-copyright">{{ section.settings.copyright | default: '&copy; 2026 Oge Jewlery. All Rights Reserved.' }}</span>
        </div>
      </div>

      <div class="footer-bottom__right">
        <nav class="footer-legal" aria-label="Legal Links">
          <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" class="footer-legal__link">Privacy Policy</a>
          <span class="footer-legal__sep">&middot;</span>
          <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}" class="footer-legal__link">Terms &amp; Conditions</a>
          <span class="footer-legal__sep">&middot;</span>
          <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}" class="footer-legal__link">Shipping &amp; Returns</a>
        </nav>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 Title",
      "default": "SHOP"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 Menu"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "DISCOVER"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 Menu"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "STAY IN THE OGÉ CIRCLE"
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "Be the first to know about new collections, exclusive offers, and private launches."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "&copy; 2026 Oge Jewlery. All Rights Reserved."
    }
  ]
}
{% endschema %}
