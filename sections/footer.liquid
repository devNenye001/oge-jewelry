<footer class="site-footer" {{ section.shopify_attributes }}>
  <div class="page-container">

    <!-- ====================================================================
         1. TOP MAIN 3-COLUMN FOOTER SECTION
         ==================================================================== -->
    <div class="site-footer__main">

      <!-- Column 1: SHOP -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col_1_title | default: 'SHOP' }}</h3>
        <nav class="footer-col__nav" aria-label="Shop Navigation">
          {% assign col1_links = section.settings.col_1_menu.links %}
          {% if col1_links != blank and col1_links.size > 0 %}
            {% for link in col1_links %}
              <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
            {% endfor %}
          {% else %}
            {% assign new_in_url = collections['new-arrival'].url %}
            {% if new_in_url == blank or new_in_url == '' or new_in_url == '#' %}{% assign new_in_url = collections['new-in'].url %}{% endif %}
            {% if new_in_url == blank or new_in_url == '' or new_in_url == '#' %}{% assign new_in_url = '/collections/new-in' %}{% endif %}
            <a href="{{ new_in_url }}" class="footer-col__link">New Arrivals</a>

            {% assign best_url = collections['all'].url %}
            {% if best_url == blank or best_url == '' or best_url == '#' %}{% assign best_url = '/collections/all' %}{% endif %}
            <a href="{{ best_url }}" class="footer-col__link">Shop All Jewelries</a>
            <a href="/collections" class="footer-col__link">All Collections</a>

            {% assign vic_url = collections['victorious-collection'].url %}
            {% if vic_url == blank or vic_url == '' or vic_url == '#' %}{% assign vic_url = collections['victorious'].url %}{% endif %}
            {% if vic_url == blank or vic_url == '' or vic_url == '#' %}{% assign vic_url = '/collections/victorious-collection' %}{% endif %}
            <a href="{{ vic_url }}" class="footer-col__link">Victorious Collection</a>

            {% assign self_url = collections['the-self-romance-collection'].url %}
            {% if self_url == blank or self_url == '' or self_url == '#' %}{% assign self_url = collections['self-romance'].url %}{% endif %}
            {% if self_url == blank or self_url == '' or self_url == '#' %}{% assign self_url = collections['self-woman'].url %}{% endif %}
            {% if self_url == blank or self_url == '' or self_url == '#' %}{% assign self_url = '/collections/the-self-romance-collection' %}{% endif %}
            <a href="{{ self_url }}" class="footer-col__link">Self Romance Collection</a>

            {% assign bound_url = collections['boundaries-collection'].url %}
            {% if bound_url == blank or bound_url == '' or bound_url == '#' %}{% assign bound_url = collections['boundaries'].url %}{% endif %}
            {% if bound_url == blank or bound_url == '' or bound_url == '#' %}{% assign bound_url = '/collections/boundaries-collection' %}{% endif %}
            <a href="{{ bound_url }}" class="footer-col__link">Boundaries Collection</a>

            {% assign reb_url = collections['the-rebirth-collection'].url %}
            {% if reb_url == blank or reb_url == '' or reb_url == '#' %}{% assign reb_url = collections['rebirth'].url %}{% endif %}
            {% if reb_url == blank or reb_url == '' or reb_url == '#' %}{% assign reb_url = '/collections/the-rebirth-collection' %}{% endif %}
            <a href="{{ reb_url }}" class="footer-col__link">Rebirth Collection</a>

            {% assign bundle_url = pages['bundle-deals'].url %}
            {% if bundle_url == blank or bundle_url == '' or bundle_url == '#' %}{% assign bundle_url = '/pages/bundle-deals' %}{% endif %}
            <a href="{{ bundle_url }}" class="footer-col__link">Bundle Deals</a>
          {% endif %}
        </nav>
      </div>

      <!-- Column 2: DISCOVER -->
      <div class="footer-col">
        <h3 class="footer-col__title">{{ section.settings.col_2_title | default: 'DISCOVER' }}</h3>
        <nav class="footer-col__nav" aria-label="Discover Navigation">
          {% assign col2_links = section.settings.col_2_menu.links %}
          {% if col2_links != blank and col2_links.size > 0 %}
            {% for link in col2_links %}
              <a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a>
            {% endfor %}
          {% else %}
            {% assign story_url = pages['about-oge-jewelry'].url %}
            {% if story_url == blank or story_url == '' or story_url == '#' %}{% assign story_url = pages['our-story'].url %}{% endif %}
            {% if story_url == blank or story_url == '' or story_url == '#' %}{% assign story_url = pages['about'].url %}{% endif %}
            {% if story_url == blank or story_url == '' or story_url == '#' %}{% assign story_url = '/collections/all?view=about' %}{% endif %}
            <a href="{{ story_url }}" class="footer-col__link">Our Story</a>

            {% assign contact_url = pages['contact'].url %}
            {% if contact_url == blank or contact_url == '' or contact_url == '#' %}{% assign contact_url = pages['contact-us'].url %}{% endif %}
            {% if contact_url == blank or contact_url == '' or contact_url == '#' %}{% assign contact_url = '/collections/all?view=contact' %}{% endif %}
            <a href="{{ contact_url }}" class="footer-col__link">Contact Us</a>

            {% assign faq_url = pages['faq'].url %}
            {% if faq_url == blank or faq_url == '' or faq_url == '#' %}{% assign faq_url = pages['faqs'].url %}{% endif %}
            {% if faq_url == blank or faq_url == '' or faq_url == '#' %}{% assign faq_url = '/collections/all?view=faqs' %}{% endif %}
            <a href="{{ faq_url }}" class="footer-col__link">FAQs</a>

            {% assign shipping_url = pages['shipping-returns'].url %}
            {% if shipping_url == blank or shipping_url == '' or shipping_url == '#' %}{% assign shipping_url = shop.shipping_policy.url %}{% endif %}
            {% if shipping_url == blank or shipping_url == '' or shipping_url == '#' %}{% assign shipping_url = '/collections/all?view=shipping-returns' %}{% endif %}
            <a href="{{ shipping_url }}" class="footer-col__link">Shipping &amp; Returns</a>
          {% endif %}
        </nav>
      </div>

      <!-- Column 3: STAY IN THE OGÉ CIRCLE (Newsletter) -->
      <div class="footer-col footer-col--newsletter">
        <h3 class="footer-col__title">{{ section.settings.newsletter_title | default: 'STAY IN THE OGÉ CIRCLE' }}</h3>
        <p class="footer-newsletter__text">
          {{ section.settings.newsletter_subtext | default: 'Be the first to know about new collections, exclusive offers, and private launches.' }}
        </p>

        {% form 'customer', class: 'footer-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter, footer_signup">
          <div class="footer-newsletter__input-wrapper">
            <input 
              type="email" 
              name="contact[email]" 
              class="footer-newsletter__input"
              placeholder="Enter your email" 
              required 
              autocomplete="email"
              aria-label="Enter your email"
            >
            <button type="submit" class="footer-newsletter__submit" aria-label="Subscribe">
              {% render 'icon-chevron', direction: 'right' %}
            </button>
          </div>
        {% endform %}
      </div>

    </div>

    <!-- ====================================================================
         2. MIDDLE BAR: PAYMENT ICONS & SOCIAL BUTTONS
         ==================================================================== -->
    <div class="site-footer__middle">
      {% render 'payment-icons' %}
      {% render 'social-icons' %}
    </div>

    <!-- ====================================================================
         3. BOTTOM SUB-FOOTER: REGION, COPYRIGHT & LEGAL LINKS
         ==================================================================== -->
    <div class="site-footer__bottom">
      <div class="footer-bottom__left">
        <div class="footer-region" data-country-trigger style="cursor: pointer;" title="Select Country &amp; Currency">
          <span class="region-badge">
            <span class="region-flag" data-country-display-flag>
              <svg viewBox="0 0 20 14" width="18" height="13" style="display:inline-block;vertical-align:middle;border-radius:2px;"><rect width="20" height="14" fill="#003399"/><circle cx="10" cy="7" r="4.2" fill="none" stroke="#FFCC00" stroke-width="1.2" stroke-dasharray="0.8 1.4"/></svg>
            </span>
            <span data-country-display-code>{{ localization.country.iso_code | default: 'EU' }}</span>
            {% render 'icon-chevron', direction: 'down' %}
          </span>
          <span class="footer-sep">&bull;</span>
          <span class="footer-copyright">{{ section.settings.copyright | default: '&copy; 2026 Oge Jewlery. All Rights Reserved.' }}</span>
        </div>
      </div>

      <div class="footer-bottom__right">
        <nav class="footer-legal" aria-label="Legal Links">
          {% assign privacy_url = pages['privacy-policy'].url %}
          {% if privacy_url == blank or privacy_url == '' %}{% assign privacy_url = shop.privacy_policy.url %}{% endif %}
          {% if privacy_url == blank or privacy_url == '' %}{% assign privacy_url = '/collections/all?view=privacy-policy' %}{% endif %}
          <a href="{{ privacy_url }}" class="footer-legal__link">Privacy Policy</a>
          <span class="footer-legal__sep">&middot;</span>

          {% assign terms_url = pages['terms-conditions'].url %}
          {% if terms_url == blank or terms_url == '' %}{% assign terms_url = shop.terms_of_service.url %}{% endif %}
          {% if terms_url == blank or terms_url == '' %}{% assign terms_url = '/collections/all?view=terms-conditions' %}{% endif %}
          <a href="{{ terms_url }}" class="footer-legal__link">Terms &amp; Conditions</a>
          <span class="footer-legal__sep">&middot;</span>

          {% assign shipping_policy_url = pages['shipping-returns'].url %}
          {% if shipping_policy_url == blank or shipping_policy_url == '' %}{% assign shipping_policy_url = shop.shipping_policy.url %}{% endif %}
          {% if shipping_policy_url == blank or shipping_policy_url == '' %}{% assign shipping_policy_url = '/collections/all?view=shipping-returns' %}{% endif %}
          <a href="{{ shipping_policy_url }}" class="footer-legal__link">Shipping &amp; Returns</a>
        </nav>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 Title",
      "default": "SHOP"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 Menu"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "DISCOVER"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 Menu"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "STAY IN THE OGÉ CIRCLE"
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "Be the first to know about new collections, exclusive offers, and private launches."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "&copy; 2026 Oge Jewlery. All Rights Reserved."
    }
  ]
}
{% endschema %}
