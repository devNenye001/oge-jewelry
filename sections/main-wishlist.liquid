{% comment %}
  OGÉ Fine Jewelry - Main Wishlist Section
  Supports Active State (Saved Items Grid) and Empty State (with Best Sellers Carousel)
{% endcomment %}

{% render 'page-content-wishlist', section: section %}

{% schema %}
{
  "name": "Wishlist Page",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back to Overview"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty State Title",
      "default": "Nothing has been saved to your Wishlist"
    },
    {
      "type": "textarea",
      "id": "empty_subtitle",
      "label": "Empty State Subtitle",
      "default": "It looks like you haven't saved any items yet, why not check out our best sellers?"
    },
    {
      "type": "text",
      "id": "empty_btn_label",
      "label": "Empty Button Label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "empty_btn_link",
      "label": "Empty Button Link"
    },
    {
      "type": "text",
      "id": "rec_heading",
      "label": "Recommendations Heading",
      "default": "YOU MAY ALSO LIKE"
    }
  ]
}
{% endschema %}
