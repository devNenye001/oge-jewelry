<section class="featured-collection-section" style="padding: 40px 0; background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};" {{ section.shopify_attributes }}>
  <div class="page-container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.heading | default: 'NEW ARRIVALS' }}</h2>
      {% if section.settings.show_navigation %}
        <div class="carousel-nav-btns">
          <button type="button" class="carousel-nav-btn" data-header-scroll-prev aria-label="Previous Products">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="carousel-nav-btn" data-header-scroll-next aria-label="Next Products">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="horizontal-scroll-container" data-horizontal-scroll>
      <button type="button" class="scroll-edge-arrow scroll-edge-arrow--prev is-hidden" data-scroll-prev aria-label="Previous Products">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="horizontal-scroll-track" data-scroll-track>
      {% assign featured_collection = section.settings.collection %}
      {% if featured_collection == blank %}
        {% if section.settings.preset_type == 'new_arrivals' and collections['new-arrival'] != blank and collections['new-arrival'].products_count > 0 %}
          {% assign featured_collection = collections['new-arrival'] %}
        {% elsif section.settings.preset_type == 'best_sellers' and collections['bestseller'] != blank and collections['bestseller'].products_count > 0 %}
          {% assign featured_collection = collections['bestseller'] %}
        {% endif %}
      {% endif %}

      {% if featured_collection != blank and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
      </div>

      <button type="button" class="scroll-edge-arrow scroll-edge-arrow--next" data-scroll-next aria-label="Next Products">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "select",
      "id": "preset_type",
      "label": "Default Collection",
      "options": [
        { "value": "new_arrivals", "label": "New Arrivals (new-arrival collection)" },
        { "value": "best_sellers", "label": "Pieces Worth Keeping (bestseller collection)" }
      ],
      "default": "new_arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "New Arrivals",
      "settings": {
        "heading": "NEW ARRIVALS",
        "preset_type": "new_arrivals"
      }
    },
    {
      "name": "Pieces Worth Keeping",
      "settings": {
        "heading": "PIECES WORTH KEEPING",
        "preset_type": "best_sellers"
      }
    }
  ]
}
{% endschema %}
