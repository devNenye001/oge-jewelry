        {
          "type": "text",
          "id": "video_url",
          "label": "Or Video URL / Asset Name (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Watch on Insta & Banner"
    }
  ]
}
{% endschema %}
