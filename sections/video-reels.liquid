{% liquid
  assign default_fallback_1 = 'video.mp4' | asset_url
  assign default_fallback_2 = 'large-home-video.mp4' | asset_url
  assign default_fallback_3 = 'video.mp4' | asset_url
  assign default_large_video = 'large-home-video.mp4' | asset_url
%}

<section class="video-section" style="padding: 50px 0 0; background-color: #FFFFFF;" {{ section.shopify_attributes }}>
  <div class="page-container">
    {% if section.settings.heading != blank %}
      <div style="text-align: center; margin-bottom: 32px;">
        <h2 class="heading-section" style="margin-bottom: 8px;">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <!-- Video Reels Grid -->
    <div class="video-reels-grid" style="margin-bottom: 36px;">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="video-reel-card" {{ block.shopify_attributes }}>
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'video-reel-player' }}
            {% elsif block.settings.video_url != blank %}
              {% assign b_vurl = block.settings.video_url %}
              {% unless b_vurl contains '/' %}
                {% assign b_vurl = b_vurl | asset_url %}
              {% endunless %}
              <video src="{{ b_vurl }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
            {% else %}
              <video src="{{ default_fallback_1 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Reel 1 -->
        <div class="video-reel-card">
          {% if section.settings.video_1 != blank %}
            {{ section.settings.video_1 | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'video-reel-player' }}
          {% elsif section.settings.video_url_1 != blank %}
            {% assign v1 = section.settings.video_url_1 %}
            {% unless v1 contains '/' %}
              {% assign v1 = v1 | asset_url %}
            {% endunless %}
            <video src="{{ v1 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
          {% else %}
            <video src="{{ default_fallback_1 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
          {% endif %}
        </div>

        <!-- Reel 2 -->
        <div class="video-reel-card">
          {% if section.settings.video_2 != blank %}
            {{ section.settings.video_2 | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'video-reel-player' }}
          {% elsif section.settings.video_url_2 != blank %}
            {% assign v2 = section.settings.video_url_2 %}
            {% unless v2 contains '/' %}
              {% assign v2 = v2 | asset_url %}
            {% endunless %}
            <video src="{{ v2 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
          {% else %}
            <video src="{{ default_fallback_2 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
          {% endif %}
        </div>

        <!-- Reel 3 -->
        <div class="video-reel-card">
          {% if section.settings.video_3 != blank %}
            {{ section.settings.video_3 | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'video-reel-player' }}
          {% elsif section.settings.video_url_3 != blank %}
            {% assign v3 = section.settings.video_url_3 %}
            {% unless v3 contains '/' %}
              {% assign v3 = v3 | asset_url %}
            {% endunless %}
            <video src="{{ v3 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
          {% else %}
            <video src="{{ default_fallback_3 }}" autoplay muted loop playsinline controls class="video-reel-player"></video>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Brown CTA Button: #995544 (DM Sans 400, Sentence Case) -->
    {% if section.settings.btn_text != blank %}
      <div style="text-align: center; margin-bottom: 48px;">
        <a href="{{ section.settings.btn_url | default: 'https://instagram.com' }}" target="_blank" rel="noopener noreferrer" class="btn btn-brown" style="padding: 14px 36px; border-radius: 2px;">
          {{ section.settings.btn_text }}
        </a>
      </div>
    {% endif %}
  </div>

  <!-- Full-Width Large Home Video (After Stay Connected Section): Autoplay, Muted, Loop, Controls -->
  <div class="large-video-banner">
    {% if section.settings.large_video != blank %}
      {{ section.settings.large_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'large-video-player' }}
    {% elsif section.settings.large_video_url != blank %}
      {% assign lv = section.settings.large_video_url %}
      {% unless lv contains '/' %}
        {% assign lv = lv | asset_url %}
      {% endunless %}
      <video src="{{ lv }}" autoplay muted loop playsinline controls class="large-video-player"></video>
    {% else %}
      <video src="{{ default_large_video }}" autoplay muted loop playsinline controls class="large-video-player"></video>
    {% endif %}
  </div>
</section>

<script>
  (function() {
    function initAutoplay() {
      var allVids = document.querySelectorAll('.video-section video');
      allVids.forEach(function(vid) {
        vid.muted = true;
        var playPromise = vid.play();
        if (playPromise !== undefined) {
          playPromise.catch(function() {
            // Autoplay prevented by browser, muted attribute is present so user can interact
          });
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAutoplay);
    } else {
      initAutoplay();
    }
  })();
</script>

{% schema %}
{
  "name": "Watch on Insta & Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WATCH ON INSTA"
    },
    {
      "type": "header",
      "content": "Reel Video 1"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Upload Video 1"
    },
    {
      "type": "text",
      "id": "video_url_1",
      "label": "Or Video 1 URL / Asset Name (Optional)"
    },
    {
      "type": "header",
      "content": "Reel Video 2"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Upload Video 2"
    },
    {
      "type": "text",
      "id": "video_url_2",
      "label": "Or Video 2 URL / Asset Name (Optional)"
    },
    {
      "type": "header",
      "content": "Reel Video 3"
    },
    {
      "type": "video",
      "id": "video_3",
      "label": "Upload Video 3"
    },
    {
      "type": "text",
      "id": "video_url_3",
      "label": "Or Video 3 URL / Asset Name (Optional)"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "btn_text",
