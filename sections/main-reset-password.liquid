{% comment %}
  OGÉ Fine Jewelry - Main Reset Password Section (Token Reset from Email)
  Left: Form / Right: Victorious Collection Image
{% endcomment %}

<div class="auth-page-wrapper">
  <div class="auth-split-grid">
    
    <!-- Left Column: Reset Password Form -->
    <div class="auth-form-column">
      <!-- Top Back Link -->
      <a href="{{ routes.account_login_url }}" class="auth-back-link" aria-label="Go Back to Login">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back to Login</span>
      </a>

      <!-- Form Inner Container -->
      <div class="auth-form-inner">
        <a href="{{ routes.root_url }}" class="auth-logo-center" aria-label="OGÉ Home">
          <img src="{{ 'logo2.png' | asset_url }}" alt="{{ shop.name }}" class="auth-logo-img" width="90" height="28">
        </a>

        <h1 class="auth-title-serif" style="text-align: center; font-size: 1.5rem; margin-top: 16px; margin-bottom: 8px;">RESET ACCOUNT PASSWORD</h1>
        
        <p class="auth-subtitle">Enter a new password for your account.</p>

        {% form 'reset_customer_password', id: 'form-auth-reset-password' %}
          {{ form.errors | default_errors }}

          <!-- New Password Field -->
          <div class="form-group-line" style="margin-bottom: 20px;">
            <label for="reset-password" class="form-label-line">New password</label>
            <div class="form-input-line-wrap">
              <input type="password" name="customer[password]" id="reset-password" class="form-input-line" placeholder="Enter new password" required autocomplete="new-password">
              <button type="button" class="password-eye-btn" data-toggle-password="reset-password" aria-label="Show password" title="Show password">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                  <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                  <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                  <line x1="2" y1="2" x2="22" y2="22"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Confirm Password Field -->
          <div class="form-group-line" style="margin-bottom: 24px;">
            <label for="reset-password-confirm" class="form-label-line">Confirm password</label>
            <div class="form-input-line-wrap">
              <input type="password" name="customer[password_confirmation]" id="reset-password-confirm" class="form-input-line" placeholder="Confirm new password" required autocomplete="new-password">
              <button type="button" class="password-eye-btn" data-toggle-password="reset-password-confirm" aria-label="Show password" title="Show password">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                  <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                  <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                  <line x1="2" y1="2" x2="22" y2="22"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="auth-btn-primary" id="btn-reset-submit">Reset Password</button>

          <!-- Back to Login Link -->
          <div style="text-align: center; margin-top: 20px;">
            <a href="{{ routes.account_login_url }}" class="auth-forgot-link" style="font-size: 0.8125rem;">Back to login</a>
          </div>
        {% endform %}
      </div>

      <!-- Bottom Spacer -->
      <div class="auth-bottom-bar">
        <div class="auth-badge-icon" title="Accessibility & Privacy Verified" aria-label="Accessibility">
          <span>◒</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Editorial Campaign Image (Victorious Collection) -->
    <div class="auth-media-column">
      <img src="{{ 'Victorious-collection.jpg' | asset_url }}" alt="Victorious Collection — OGÉ Fine Jewelry" class="auth-media-img" loading="eager" width="1000" height="1200">
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Customer Reset Password",
  "settings": []
}
{% endschema %}
