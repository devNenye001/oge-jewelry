{% comment %}
  OGÉ Fine Jewelry - Main Reset Password Section (Split Screen)
  Left: Form / Right: Victorious Collection Image
{% endcomment %}

<div class="auth-page-wrapper">
  <div class="auth-split-grid">
    
    <!-- Left Column: Reset Password Form -->
    <div class="auth-form-column">
      <!-- Top Back Link -->
      <a href="{{ routes.account_login_url | default: '/account/login' }}" class="auth-back-link" aria-label="Go Back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back</span>
      </a>

      <!-- Form Inner Container -->
      <div class="auth-form-inner">
        <h1 class="auth-title-serif">RESET PASSWORD</h1>
        
        <p class="auth-subtitle">We'll send you an email to reset your password.</p>

        {% form 'recover_customer_password', id: 'form-auth-reset-password' %}
          {{ form.errors | default_errors }}

          {% if form.posted_successfully? %}
            <p style="color: #2e7d32; font-size: 0.875rem; margin-bottom: 16px;">
              {{ 'customer.recover_password.success' | t | default: "We've sent you an email with a link to update your password." }}
            </p>
          {% endif %}

          <!-- Email Address Field -->
          <div class="form-group-line" style="margin-bottom: 24px;">
            <label for="reset-email" class="form-label-line">Email address</label>
            <div class="form-input-line-wrap">
              <input type="email" name="email" id="reset-email" class="form-input-line" placeholder="name@email.com" required autocomplete="email">
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="auth-btn-primary" id="btn-reset-submit">Reset Password</button>

          <!-- Back to Login Link -->
          <div style="text-align: center; margin-top: 18px;">
            <a href="{{ routes.account_login_url | default: '/account/login' }}" class="auth-forgot-link" style="font-size: 0.8125rem;">Back to login</a>
          </div>
        {% endform %}
      </div>

      <!-- Bottom Spacer -->
      <div class="auth-bottom-bar"></div>
    </div>

    <!-- Right Column: Editorial Campaign Image (Victorious Collection) -->
    <div class="auth-media-column">
      <img src="{{ 'Victorious-collection.jpg' | asset_url }}" alt="Victorious Collection — OGÉ Fine Jewelry" class="auth-media-img" loading="eager" width="1000" height="1200">
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Customer Reset Password",
  "settings": []
}
{% endschema %}
