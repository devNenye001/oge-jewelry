{% comment %}
  OGÉ Fine Jewelry - Main Recover / Forgot Password Section (Split Screen)
  Left: Form / Right: Victorious Collection Image
{% endcomment %}

<div class="auth-page-wrapper">
  <div class="auth-split-grid">
    
    <!-- Left Column: Recover Password Form -->
    <div class="auth-form-column">
      <!-- Top Back Link -->
      <a href="{{ routes.account_login_url }}" class="auth-back-link" aria-label="Go Back to Login">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Back to Login</span>
      </a>

      <!-- Form Inner Container -->
      <div class="auth-form-inner">
        <a href="{{ routes.root_url }}" class="auth-logo-center" aria-label="OGÉ Home">
          <img src="{{ 'logo2.png' | asset_url }}" alt="{{ shop.name }}" class="auth-logo-img" width="90" height="28">
        </a>

        <h1 class="auth-title-serif" style="text-align: center; font-size: 1.5rem; margin-top: 16px; margin-bottom: 8px;">FORGOT PASSWORD</h1>
        
        <p class="auth-subtitle">We will send you an email with instructions to reset your password.</p>

        {% form 'recover_customer_password', id: 'form-auth-recover' %}
          {{ form.errors | default_errors }}

          {% if form.posted_successfully? %}
            <div class="auth-success-box" style="padding: 14px 18px; background-color: #F4FBF7; color: #1E6B38; border: 1px solid #C8E6C9; margin-bottom: 24px; font-size: 0.875rem; text-align: center; line-height: 1.5;">
              {{ 'customer.recover_password.success' | t | default: "We've sent you an email with a link to update your password." }}
            </div>
          {% endif %}

          <!-- Email Address Field -->
          <div class="form-group-line" style="margin-bottom: 24px;">
            <label for="recover-email" class="form-label-line">Email address</label>
            <div class="form-input-line-wrap">
              <input type="email" name="email" id="recover-email" class="form-input-line" placeholder="name@email.com" required autocomplete="email" autofocus>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="auth-btn-primary" id="btn-recover-submit">Submit</button>

          <!-- Back to Login Link -->
          <div style="text-align: center; margin-top: 20px;">
            <a href="{{ routes.account_login_url }}" class="auth-forgot-link" style="font-size: 0.8125rem;">Cancel & Return to Login</a>
          </div>
        {% endform %}
      </div>

      <!-- Bottom Spacer / Accessibility Badge -->
      <div class="auth-bottom-bar">
        <div class="auth-badge-icon" title="Accessibility & Privacy Verified" aria-label="Accessibility">
          <span>◒</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Editorial Campaign Image (Victorious Collection) -->
    <div class="auth-media-column">
      <img src="{{ 'Victorious-collection.jpg' | asset_url }}" alt="Victorious Collection — OGÉ Fine Jewelry" class="auth-media-img" loading="eager" width="1000" height="1200">
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Recover Password",
  "settings": []
}
{% endschema %}
