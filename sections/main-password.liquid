<div class="password-main" style="max-width: 500px; padding: 40px 20px; margin: 0 auto; text-align: center;" {{ section.shopify_attributes }}>
  <div class="site-logo" style="margin-bottom: 24px; display: inline-block;">
    <span class="site-logo__text" style="color: #FFFFFF; font-size: 3rem;">{{ section.settings.logo_text | default: '06é' }}</span>
  </div>
  <h1 class="heading-section" style="color: #F3C96B; margin-bottom: 16px;">{{ section.settings.heading | default: 'COMING SOON' }}</h1>
  <p style="color: #AAAAAA; font-size: 1rem; line-height: 1.6; margin-bottom: 32px;">
    {{ section.settings.subtext | default: 'Our bespoke fine jewelry collections are being prepared. Be the first to know when we launch.' }}
  </p>

  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <div style="display: flex; gap: 8px; justify-content: center;">
      <input type="password" name="password" placeholder="Enter store password" style="padding: 12px 16px; border-radius: 4px; border: 1px solid #444; background: #222; color: #FFF;">
      <button type="submit" class="btn btn-gold">Enter</button>
    </div>
  {% endform %}
</div>

{% schema %}
{
  "name": "Password Main",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "06é"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMING SOON"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Our bespoke fine jewelry collections are being prepared. Be the first to know when we launch."
    }
  ]
}
{% endschema %}
