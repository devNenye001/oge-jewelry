{% comment %}
  OGÉ Fine Jewelry - 404 Page Template
  Matches 404.html mockup
{% endcomment %}

{% if request.path contains 'bundle' %}
  {% section 'main-bundle-deals' %}
{% elsif request.path contains 'fine-jewel' %}
  {% section 'main-collection-fine-jewelry' %}
{% elsif request.path contains 'philosophy' %}
  {% section 'main-about' %}
{% elsif request.path contains 'not-found' or request.path contains 'page-not-found' or request.path contains 'pages/404' %}
  <style>
    .site-header, .site-footer, .announcement-bar, #newsletter-popup, aside, footer, header {
      display: none !important;
    }
    body, html {
      background-color: #ffffff !important;
      margin: 0 !important;
      padding: 0 !important;
      height: 100% !important;
    }
    main#MainContent {
      padding: 0 !important;
      margin: 0 !important;
      min-height: 100vh !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      background-color: #ffffff !important;
    }
  </style>
  <div style="min-height: 100vh; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #ffffff; padding: 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; text-align: center; box-sizing: border-box;">
    <div style="max-width: 500px; width: 100%;">
      <h1 style="font-size: 24px; font-weight: 600; line-height: 1.3; color: #000000; margin: 0 0 8px 0; letter-spacing: -0.02em;">This page doesn’t exist</h1>
      <p style="font-size: 14px; line-height: 1.5; color: #666666; margin: 0 0 32px 0;">It may have been moved, removed, or never existed.</p>
      <div style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; font-size: 13px; font-weight: 600; color: #000000; margin-bottom: 10px; letter-spacing: 0.05em;">404 NOT_FOUND</div>
      <div style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; font-size: 12px; color: #888888;">fra1::g67qk-1793616830527-45b3bd01bf29</div>
    </div>
  </div>
{% else %}
<section class="not-found-section" id="oge-404-default" {{ section.shopify_attributes }}>
  <div class="page-container">
    <div class="not-found-content">
      <h1 class="not-found-title">{{ section.settings.title | default: '404 page not found' }}</h1>
      <p class="not-found-desc">
        {{ section.settings.subtext | default: 'Unfortunately the page you’re looking for doesn’t seem<br>to exist.' }}
      </p>
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="not-found-btn">
        {{ section.settings.button_text | default: 'Go Home' }}
      </a>
    </div>
  </div>
</section>

<!-- Best Sellers Section on 404 (Straight Horizontal Row matching 404.html) -->
<section class="featured-collection-section" style="padding: 20px 0 60px; background-color: #FFFFFF;" id="best-sellers">
  <div class="page-container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.bestsellers_heading | default: 'BEST SELLERS' }}</h2>
      <div class="carousel-nav-btns">
        <button type="button" class="carousel-nav-btn" data-header-scroll-prev aria-label="Previous Best Sellers">
          {% render 'icon-chevron', direction: 'left' %}
        </button>
        <button type="button" class="carousel-nav-btn" data-header-scroll-next aria-label="Next Best Sellers">
          {% render 'icon-chevron', direction: 'right' %}
        </button>
      </div>
    </div>

    <div class="horizontal-scroll-container" data-horizontal-scroll>
      <button type="button" class="scroll-edge-arrow scroll-edge-arrow--prev is-hidden" data-scroll-prev aria-label="Previous Products">
        {% render 'icon-chevron', direction: 'left' %}
      </button>

      <div class="horizontal-scroll-track not-found-bestsellers-grid" data-scroll-track id="not-found-bestsellers-track">
        {% assign bs_collection = section.settings.collection %}
        {% if bs_collection == blank or bs_collection.products_count == 0 %}
          {% if collections['bestseller'] != blank and collections['bestseller'].products_count > 0 %}
            {% assign bs_collection = collections['bestseller'] %}
          {% elsif collections['new-arrival'] != blank and collections['new-arrival'].products_count > 0 %}
            {% assign bs_collection = collections['new-arrival'] %}
          {% elsif collections.all != blank and collections.all.products_count > 0 %}
            {% assign bs_collection = collections.all %}
          {% endif %}
        {% endif %}

        {% if bs_collection != blank and bs_collection.products_count > 0 %}
          {% for product in bs_collection.products limit: 4 %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% endif %}
      </div>

      <button type="button" class="scroll-edge-arrow scroll-edge-arrow--next" data-scroll-next aria-label="Next Products">
        {% render 'icon-chevron', direction: 'right' %}
      </button>
    </div>
  </div>
</section>

<hr style="border: none; border-top: 1px solid #ECECEC; margin: 0;">

<!-- Client-side bundle deals fallback if URL has bundle -->
<div id="oge-404-bundle-fallback" style="display: none;">
  {% render 'bundle-deals-card-grid' %}
</div>

<script>
  (function() {
    var p = window.location.pathname.toLowerCase();
    if (p.indexOf('bundle') !== -1) {
      var default404 = document.getElementById('oge-404-default');
      var fallback = document.getElementById('oge-404-bundle-fallback');
      var bs = document.getElementById('best-sellers');
      if (default404) default404.style.display = 'none';
      if (bs) bs.style.display = 'none';
      if (fallback) fallback.style.display = 'block';
      return;
    }

    function init404BestSellers() {
      const track = document.getElementById('not-found-bestsellers-track');
      if (track && track.children.length === 0 && window.OGE_HELPERS && window.OGE_CATALOG) {
        const bestSellers = window.OGE_HELPERS.getBestSellers ? window.OGE_HELPERS.getBestSellers().slice(0, 4) : window.OGE_CATALOG.slice(0, 4);
        track.innerHTML = bestSellers.map((p, idx) => window.OGE_HELPERS.renderProductCard(p, idx)).join('');
        if (window.OGE_CURRENCY) window.OGE_CURRENCY.updateDOM();
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init404BestSellers);
    } else {
      init404BestSellers();
    }
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-404",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "404 page not found"
    },
    {
      "type": "html",
      "id": "subtext",
      "label": "Subtext",
      "default": "Unfortunately the page you’re looking for doesn’t seem<br>to exist."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Go Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Best Sellers Carousel"
    },
    {
      "type": "text",
      "id": "bestsellers_heading",
      "label": "Best Sellers Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Best Sellers Collection"
    }
  ]
}
{% endschema %}
