<div id="not-found-standard-view">
    <section class="not-found-section" {{ section.shopify_attributes }}>
      <div class="page-container">
        <div class="not-found-content">
          <h1 class="not-found-title">{{ section.settings.title | default: '404 page not found' }}</h1>
          <p class="not-found-desc">
            {{ section.settings.subtext | default: 'Unfortunately the page you’re looking for doesn’t seem<br>to exist.' }}
          </p>
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="not-found-btn">
            {{ section.settings.button_text | default: 'Go Home' }}
          </a>
        </div>
      </div>
    </section>

    <!-- Best Sellers Section on 404 (Straight Horizontal Row) -->
    <section class="featured-collection-section" style="padding: 20px 0 60px; background-color: #FFFFFF;" id="best-sellers">
      <div class="page-container">
        <div class="section-header">
          <h2 class="section-header__title">{{ section.settings.bestsellers_heading | default: 'BEST SELLERS' }}</h2>
          <div class="carousel-nav-btns">
            <button type="button" class="carousel-nav-btn" data-header-scroll-prev aria-label="Previous Best Sellers">
              {% render 'icon-chevron', direction: 'left' %}
            </button>
            <button type="button" class="carousel-nav-btn" data-header-scroll-next aria-label="Next Best Sellers">
              {% render 'icon-chevron', direction: 'right' %}
            </button>
          </div>
        </div>

        <div class="horizontal-scroll-container" data-horizontal-scroll>
          <button type="button" class="scroll-edge-arrow scroll-edge-arrow--prev is-hidden" data-scroll-prev aria-label="Previous Products">
            {% render 'icon-chevron', direction: 'left' %}
          </button>

          <div class="horizontal-scroll-track not-found-bestsellers-grid" data-scroll-track>
            {% assign bs_collection = section.settings.collection %}
            {% if bs_collection == blank or bs_collection.products_count == 0 %}
              {% if collections['best-sellers'] != blank and collections['best-sellers'].products_count > 0 %}
                {% assign bs_collection = collections['best-sellers'] %}
              {% elsif collections['new-in'] != blank and collections['new-in'].products_count > 0 %}
                {% assign bs_collection = collections['new-in'] %}
              {% elsif collections.all != blank and collections.all.products_count > 0 %}
                {% assign bs_collection = collections.all %}
              {% endif %}
            {% endif %}

            {% if bs_collection != blank and bs_collection.products_count > 0 %}
              {% for product in bs_collection.products limit: 4 %}
                {% render 'product-card', product: product %}
              {% endfor %}
            {% else %}
            {% endif %}
          </div>

          <button type="button" class="scroll-edge-arrow scroll-edge-arrow--next" data-scroll-next aria-label="Next Products">
            {% render 'icon-chevron', direction: 'right' %}
          </button>
        </div>
      </div>
    </section>

    <hr style="border: none; border-top: 1px solid #ECECEC; margin: 0;">
  </div>
{% schema %}
{
  "name": "404 Main & Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "404 Title",
      "default": "404 page not found"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "404 Subtext",
      "default": "<p>Unfortunately the page you’re looking for doesn’t seem<br>to exist.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Go Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Best Sellers Section"
    },
    {
      "type": "text",
      "id": "bestsellers_heading",
      "label": "Best Sellers Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Best Sellers Collection"
    }
  ]
}
{% endschema %}
