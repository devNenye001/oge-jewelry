{% comment %}
  OGÉ Fine Jewelry - 404 Section with Intelligent Category & Bundle Deals Resolver
  If a customer lands on a category URL (e.g. /collections/rings, /collections/necklaces, etc.)
  that hasn't been manually created in Shopify Admin, this section resolves the category seamlessly
  from catalog-data.js so customers never see a broken 404 screen.
{% endcomment %}

<!-- Dynamic Category View (Shown when URL matches a category or collection) -->
<div id="category-resolved-view" style="display: none;">
  <!-- Category Header -->
  <header class="category-page-header">
    <h1 class="category-page-title" id="category-404-heading">RINGS</h1>
  </header>
  <hr class="category-divider-line">

  <!-- Subcategory Filter Tabs (Mini Navigator) -->
  <nav class="collection-category-tabs collection-nav-tabs" aria-label="Collection Categories">
    <a href="/collections/rings" class="collection-tab-btn" data-category-tab="rings">Rings</a>
    <a href="/collections/necklaces" class="collection-tab-btn" data-category-tab="necklaces">Necklaces</a>
    <a href="/collections/bracelets" class="collection-tab-btn" data-category-tab="bracelets">Bracelets</a>
    <a href="/collections/earrings" class="collection-tab-btn" data-category-tab="earrings">Earrings</a>
  </nav>

  <!-- UTILITY BAR (FILTER & SORT + DENSITY SWITCHER) -->
  <div class="collection-utility-bar">
    <div class="collection-utility-left" style="position: relative;">
      <button type="button" class="filter-sort-btn" id="filter-sort-toggle-404" aria-expanded="false" aria-controls="category-filter-dropdown-404">
        Filter &amp; Sort
      </button>
      <div class="filter-dropdown-menu" id="category-filter-dropdown-404" role="menu">
        <button type="button" class="filter-option-btn is-active" data-sort="featured">Featured</button>
        <button type="button" class="filter-option-btn" data-sort="price-low">Price: Low to High</button>
        <button type="button" class="filter-option-btn" data-sort="price-high">Price: High to Low</button>
        <button type="button" class="filter-option-btn" data-sort="newest">New Arrivals</button>
      </div>
    </div>
    <div class="collection-utility-right">
      <div class="grid-density-switcher" role="group" aria-label="Grid density switcher">
        <button type="button" class="grid-density-btn" data-cols="1" aria-label="1 column view" title="1 Column">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="12" height="12"/></svg>
        </button>
        <button type="button" class="grid-density-btn" data-cols="2" aria-label="2 columns view" title="2 Columns">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="5" height="12"/><rect x="9" y="2" width="5" height="12"/></svg>
        </button>
        <button type="button" class="grid-density-btn is-active" data-cols="4" aria-label="4 columns view" title="4 Columns">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="5" height="5"/><rect x="9" y="2" width="5" height="5"/><rect x="2" y="9" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Product Catalog -->
  <main class="collection-catalog-wrap">
    <div class="collection-products-grid grid--4-col" id="category-404-grid">
      <!-- Populated via OGE_HELPERS.getProductsByCategory -->
    </div>
  </main>
  <hr class="category-divider-line">
</div>

<!-- Dynamic Bundle Deals View (Shown when URL matches bundle-deals) -->
<div id="bundle-resolved-view" style="display: none;">
  <main role="main">
    <div class="bundle-deals-wrapper">
      <h1 class="bundle-deals-heading">BUNDLE DEALS</h1>
      <div class="bundle-deals-grid">
        <div class="bundle-card">
          <img src="{{ 'sales1.jpg' | asset_url }}" alt="Bundle deal - 2 Ala Rings for $150" class="bundle-card__img" loading="eager" width="800" height="1000">
          <div class="bundle-card__overlay">
            <span class="bundle-card__eyebrow">Bundle deal</span>
            <h2 class="bundle-card__title">2 ALA RINGS FOR $150</h2>
            <a href="/collections/rings" class="bundle-card__link">Shop Now</a>
          </div>
        </div>
        <div class="bundle-card">
          <img src="{{ 'sales2.jpg' | asset_url }}" alt="Jewelry Set Offer - Valor Earring + Necklace for $200" class="bundle-card__img" loading="eager" width="800" height="1000">
          <div class="bundle-card__overlay">
            <span class="bundle-card__eyebrow">Jewelry Set Offer</span>
            <h2 class="bundle-card__title">VALOR EARRING +<br>NECKLACE FOR $200</h2>
            <a href="/collections/necklaces" class="bundle-card__link">Shop Now</a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <hr class="category-divider-line">
</div>

<!-- Standard 404 View (Only shown when the URL truly cannot be matched to jewelry or pages) -->
<div id="not-found-standard-view">
  <section class="not-found-section" {{ section.shopify_attributes }}>
    <div class="page-container">
      <div class="not-found-content">
        <h1 class="not-found-title">{{ section.settings.title | default: '404 page not found' }}</h1>
        <p class="not-found-desc">
          {{ section.settings.subtext | default: 'Unfortunately the page you’re looking for doesn’t seem<br>to exist.' }}
        </p>
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="not-found-btn">
          {{ section.settings.button_text | default: 'Go Home' }}
        </a>
      </div>
    </div>
  </section>

  <!-- Best Sellers Section on 404 (Straight Horizontal Row) -->
  <section class="featured-collection-section" style="padding: 20px 0 60px; background-color: #FFFFFF;" id="best-sellers">
    <div class="page-container">
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.bestsellers_heading | default: 'BEST SELLERS' }}</h2>
        <div class="carousel-nav-btns">
          <button type="button" class="carousel-nav-btn" data-header-scroll-prev aria-label="Previous Best Sellers">
            {% render 'icon-chevron', direction: 'left' %}
          </button>
          <button type="button" class="carousel-nav-btn" data-header-scroll-next aria-label="Next Best Sellers">
            {% render 'icon-chevron', direction: 'right' %}
          </button>
        </div>
      </div>

      <div class="horizontal-scroll-container" data-horizontal-scroll>
        <button type="button" class="scroll-edge-arrow scroll-edge-arrow--prev is-hidden" data-scroll-prev aria-label="Previous Products">
          {% render 'icon-chevron', direction: 'left' %}
        </button>

        <div class="horizontal-scroll-track not-found-bestsellers-grid" data-scroll-track id="not-found-bestsellers-track">
          {% assign bs_collection = section.settings.collection %}
          {% if bs_collection == blank or bs_collection.products_count == 0 %}
            {% if collections['bestseller'] != blank and collections['bestseller'].products_count > 0 %}
              {% assign bs_collection = collections['bestseller'] %}
            {% elsif collections['new-arrival'] != blank and collections['new-arrival'].products_count > 0 %}
              {% assign bs_collection = collections['new-arrival'] %}
            {% elsif collections.all != blank and collections.all.products_count > 0 %}
              {% assign bs_collection = collections.all %}
            {% endif %}
          {% endif %}

          {% if bs_collection != blank and bs_collection.products_count > 0 %}
            {% for product in bs_collection.products limit: 4 %}
              {% render 'product-card', product: product %}
            {% endfor %}
          {% endif %}
        </div>

        <button type="button" class="scroll-edge-arrow scroll-edge-arrow--next" data-scroll-next aria-label="Next Products">
          {% render 'icon-chevron', direction: 'right' %}
        </button>
      </div>
    </div>
  </section>

  <hr style="border: none; border-top: 1px solid #ECECEC; margin: 0;">
</div>

<script>
  (function() {
    function resolve404Route() {
      const path = (window.location.pathname || '').toLowerCase();
      const params = new URLSearchParams(window.location.search);
      const queryType = (params.get('type') || params.get('category') || '').toLowerCase();

      const standardView = document.getElementById('not-found-standard-view');
      const categoryView = document.getElementById('category-resolved-view');
      const bundleView = document.getElementById('bundle-resolved-view');

      // 1. Check for Bundle Deals
      if (path.includes('bundle') || queryType.includes('bundle')) {
        if (standardView) standardView.style.display = 'none';
        if (bundleView) bundleView.style.display = 'block';
        document.title = 'Bundle Deals — OGÉ Fine Jewelry';
        return;
      }

      // 2. Check for Category Match
      let matchedCategory = null;
      if (path.includes('ring') || queryType.includes('ring')) matchedCategory = 'rings';
      else if (path.includes('necklace') || queryType.includes('necklace')) matchedCategory = 'necklaces';
      else if (path.includes('bracelet') || queryType.includes('bracelet')) matchedCategory = 'bracelets';
      else if (path.includes('earring') || queryType.includes('earring')) matchedCategory = 'earrings';
      else if (path.includes('fine') || queryType.includes('fine')) matchedCategory = 'fine-jewelry';
      else if (path.includes('men') || queryType.includes('men')) matchedCategory = 'men';
      else if (path.includes('new') || queryType.includes('new')) matchedCategory = 'new';
      else if (path.includes('category') || path.includes('shop') || path.includes('all-jewelry') || path.includes('jewelries') || queryType === 'all') {
        matchedCategory = queryType || 'all';
      }

      if (matchedCategory && window.OGE_HELPERS && window.OGE_CATALOG) {
        if (standardView) standardView.style.display = 'none';
        if (categoryView) categoryView.style.display = 'block';

        const titles = {
          'earrings': 'EARRINGS',
          'necklaces': 'NECKLACES',
          'bracelets': 'BRACELETS',
          'rings': 'RINGS',
          'men': 'MEN',
          'fine-jewelry': 'FINE JEWELRY',
          'new': 'NEW IN',
          'all': 'ALL JEWELRY'
        };
        const titleText = titles[matchedCategory] || matchedCategory.toUpperCase();
        const headingEl = document.getElementById('category-404-heading');
        if (headingEl) headingEl.textContent = titleText;
        document.title = `${titleText} — OGÉ Fine Jewelry`;

        // Update active tab highlight
        document.querySelectorAll('#category-resolved-view .collection-tab-btn').forEach(tab => {
          const tabKey = (tab.getAttribute('data-category-tab') || tab.getAttribute('href') || '').toLowerCase();
          if (tabKey.includes(matchedCategory.replace(/s$/, ''))) {
            tab.classList.add('is-active');
          } else {
            tab.classList.remove('is-active');
          }
        });

        const grid = document.getElementById('category-404-grid');
        if (!grid) return;

        let items = window.OGE_HELPERS.getProductsByCategory(matchedCategory);
        if (!items || items.length === 0) items = window.OGE_CATALOG;

        function renderGrid(products) {
          grid.innerHTML = products.map((p, idx) => window.OGE_HELPERS.renderProductCard(p, idx)).join('');
          if (window.OGE_CURRENCY && typeof window.OGE_CURRENCY.updateDOM === 'function') {
            window.OGE_CURRENCY.updateDOM();
          }
        }

        renderGrid(items);

        // Density Switcher
        const densityBtns = categoryView.querySelectorAll('.grid-density-btn');
        densityBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            densityBtns.forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            const cols = btn.getAttribute('data-cols') || '4';
            grid.classList.remove('grid--1-col', 'grid--2-col', 'grid--4-col');
            grid.classList.add(`grid--${cols}-col`);
          });
        });

        // Filter & Sort
        const filterToggle = document.getElementById('filter-sort-toggle-404');
        const filterDropdown = document.getElementById('category-filter-dropdown-404');
        if (filterToggle && filterDropdown) {
          filterToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = filterDropdown.classList.toggle('is-active');
            filterToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });

          document.addEventListener('click', () => {
            filterDropdown.classList.remove('is-active');
            filterToggle.setAttribute('aria-expanded', 'false');
          });

          filterDropdown.querySelectorAll('.filter-option-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              filterDropdown.querySelectorAll('.filter-option-btn').forEach(b => b.classList.remove('is-active'));
              btn.classList.add('is-active');
              const sort = btn.getAttribute('data-sort');
              let sorted = [...items];
              if (sort === 'price-low') sorted.sort((a, b) => a.price - b.price);
              else if (sort === 'price-high') sorted.sort((a, b) => b.price - a.price);
              else if (sort === 'newest') sorted.sort((a, b) => (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0));
              renderGrid(sorted);
              filterDropdown.classList.remove('is-active');
              filterToggle.setAttribute('aria-expanded', 'false');
            });
          });
        }
        return;
      }

      // 3. Fallback: If truly 404 and best sellers track is empty, populate from catalog
      const bsTrack = document.getElementById('not-found-bestsellers-track');
      if (bsTrack && bsTrack.children.length === 0 && window.OGE_CATALOG && window.OGE_HELPERS) {
        const top4 = window.OGE_CATALOG.slice(0, 4);
        bsTrack.innerHTML = top4.map((p, idx) => window.OGE_HELPERS.renderProductCard(p, idx)).join('');
        if (window.OGE_CURRENCY && typeof window.OGE_CURRENCY.updateDOM === 'function') {
          window.OGE_CURRENCY.updateDOM();
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', resolve404Route);
    } else {
      resolve404Route();
    }
  })();
</script>

{% schema %}
{
  "name": "404 Main & Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "404 Title",
      "default": "404 page not found"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "404 Subtext",
      "default": "<p>Unfortunately the page you’re looking for doesn’t seem<br>to exist.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Go Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Best Sellers Section"
    },
    {
      "type": "text",
      "id": "bestsellers_heading",
      "label": "Best Sellers Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Best Sellers Collection"
    }
  ]
}
{% endschema %}
