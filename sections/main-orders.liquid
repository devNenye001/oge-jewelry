{% comment %}
  OGÉ Fine Jewelry - Main Orders Section
  Active Orders & Empty State with Best Seller Recommendations
{% endcomment %}

<section class="orders-page-section" data-section-id="{{ section.id }}" data-section-type="orders">
  <div class="orders-container">

    <!-- Top Navigation Link: Back to Overview -->
    <a href="{{ routes.account_url | default: '/account' }}" class="profile-back-link" aria-label="Back to Account Overview">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>{{ section.settings.back_text | default: 'Back to Overview' }}</span>
    </a>

    <!-- Page Heading -->
    <h1 class="profile-page-title">{{ page.title | default: 'ORDERS' }}</h1>
    <hr class="profile-title-divider">

    <!-- Empty State Container -->
    <div class="orders-empty-state">
      <h2 class="orders-empty-title">{{ section.settings.empty_title | default: 'No orders have been made yet!' }}</h2>
      <p class="orders-empty-subtitle">{{ section.settings.empty_subtitle | default: 'When you place an order, its details, shipment tracking, and receipts will be displayed here.' }}</p>
      <a href="{{ section.settings.shop_btn_link | default: routes.all_products_collection_url }}" class="btn orders-shop-btn">
        {{ section.settings.shop_btn_label | default: 'Start Shopping' }}
      </a>
    </div>

    <!-- Recommendations Section -->
    <section class="wishlist-recommendations" aria-label="Recommended Best Sellers">
      <div class="account-recommendations__header">
        <h2 class="account-recommendations__title">{{ section.settings.rec_title | default: 'YOU MAY ALSO LIKE' }}</h2>
        <div class="account-recommendations__controls">
          <button type="button" class="account-nav-arrow-btn" aria-label="Previous recommendation" id="btn-orders-rec-prev">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="account-nav-arrow-btn" aria-label="Next recommendation" id="btn-orders-rec-next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="account-product-grid" id="orders-rec-grid">
        {% assign rec_col = collections['all'] %}
        {% if rec_col != blank and rec_col.products.size > 0 %}
          {% for rec_product in rec_col.products limit: 4 %}
            <article class="account-product-card">
              <div class="account-product-card__image-wrap">
                <button type="button" class="account-product-card__wishlist" data-wishlist-btn data-product-handle="{{ rec_product.handle }}" aria-label="Add {{ rec_product.title | escape }} to WishList">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" width="18" height="18"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
                {% if rec_product.featured_image %}
                  <img src="{{ rec_product.featured_image | image_url: width: 400, height: 460 }}" alt="{{ rec_product.featured_image.alt | default: rec_product.title | escape }}" class="account-product-card__image" loading="lazy" width="400" height="460">
                {% else %}
                  <img src="{{ 'product5.png' | asset_url }}" alt="{{ rec_product.title | escape }}" class="account-product-card__image" loading="lazy" width="400" height="460">
                {% endif %}
                <button type="button" class="account-product-card__add-btn" data-quick-add data-product-id="{{ rec_product.selected_or_first_available_variant.id }}" data-product-title="{{ rec_product.title | escape }}" data-product-price="{{ rec_product.price | money }}" data-product-img="{{ rec_product.featured_image | image_url: width: 400 }}" aria-label="Add {{ rec_product.title | escape }} to Bag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
              </div>
              <div class="account-product-card__info">
                <h3 class="account-product-card__title"><a href="{{ rec_product.url }}">{{ rec_product.title }}</a></h3>
                <p class="account-product-card__variant">{{ rec_product.metafields.custom.metal | default: rec_product.vendor | default: 'Fine Jewelry' }}</p>
                <p class="account-product-card__price">
                  <span>{{ rec_product.price | money }}</span>
                  {% if rec_product.compare_at_price > rec_product.price %}
                    <span class="account-product-card__price-compare">{{ rec_product.compare_at_price | money }}</span>
                  {% endif %}
                </p>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </section>

  </div>
</section>

{% schema %}
{
  "name": "Orders Page",
  "settings": [
    {
      "type": "text",
      "id": "back_text",
      "label": "Back Link Text",
      "default": "Back to Overview"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty Title",
      "default": "No orders have been made yet!"
    },
    {
      "type": "textarea",
      "id": "empty_subtitle",
      "label": "Empty Subtitle",
      "default": "When you place an order, its details, shipment tracking, and receipts will be displayed here."
    },
    {
      "type": "text",
      "id": "shop_btn_label",
      "label": "Shop Button Label",
      "default": "Start Shopping"
    },
    {
      "type": "url",
      "id": "shop_btn_link",
      "label": "Shop Button Link"
    },
    {
      "type": "text",
      "id": "rec_title",
      "label": "Recommendations Title",
      "default": "YOU MAY ALSO LIKE"
    }
  ]
}
{% endschema %}
