<section class="testimonials-section" style="padding: 70px 0; background-color: #FFFFFF;" {{ section.shopify_attributes }}>
  <div class="page-container">
    <div class="section-header">
      <h2 class="section-header__title">{{ section.settings.heading | default: 'WORN. LOVED. REMEMBERED.' }}</h2>
      <div class="carousel-nav-btns">
        <button type="button" class="carousel-nav-btn" data-header-scroll-prev aria-label="Previous Reviews">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="carousel-nav-btn" data-header-scroll-next aria-label="Next Reviews">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    <div class="horizontal-scroll-container testimonials-scroll-container" data-horizontal-scroll>
      <div class="testimonials-track horizontal-scroll-track testimonials-grid" data-scroll-track>
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div class="testimonial-card" {{ block.shopify_attributes }}>
              <div class="testimonial-stars" aria-label="4 out of 5 stars">★★★★</div>
              <p class="testimonial-text">{{ block.settings.quote }}</p>
              <div class="testimonial-author">— {{ block.settings.author }}</div>
            </div>
          {% endfor %}
        {% else %}
          <!-- Review 1: Alicia R. -->
          <div class="testimonial-card">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p class="testimonial-text">
              “The craftsmanship is unbelievable. Every detail on this necklace is stunning – I’ve never felt more elegant. I wore it for a dinner party and got compliments all night. It feels like wearing a piece of art.”
            </p>
            <div class="testimonial-author">— Alicia R.</div>
          </div>

          <!-- Review 2: Jasmine L. -->
          <div class="testimonial-card">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p class="testimonial-text">
              “This ring is everything I hoped for – edgy, sleek, and bold. It's now my go-to accessory to elevate even the simplest outfit. It fits perfectly and feels super high-end.”
            </p>
            <div class="testimonial-author">— Jasmine L.</div>
          </div>

          <!-- Review 3: Rhea C. -->
          <div class="testimonial-card">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p class="testimonial-text">
              “The moment I saw this green ring, I knew I needed it. The color is mesmerizing and it catches the light in the most beautiful way. It’s become my signature piece!”
            </p>
            <div class="testimonial-author">— Rhea C.</div>
          </div>

          <!-- Review 4: Leila S. -->
          <div class="testimonial-card">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p class="testimonial-text">
              “Delicate, modern, and meaningful. I bought this bracelet as a reminder to trust my instincts. The design is minimal, but powerful – I wear it every day.”
            </p>
            <div class="testimonial-author">— Leila S.</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WORN. LOVED. REMEMBERED."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Absolutely beautiful. The piece feels even more stunning in person."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Amara O."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
