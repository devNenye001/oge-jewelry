<section class="account-hero-banner" aria-label="Account Overview Banner">
  {% if section.settings.banner_image != blank %}
    {{ section.settings.banner_image | image_url: width: 1920 | image_tag: class: 'account-hero-banner__img', loading: 'eager' }}
  {% else %}
    <img src="{{ 'account-overview-banner.jpg' | asset_url }}" alt="OGÉ Account Overview" class="account-hero-banner__img" loading="eager" width="1920" height="600">
  {% endif %}
  <div class="account-hero-banner__overlay">
    <h1 class="account-hero-banner__title">{{ section.settings.title | default: 'ACCOUNT OVERVIEW' }}</h1>
  </div>
</section>

<main id="MainContent" role="main">
  <section class="account-dashboard-section">
    <div class="account-dashboard-container">

      <!-- Left Column: User Welcome & Navigation Sidebar -->
      <aside class="account-sidebar" aria-label="Account Navigation">
        <div class="account-sidebar__welcome">
          <h2 class="account-sidebar__name">Welcome {{ customer.first_name | default: 'Ndubuisi' }}</h2>
          <p class="account-sidebar__subtitle">Your account details, all in one place.</p>
        </div>

        <!-- Desktop Sidebar Navigation -->
        <nav class="account-sidebar__nav account-sidebar__nav--desktop" aria-label="Account Menu Desktop">
          <a href="/collections/all?view=orders" class="account-sidebar__link">
            <span>Orders</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
          <a href="/collections/all?view=wishlist" class="account-sidebar__link">
            <span>Wishlist</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
          <a href="/collections/all?view=profile" class="account-sidebar__link">
            <span>Profile</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
          <a href="/collections/all?view=login" class="account-sidebar__link account-sidebar__link--signout">
            <span>Sign out</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
        </nav>
      </aside>

      <!-- Right Column: Account Overview Cards + Mobile Nav + Recommendations -->
      <div class="account-main">
        
        <!-- Top Row: Orders & Returns Overview Cards -->
        <div class="account-overview-grid">
          <!-- Card 1: Orders -->
          <div class="account-card">
            <h3 class="account-card__title">Orders</h3>
            <div class="account-card__body">
              {% if customer.orders_count > 0 %}
                <p class="account-card__empty-text">You have {{ customer.orders_count }} past order(s).</p>
                <a href="/collections/all?view=orders" class="account-card__action-link">View Orders</a>
              {% else %}
                <p class="account-card__empty-text">No orders have been made yet!</p>
                <a href="/collections/all?view=orders" class="account-card__action-link">Start Shopping</a>
              {% endif %}
            </div>
          </div>

          <!-- Card 2: Make a Return -->
          <div class="account-card">
            <h3 class="account-card__title">Make a Return</h3>
            <div class="account-card__body">
              <p class="account-card__empty-text">Want to send something back?</p>
              <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}" class="account-card__action-link">Make a return</a>
            </div>
          </div>
        </div>

        <!-- Mobile-Only Sidebar Navigation (Appears directly after Overview Cards on Responsive View) -->
        <nav class="account-sidebar__nav account-sidebar__nav--mobile" aria-label="Account Menu Mobile">
          <a href="/collections/all?view=orders" class="account-sidebar__link">
            <span>Orders</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
          <a href="/collections/all?view=wishlist" class="account-sidebar__link">
            <span>Wishlist</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
          <a href="/collections/all?view=profile" class="account-sidebar__link">
            <span>Profile</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
          <a href="/collections/all?view=login" class="account-sidebar__link account-sidebar__link--signout">
            <span>Sign out</span>
            {% render 'icon-chevron', direction: 'right' %}
          </a>
        </nav>

        <!-- Bottom Section: YOU MAY ALSO LIKE -->
        <section class="account-recommendations" aria-label="Recommended Products">
          <div class="account-recommendations__header">
            <h2 class="account-recommendations__title">{{ section.settings.recommendations_title | default: 'YOU MAY ALSO LIKE' }}</h2>
            <div class="account-recommendations__controls">
              <button type="button" class="account-nav-arrow-btn" aria-label="Previous recommended piece" id="btn-account-rec-prev">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <button type="button" class="account-nav-arrow-btn" aria-label="Next recommended piece" id="btn-account-rec-next">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>
          </div>

          <div class="account-product-grid" id="account-rec-grid">
            {% assign rec_col = collections['all'] %}
            {% if rec_col != blank and rec_col.products.size > 0 %}
              {% for rec_product in rec_col.products limit: 8 %}
                {% render 'product-card', product: rec_product %}
              {% endfor %}
            {% endif %}
          </div>
        </section>

        <script>
          (function() {
            var grid = document.getElementById('account-rec-grid');
            var prev = document.getElementById('btn-account-rec-prev');
            var next = document.getElementById('btn-account-rec-next');
            if (grid && prev && next) {
              prev.addEventListener('click', function(e) {
                e.preventDefault();
                var card = grid.querySelector('.product-card');
                var amount = card ? (card.offsetWidth + 16) : 260;
                grid.scrollBy({ left: -amount, behavior: 'smooth' });
              });
              next.addEventListener('click', function(e) {
                e.preventDefault();
                var card = grid.querySelector('.product-card');
                var amount = card ? (card.offsetWidth + 16) : 260;
                grid.scrollBy({ left: amount, behavior: 'smooth' });
              });
            }
          })();
        </script>

      </div>
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Customer Account",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ACCOUNT OVERVIEW"
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Recommendations Heading",
      "default": "YOU MAY ALSO LIKE"
    }
  ]
}
{% endschema %}
