<header class="site-header{% if template.name == 'index' %} site-header--transparent{% else %} site-header--standard{% endif %}" data-site-header {{ section.shopify_attributes }}>
  <div class="site-header__inner">

    <!-- ====================================================================
         LEFT AREA: Hamburger + (Mobile Search)
         ==================================================================== -->
    <div class="site-header__left">
      <!-- Hamburger Toggle Button (Desktop & Mobile) -->
      <button 
        type="button" 
        class="hamburger-btn" 
        data-sidebar-open 
        aria-label="{{ 'header.menu' | t }}"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- Search Icon (Mobile Only - Matching Figma Screen 1 Mobile) -->
      <a href="{{ routes.search_url }}" class="header-icon-btn mobile-only" data-search-open aria-label="{{ 'header.search' | t }}">
        {% render 'icon-search' %}
      </a>
    </div>

    <!-- ====================================================================
         CENTER AREA: Brand Logo (06é / OGÉ)
         ==================================================================== -->
    <div class="site-header__center">
      <a href="{{ routes.root_url }}" class="site-logo">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: 'site-logo__image', alt: shop.name }}
        {% else %}
          <img 
            src="{{ 'logo1.png' | asset_url }}" 
            alt="{{ shop.name | default: '06é' }}" 
            class="site-logo__image site-logo__image--white"
            width="{{ section.settings.logo_width | default: 140 }}"
            height="52"
            style="height: 52px; width: auto; max-height: 58px; object-fit: contain;"
          >
          <img 
            src="{{ 'logo2.png' | asset_url }}" 
            alt="{{ shop.name | default: '06é' }}" 
            class="site-logo__image site-logo__image--black"
            width="{{ section.settings.logo_width | default: 140 }}"
            height="52"
            style="height: 52px; width: auto; max-height: 58px; object-fit: contain;"
          >
        {% endif %}
      </a>
    </div>

    <!-- ====================================================================
         RIGHT AREA: Icons (Search, Wishlist, Account, Cart)
         ==================================================================== -->
    <div class="site-header__right">
      <!-- Search Icon (Desktop Only) -->
      <a href="{{ routes.search_url }}" class="header-icon-btn desktop-only" data-search-open id="btn-search" aria-label="{{ 'header.search' | t }}">
        {% render 'icon-search' %}
      </a>

      <!-- Wishlist Heart Icon (Desktop & Mobile) -->
      {% assign header_wishlist_url = pages['wishlist'].url %}
      {% if header_wishlist_url == blank or header_wishlist_url == '' %}
        {% assign header_wishlist_url = routes.all_products_collection_url | append: '?view=wishlist' %}
      {% endif %}
      <a href="{{ header_wishlist_url }}" class="header-icon-btn" aria-label="{{ 'header.wishlist' | t }}">
        {% render 'icon-heart' %}
        <span class="header-icon-btn__badge" data-wishlist-count style="display: none;">0</span>
      </a>
      <script>
        (function() {
          try {
            var w = JSON.parse(localStorage.getItem('oge_wishlist') || '[]');
            if (w && w.length > 0) {
              var badge = document.querySelector('[data-wishlist-count]');
              if (badge) {
                badge.textContent = w.length;
                badge.style.display = 'flex';
              }
            }
          } catch(e) {}
        })();
      </script>

      <!-- Customer Account Icon: Directs to account overview -->
      <a href="{{ routes.all_products_collection_url }}?view=account" class="header-icon-btn" aria-label="{{ 'header.account' | t | default: 'Account' }}">
        {% render 'icon-account' %}
      </a>

      <!-- Shopping Bag Cart Icon (Desktop & Mobile) -->
      <a
        href="{{ routes.cart_url }}"
        class="header-icon-btn"
        data-cart-drawer-open
        id="btn-cart"
        aria-label="{{ 'header.cart' | t }}"
      >
        {% render 'icon-cart' %}
        {% if cart.item_count > 0 %}
          <span class="header-icon-btn__badge" data-cart-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        {% else %}
          <span class="header-icon-btn__badge" data-cart-count style="display: none;"></span>
        {% endif %}
      </a>
    </div>

  </div>
</header>

<!-- Sidebar Drawer Component -->
{% render 'sidebar-drawer', section: section, menu: section.settings.menu %}

<!-- Cart Drawer Component -->
{% render 'cart-drawer' %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 250,
      "step": 5,
      "default": 135
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky Header",
      "default": true
    },
    {
      "type": "header",
      "content": "Sidebar Drawer Settings"
    },
    {
      "type": "link_list",
      "id": "sidebar_menu",
      "label": "Sidebar Custom Menu (Optional)",
      "info": "Choose a custom menu from Navigation, or leave blank to use the standard OGÉ navigation."
    },
    {
      "type": "header",
      "content": "Sidebar Jewelry Submenu"
    },
    {
      "type": "link_list",
      "id": "sidebar_jewelry_menu",
      "label": "Jewelry Submenu Links (Optional)",
      "info": "Select a menu or leave empty for default category links (Rings, Earrings, Necklaces, Bracelets)."
    },
    {
      "type": "image_picker",
      "id": "sidebar_jewelry_img",
      "label": "Jewelry Featured Card Image"
    },
    {
      "type": "text",
      "id": "sidebar_jewelry_title",
      "label": "Jewelry Featured Card Title",
      "default": "Necklaces"
    },
    {
      "type": "url",
      "id": "sidebar_jewelry_link",
      "label": "Jewelry Featured Card Link"
    },
    {
      "type": "header",
      "content": "Sidebar Collections Submenu"
    },
    {
      "type": "link_list",
      "id": "sidebar_collections_menu",
      "label": "Collections Submenu Links (Optional)",
      "info": "Select a menu or leave empty for default collection links (Rebirth, Boundaries, Victorious, Self Romance)."
    },
    {
      "type": "image_picker",
      "id": "sidebar_collections_img",
      "label": "Collections Featured Card Image"
    },
    {
      "type": "text",
      "id": "sidebar_collections_title",
      "label": "Collections Featured Card Title",
      "default": "Self Romance"
    },
    {
      "type": "url",
      "id": "sidebar_collections_link",
      "label": "Collections Featured Card Link"
    },
    {
      "type": "header",
      "content": "Sidebar Footer & Utility"
    },
    {
      "type": "checkbox",
      "id": "sidebar_show_account",
      "label": "Show Account / Login Links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sidebar_show_wishlist",
      "label": "Show Wishlist Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sidebar_show_localization",
      "label": "Show Country / Language Selector",
      "default": true
    }
  ]
}
{% endschema %}

