<section class="main-cart-section" style="padding: 60px 0;">
  <div class="page-container" style="max-width: 800px;">
    <h1 class="heading-section" style="text-align: center; margin-bottom: 40px;">{{ 'cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form" data-cart-page-form>
        <div class="cart-page-items" data-cart-page-items style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px;">
          {% for item in cart.items %}
            <div class="cart-page-item" data-item-key="{{ item.key }}" style="display: grid; grid-template-columns: 80px 1fr auto; gap: 20px; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 20px;">
              <div style="aspect-ratio: 1/1; background: #F9F9F9; border-radius: 4px; overflow: hidden;">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'cart-item__image' }}
                {% endif %}
              </div>
              <div>
                <a href="{{ item.url }}" style="font-weight: 500; font-size: 1rem; display: block; margin-bottom: 4px; color: inherit; text-decoration: none;">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <div style="color: var(--color-text-muted); font-size: 0.8125rem; margin-bottom: 4px;">{{ item.variant.title }}</div>
                {% endunless %}
                {% if item.properties.size > 0 %}
                  <div class="cart-item__properties" style="font-size: 0.75rem; color: var(--color-text-muted); margin-bottom: 4px;">
                    {% for property in item.properties %}
                      {% assign first_char = property.first | slice: 0 %}
                      {% unless property.last == blank or first_char == '_' %}
                        <div><strong>{{ property.first }}:</strong> {{ property.last }}</div>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}
                <div style="color: var(--color-text-muted); font-size: 0.875rem;">{{ item.final_line_price | money }}</div>
              </div>
              <div style="display: flex; align-items: center; gap: 14px; justify-content: flex-end;">
                <div class="cart-item__qty-selector" style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--color-border-dark); border-radius: 4px; padding: 4px 8px;">
                  <button type="button" class="cart-item__qty-btn" data-cart-page-minus="{{ item.key }}" aria-label="Decrease quantity" style="background: none; border: none; cursor: pointer; padding: 2px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  </button>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" data-cart-page-qty="{{ item.key }}" style="width: 40px; border: none; text-align: center; font-size: 0.875rem; font-weight: 500; -moz-appearance: textfield;" aria-label="Quantity">
                  <button type="button" class="cart-item__qty-btn" data-cart-page-plus="{{ item.key }}" aria-label="Increase quantity" style="background: none; border: none; cursor: pointer; padding: 2px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  </button>
                </div>
                <button type="button" class="cart-item__action-btn" data-cart-page-remove="{{ item.key }}" aria-label="Remove item" style="background: none; border: none; cursor: pointer; color: var(--color-text-muted); padding: 4px;">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" width="18" height="18">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </div>
            </div>
          {% endfor %}
        </div>

        <div style="border-top: 1px solid var(--color-border); padding-top: 24px; text-align: right;">
          <div style="font-size: 1.25rem; font-weight: 600; margin-bottom: 8px;">
            <span>{{ 'cart.subtotal' | t }}:</span>
            <span data-cart-page-subtotal>{{ cart.total_price | money }}</span>
          </div>
          <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-bottom: 24px;">{{ 'cart.taxes_and_shipping_policy_at_checkout_html' | t }}</p>
          <div style="display: flex; justify-content: flex-end; gap: 16px;">
            <button type="submit" name="update" class="btn btn-secondary">Update Bag</button>
            <button type="submit" name="checkout" class="btn btn-primary">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {% else %}
      <div class="cart-page-empty" data-cart-page-empty style="text-align: center; padding: 60px 0;">
        <p style="font-size: 1.125rem; color: var(--color-text-muted); margin-bottom: 24px;">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-primary">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Main"
}
{% endschema %}
