{% comment %}
  OGÉ Fine Jewelry - Necklaces Category Section
  Allows independent heading, banner, and settings in Shopify Theme Customizer.
{% endcomment %}

{% assign current_coll = section.settings.collection | default: collection %}
{% if current_coll == blank or current_coll.products.size == 0 %}
  {% if collections['necklaces'] != blank and collections['necklaces'].products.size > 0 %}
    {% assign current_coll = collections['necklaces'] %}
  {% endif %}
{% endif %}

{% assign page_title_text = section.settings.heading %}
{% if page_title_text == blank %}
  {% assign page_title_text = current_coll.title | default: 'NECKLACES' %}
{% endif %}

{% if section.settings.show_banner %}
  <section class="collection-hero-banner" id="necklaces-hero-banner" {{ section.shopify_attributes }}>
    {% if section.settings.banner_image != blank %}
      {{ section.settings.banner_image | image_url: width: 2000 | image_tag: class: 'collection-hero-banner__img', loading: 'eager', alt: page_title_text }}
    {% elsif current_coll.image != blank %}
      {{ current_coll.image | image_url: width: 2000 | image_tag: class: 'collection-hero-banner__img', loading: 'eager', alt: page_title_text }}
    {% else %}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="{{ page_title_text }}" class="collection-hero-banner__img" loading="eager" width="1920" height="400">
    {% endif %}
    <div class="collection-hero-banner__overlay">
      <div class="collection-hero__content">
        <h1 class="collection-hero-banner__title">{{ page_title_text }}</h1>
        {% if section.settings.banner_desc != blank %}
          <p class="collection-hero-banner__desc">{{ section.settings.banner_desc }}</p>
        {% endif %}
      </div>
    </div>
  </section>
{% else %}
  <header class="category-page-header" {{ section.shopify_attributes }}>
    <h1 class="category-page-title" id="necklaces-page-heading">{{ page_title_text | upcase }}</h1>
  </header>
  <hr class="category-divider-line">
{% endif %}

<!-- UTILITY BAR (FILTER & SORT + DENSITY SWITCHER) -->
<div class="collection-utility-bar">
  <div class="collection-utility-left" style="position: relative;">
    <button type="button" class="filter-sort-btn" id="filter-sort-toggle-necklaces" aria-expanded="false" aria-controls="collection-filter-dropdown-necklaces">
      Filter &amp; Sort
    </button>
    <div class="filter-dropdown-menu" id="collection-filter-dropdown-necklaces" role="menu">
      <button type="button" class="filter-option-btn is-active" data-sort="featured">Featured</button>
      <button type="button" class="filter-option-btn" data-sort="price-low">Price: Low to High</button>
      <button type="button" class="filter-option-btn" data-sort="price-high">Price: High to Low</button>
      <button type="button" class="filter-option-btn" data-sort="newest">New Arrivals</button>
    </div>
  </div>
  <div class="collection-utility-right">
    <div class="grid-density-switcher" role="group" aria-label="Grid density switcher">
      <button type="button" class="grid-density-btn" data-cols="1" aria-label="1 column view" title="1 Column">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="12" height="12"/></svg>
      </button>
      <button type="button" class="grid-density-btn" data-cols="2" aria-label="2 columns view" title="2 Columns">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="5" height="12"/><rect x="9" y="2" width="5" height="12"/></svg>
      </button>
      <button type="button" class="grid-density-btn is-active" data-cols="4" aria-label="4 columns view" title="4 Columns">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="5" height="5"/><rect x="9" y="2" width="5" height="5"/><rect x="2" y="9" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Product Catalog -->
<main class="collection-catalog-wrap" id="MainContent">
  {% assign products_per_page = section.settings.products_per_page | default: 24 %}
  {% paginate current_coll.products by products_per_page %}
    <div class="collection-products-grid grid--4-col" id="necklaces-grid">
      {% if current_coll.products.size > 0 %}
        {% for product in current_coll.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {%- comment -%} Search all products for necklaces tags/title fallback {%- endcomment -%}
        {% assign necklace_count = 0 %}
        {% for product in collections.all.products %}
          {% assign p_title = product.title | downcase %}
          {% assign p_type = product.type | downcase %}
          {% if p_title contains 'necklace' or p_type contains 'necklace' or product.tags contains 'necklace' or product.tags contains 'necklaces' %}
            {% render 'product-card', product: product %}
            {% assign necklace_count = necklace_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if necklace_count == 0 %}
          <div class="wishlist-empty-box collection-empty-state" id="necklaces-empty-placeholder" style="grid-column: 1 / -1; padding: 60px 20px; text-align: center;">
            <h2 class="wishlist-empty-title">Loading Necklaces...</h2>
            <p class="wishlist-empty-desc">Discovering handcrafted necklaces sculpted in 18k solid gold.</p>
          </div>
        {% endif %}
      {% endif %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="collection-pagination" aria-label="Pagination">
        {{ paginate | default_pagination: next: 'Next &rarr;', previous: '&larr; Prev' }}
      </nav>
    {% endif %}
  {% endpaginate %}
</main>

<hr class="category-divider-line">

<script>
  (function() {
    function initNecklacesPage() {
      const grid = document.getElementById('necklaces-grid');
      if (!grid) return;

      const densityBtns = document.querySelectorAll('.grid-density-btn');
      densityBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          densityBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const cols = btn.getAttribute('data-cols') || '4';
          grid.classList.remove('grid--1-col', 'grid--2-col', 'grid--4-col');
          grid.classList.add(`grid--${cols}-col`);
        });
      });

      const filterToggle = document.getElementById('filter-sort-toggle-necklaces');
      const filterDropdown = document.getElementById('collection-filter-dropdown-necklaces');
      if (filterToggle && filterDropdown) {
        filterToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = filterDropdown.classList.contains('is-open');
          filterDropdown.classList.toggle('is-open', !isOpen);
          filterToggle.setAttribute('aria-expanded', !isOpen);
        });
        document.addEventListener('click', (e) => {
          if (!filterDropdown.contains(e.target) && e.target !== filterToggle) {
            filterDropdown.classList.remove('is-open');
            filterToggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Catalog JS Fallback if grid has 0 cards
      const placeholder = document.getElementById('necklaces-empty-placeholder');
      if (placeholder && window.OGE_HELPERS && window.OGE_CATALOG) {
        const necklaces = window.OGE_CATALOG.filter(p => {
          const cat = (p.category || '').toLowerCase();
          const title = (p.title || '').toLowerCase();
          return cat === 'necklaces' || title.includes('necklace');
        });
        if (necklaces.length > 0) {
          grid.innerHTML = necklaces.map(item => window.OGE_HELPERS.renderProductCard(item)).join('');
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNecklacesPage);
    } else {
      initNecklacesPage();
    }
  })();
</script>

{% schema %}
{
  "name": "Necklaces Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "NECKLACES",
      "info": "Edit the heading displayed on the Necklaces page"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Source",
      "info": "Choose which collection populates this page (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show Hero Banner",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Hero Banner Image"
    },
    {
      "type": "textarea",
      "id": "banner_desc",
      "label": "Hero Subtitle / Description"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 36,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
