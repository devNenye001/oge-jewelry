{% comment %}
  OGÉ Fine Jewelry - Main Bundle Deals Section
  Matches bundle-deals.html
{% endcomment %}

<div class="bundle-deals-section-wrap">
  <div class="bundle-deals-wrapper">
    <h1 class="bundle-deals-heading">{{ section.settings.heading | default: 'BUNDLE DEALS' }}</h1>

    <div class="bundle-deals-grid">
      <!-- Card 1: 2 Ala Rings for $150 -->
      <div class="bundle-card">
        {% if section.settings.card_1_image != blank %}
          {{ section.settings.card_1_image | image_url: width: 800 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: section.settings.card_1_title }}
        {% else %}
          <img src="{{ 'sales1.jpg' | asset_url }}" alt="Bundle deal - 2 Ala Rings for $150" class="bundle-card__img" loading="eager" width="800" height="1000">
        {% endif %}
        <div class="bundle-card__overlay">
          <span class="bundle-card__eyebrow">{{ section.settings.card_1_eyebrow | default: 'Bundle deal' }}</span>
          <h2 class="bundle-card__title">{{ section.settings.card_1_title | default: '2 ALA RINGS FOR $150' }}</h2>
          <a href="{{ section.settings.card_1_link | default: '/pages/rings' }}" class="bundle-card__link">Shop Now</a>
        </div>
      </div>

      <!-- Card 2: Valor Earring + Necklace for $200 -->
      <div class="bundle-card">
        {% if section.settings.card_2_image != blank %}
          {{ section.settings.card_2_image | image_url: width: 800 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: section.settings.card_2_title }}
        {% else %}
          <img src="{{ 'sales2.jpg' | asset_url }}" alt="Jewelry Set Offer - Valor Earring + Necklace for $200" class="bundle-card__img" loading="eager" width="800" height="1000">
        {% endif %}
        <div class="bundle-card__overlay">
          <span class="bundle-card__eyebrow">{{ section.settings.card_2_eyebrow | default: 'Jewelry Set Offer' }}</span>
          <h2 class="bundle-card__title">{{ section.settings.card_2_title | default: 'VALOR EARRING +<br>NECKLACE FOR $200' }}</h2>
          <a href="{{ section.settings.card_2_link | default: '/pages/necklaces' }}" class="bundle-card__link">Shop Now</a>
        </div>
      </div>
    </div>
  </div>
</div>

<hr class="category-divider-line">

{% schema %}
{
  "name": "Bundle Deals",
  "tag": "section",
  "class": "section-bundle-deals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUNDLE DEALS"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "text",
      "id": "card_1_eyebrow",
      "label": "Eyebrow",
      "default": "Bundle deal"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Title",
      "default": "2 ALA RINGS FOR $150"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "card_1_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "text",
      "id": "card_2_eyebrow",
      "label": "Eyebrow",
      "default": "Jewelry Set Offer"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Title",
      "default": "VALOR EARRING + NECKLACE FOR $200"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "card_2_link",
      "label": "Link"
    }
  ]
}
{% endschema %}
