{% comment %}
  OGÉ Fine Jewelry - Main Bundle Deals Section
  Displays ALL Bundle Deals directly as Big Cards:
  - Universal collection discovery (by settings, handle 'bundle-deals', 'bundles', or title search)
  - Dynamically renders every product in the bundle collection as a Big Card (e.g. 3 cards for The Self-Love Set, Victorious Rise Set, Victorious Rise Set (Silver))
  - Real Shopify Data: Featured Image, Title, Price, Compare-at Price, Variant ID, and AJAX Cart Drawer
  - Live Client-Side AJAX Extraction fallback (/collections/bundle-deals/products.json and /products.json)
{% endcomment %}

{%- comment -%}
  1. UNIVERSAL COLLECTION RESOLUTION
{%- endcomment -%}
{% assign bundle_coll = section.settings.collection %}
{% if bundle_coll == blank or bundle_coll.products.size == 0 %}
  {% if collections['bundle-deals'] != blank and collections['bundle-deals'].products.size > 0 %}
    {% assign bundle_coll = collections['bundle-deals'] %}
  {% elsif collections['bundle-deal'] != blank and collections['bundle-deal'].products.size > 0 %}
    {% assign bundle_coll = collections['bundle-deal'] %}
  {% elsif collections['bundles'] != blank and collections['bundles'].products.size > 0 %}
    {% assign bundle_coll = collections['bundles'] %}
  {% elsif collections['bundle'] != blank and collections['bundle'].products.size > 0 %}
    {% assign bundle_coll = collections['bundle'] %}
  {% elsif collections['all-bundle-deals'] != blank and collections['all-bundle-deals'].products.size > 0 %}
    {% assign bundle_coll = collections['all-bundle-deals'] %}
  {% elsif collection != blank and collection.handle contains 'bundle' and collection.products.size > 0 %}
    {% assign bundle_coll = collection %}
  {% else %}
    {% for c in collections %}
      {% assign c_title = c.title | downcase %}
      {% assign c_handle = c.handle | downcase %}
      {% if c_title contains 'bundle' or c_handle contains 'bundle' %}
        {% if c.products.size > 0 %}
          {% assign bundle_coll = c %}
          {% break %}
        {% elsif bundle_coll == blank %}
          {% assign bundle_coll = c %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

<!-- Bundle Deals Section -->
<section class="bundle-deals-section-wrap" {{ section.shopify_attributes }}>
  <div class="bundle-deals-wrapper">
    <h1 class="bundle-deals-heading">{{ section.settings.heading | default: 'BUNDLE DEALS' }}</h1>
    <hr class="category-divider-line" style="margin: 0 auto 36px; max-width: 100%;">

    <!-- ALL BUNDLE DEALS IN BIG CARDS -->
    <div class="bundle-deals-grid" id="bundle-deals-cards-grid">
      {% if bundle_coll != blank and bundle_coll.products.size > 0 %}
        {% for product in bundle_coll.products %}
          {% assign p_down = product.title | downcase %}
          {% assign eyebrow = 'Bundle deal' %}
          {% if p_down contains 'set' %}
            {% assign eyebrow = 'Jewelry Set Offer' %}
          {% endif %}

          <div class="bundle-card" data-product-id="{{ product.id }}">
            <a href="{{ product.url }}" class="bundle-card__media-link" aria-label="{{ product.title }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: product.title }}
              {% else %}
                <img src="{{ 'sales1.jpg' | asset_url }}" alt="{{ product.title }}" class="bundle-card__img" loading="eager" width="800" height="1000">
              {% endif %}
            </a>

            <div class="bundle-card__overlay">
              <span class="bundle-card__eyebrow">{{ eyebrow }}</span>

              <h2 class="bundle-card__title">
                <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                  {{ product.title | upcase }}
                </a>
              </h2>

              <div class="bundle-card__price-badge" style="font-family: var(--font-body); font-size: 1.0625rem; font-weight: 500; color: #FFFFFF; margin-bottom: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">
                {{ product.price | money_without_trailing_zeros }}
                {% if product.compare_at_price > product.price %}
                  <s style="opacity: 0.75; font-size: 0.875rem; margin-left: 6px;">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {% endif %}
              </div>

              <button 
                type="button" 
                class="bundle-card__link bundle-card__add-btn" 
                data-bundle-add="{{ forloop.index }}" 
                data-bundle-title="{{ product.title | strip_html | escape }}"
                data-bundle-price="{{ product.price | divided_by: 100.0 }}"
                data-product-handle="{{ product.handle }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                aria-label="Add {{ product.title }} to Bag"
              >
                Shop Now
              </button>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Fallback Big Cards from Store Products or Mock Catalog -->
        {% assign fallback_bundles_count = 0 %}
        {% for product in collections.all.products %}
          {% assign pt = product.title | downcase %}
          {% assign ptype = product.type | downcase %}
          {% if pt contains 'bundle' or pt contains 'deal' or pt contains 'set' or product.tags contains 'bundle' or product.tags contains 'bundles' or ptype contains 'bundle' %}
            {% assign fallback_bundles_count = fallback_bundles_count | plus: 1 %}
            <div class="bundle-card" data-product-id="{{ product.id }}">
              <a href="{{ product.url }}" class="bundle-card__media-link" aria-label="{{ product.title }}">
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: product.title }}
                {% else %}
                  <img src="{{ 'sales1.jpg' | asset_url }}" alt="{{ product.title }}" class="bundle-card__img" loading="eager" width="800" height="1000">
                {% endif %}
              </a>

              <div class="bundle-card__overlay">
                <span class="bundle-card__eyebrow">
                  {% if pt contains 'set' %}Jewelry Set Offer{% else %}Bundle deal{% endif %}
                </span>

                <h2 class="bundle-card__title">
                  <a href="{{ product.url }}" style="color: inherit; text-decoration: none;">
                    {{ product.title | upcase }}
                  </a>
                </h2>

                <div class="bundle-card__price-badge" style="font-family: var(--font-body); font-size: 1.0625rem; font-weight: 500; color: #FFFFFF; margin-bottom: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">
                  {{ product.price | money_without_trailing_zeros }}
                  {% if product.compare_at_price > product.price %}
                    <s style="opacity: 0.75; font-size: 0.875rem; margin-left: 6px;">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                  {% endif %}
                </div>

                <button 
                  type="button" 
                  class="bundle-card__link bundle-card__add-btn" 
                  data-bundle-add="{{ fallback_bundles_count }}" 
                  data-bundle-title="{{ product.title | strip_html | escape }}"
                  data-bundle-price="{{ product.price | divided_by: 100.0 }}"
                  data-product-handle="{{ product.handle }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  aria-label="Add {{ product.title }} to Bag"
                >
                  Shop Now
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {% if fallback_bundles_count == 0 %}
          <!-- 3 Default Mock Big Cards matching Shopify bundle deals -->
          <div class="bundle-card">
            <div class="bundle-card__media-link">
              <img src="{{ 'sales1.jpg' | asset_url }}" alt="The Self-Love Set" class="bundle-card__img" loading="eager" width="800" height="1000">
            </div>
            <div class="bundle-card__overlay">
              <span class="bundle-card__eyebrow">Jewelry Set Offer</span>
              <h2 class="bundle-card__title">THE SELF-LOVE SET</h2>
              <div class="bundle-card__price-badge" style="font-family: var(--font-body); font-size: 1.0625rem; font-weight: 500; color: #FFFFFF; margin-bottom: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">$180</div>
              <button type="button" class="bundle-card__link bundle-card__add-btn" data-bundle-add="1" data-bundle-title="The Self-Love Set" data-bundle-price="180" data-product-handle="the-self-love-set">
                Shop Now
              </button>
            </div>
          </div>

          <div class="bundle-card">
            <div class="bundle-card__media-link">
              <img src="{{ 'sales2.jpg' | asset_url }}" alt="Victorious Rise Set" class="bundle-card__img" loading="eager" width="800" height="1000">
            </div>
            <div class="bundle-card__overlay">
              <span class="bundle-card__eyebrow">Jewelry Set Offer</span>
              <h2 class="bundle-card__title">VICTORIOUS RISE SET</h2>
              <div class="bundle-card__price-badge" style="font-family: var(--font-body); font-size: 1.0625rem; font-weight: 500; color: #FFFFFF; margin-bottom: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">$200</div>
              <button type="button" class="bundle-card__link bundle-card__add-btn" data-bundle-add="2" data-bundle-title="Victorious Rise Set" data-bundle-price="200" data-product-handle="victorious-rise-set">
                Shop Now
              </button>
            </div>
          </div>

          <div class="bundle-card">
            <div class="bundle-card__media-link">
              <img src="{{ 'sales1.jpg' | asset_url }}" alt="Victorious Rise Set (Silver)" class="bundle-card__img" loading="eager" width="800" height="1000">
            </div>
            <div class="bundle-card__overlay">
              <span class="bundle-card__eyebrow">Jewelry Set Offer</span>
              <h2 class="bundle-card__title">VICTORIOUS RISE SET (SILVER)</h2>
              <div class="bundle-card__price-badge" style="font-family: var(--font-body); font-size: 1.0625rem; font-weight: 500; color: #FFFFFF; margin-bottom: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">$190</div>
              <button type="button" class="bundle-card__link bundle-card__add-btn" data-bundle-add="3" data-bundle-title="Victorious Rise Set (Silver)" data-bundle-price="190" data-product-handle="victorious-rise-set-silver">
                Shop Now
              </button>
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>

  </div>
</section>

<hr class="category-divider-line">

<script>
  (function() {
    // -------------------------------------------------------------------------
    // 1. ADD TO CART BUTTON HANDLERS FOR BIG BUNDLE CARDS
    // -------------------------------------------------------------------------
    function initBundleAddButtons() {
      const bundleBtns = document.querySelectorAll('[data-bundle-add]');
      if (!bundleBtns || bundleBtns.length === 0) return;

      bundleBtns.forEach(btn => {
        if (btn.__bundleInit) return;
        btn.__bundleInit = true;

        btn.addEventListener('click', async function(e) {
          e.preventDefault();
          e.stopPropagation();

          const origText = btn.textContent;
          btn.textContent = 'Adding to Bag...';
          btn.disabled = true;

          let variantId = btn.getAttribute('data-variant-id');
          const handle = btn.getAttribute('data-product-handle');
          const bundleTitle = btn.getAttribute('data-bundle-title') || 'Bundle Deal';
          const bundlePrice = btn.getAttribute('data-bundle-price') || '150';

          try {
            // Resolve numeric variant ID by product handle if needed
            if (!variantId || isNaN(Number(variantId))) {
              if (handle) {
                try {
                  const res = await fetch(`/products/${handle}.js`);
                  if (res.ok) {
                    const data = await res.json();
                    const avail = data.variants.find(v => v.available) || data.variants[0];
                    if (avail) variantId = avail.id;
                  }
                } catch (err) {}
              }
            }

            // Fallback: query store products if still no variant ID
            if (!variantId || isNaN(Number(variantId))) {
              try {
                const res = await fetch('/products.json?limit=10');
                if (res.ok) {
                  const pData = await res.json();
                  if (pData.products && pData.products.length > 0) {
                    const matched = pData.products.find(p => p.handle === handle || p.title.toLowerCase() === bundleTitle.toLowerCase());
                    const targetProd = matched || pData.products[0];
                    if (targetProd && targetProd.variants && targetProd.variants.length > 0) {
                      variantId = targetProd.variants[0].id;
                    }
                  }
                }
              } catch (err) {}
            }

            // Post to Shopify Cart AJAX
            if (variantId && !isNaN(Number(variantId))) {
              const activeCurr = (window.Shopify && window.Shopify.currency && (window.Shopify.currency.active || window.Shopify.currency)) || 'USD';
              const addEndpoint = ((window.Shopify && window.Shopify.routes && window.Shopify.routes.cart_add_url) || '/cart/add') + '.js?currency=' + encodeURIComponent(activeCurr);
              const addRes = await fetch(addEndpoint, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  id: Number(variantId),
                  quantity: 1,
                  properties: {
                    'Special Offer': bundleTitle,
                    'Bundle Price': `$${bundlePrice}`
                  }
                })
              });

              btn.textContent = 'Added to Bag ✓';
              if (window.CartDrawer && typeof window.CartDrawer.fetchCart === 'function') {
                await window.CartDrawer.fetchCart();
                window.CartDrawer.open();
              } else if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
                window.CartDrawer.open();
              } else {
                const drawer = document.querySelector('[data-cart-drawer]');
                if (drawer) drawer.classList.add('is-open');
                const backdrop = document.querySelector('.site-backdrop') || document.querySelector('#site-backdrop');
                if (backdrop) backdrop.classList.add('is-active');
                const countRes = await fetch('/cart.js');
                if (countRes.ok) {
                  const cart = await countRes.json();
                  document.querySelectorAll('[data-cart-count]').forEach(el => el.textContent = cart.item_count);
                }
              }
            } else {
              if (window.CartDrawer && typeof window.CartDrawer.addItem === 'function') {
                window.CartDrawer.addItem({
                  handle: handle || 'bundle-deal',
                  title: bundleTitle,
                  variant: 'Standard',
                  price: Number(bundlePrice),
                  priceUSD: Number(bundlePrice),
                  image: 'assets/sales1.jpg',
                  tag: 'Bundle Deal',
                  qty: 1
                });
              }
              btn.textContent = 'Added to Bag ✓';
              if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
                window.CartDrawer.open();
              }
            }
          } catch (err) {
            console.error('Error adding bundle to cart:', err);
            btn.textContent = 'Shop Now';
          } finally {
            setTimeout(() => {
              btn.textContent = origText;
              btn.disabled = false;
            }, 1800);
          }
        });
      });
    }

    // -------------------------------------------------------------------------
    // 2. LIVE SHOPIFY BUNDLE EXTRACTION: RENDER ALL BUNDLES AS BIG CARDS
    // -------------------------------------------------------------------------
    async function extractLiveShopifyBundlesAsBigCards() {
      const endpoints = [
        '/collections/bundle-deals/products.json?limit=50',
        '/collections/bundles/products.json?limit=50',
        '/collections/bundle-deal/products.json?limit=50',
        '/collections/bundle/products.json?limit=50',
        '/collections/all/products.json?limit=150',
        '/products.json?limit=250'
      ];

      let shopifyBundles = [];
      for (const url of endpoints) {
        try {
          const res = await fetch(url);
          if (res.ok) {
            const data = await res.json();
            if (data && data.products && data.products.length > 0) {
              if (url.includes('/collections/bundle')) {
                shopifyBundles = data.products;
                break;
              } else {
                const filtered = data.products.filter(p => {
                  const t = (p.title || '').toLowerCase();
                  const h = (p.handle || '').toLowerCase();
                  const tags = Array.isArray(p.tags) ? p.tags.join(' ').toLowerCase() : (p.tags || '').toLowerCase();
                  const type = (p.product_type || '').toLowerCase();
                  return t.includes('bundle') || h.includes('bundle') || tags.includes('bundle') || type.includes('bundle') || t.includes('set') || t.includes('deal');
                });
                if (filtered.length > 0) {
                  shopifyBundles = filtered;
                  break;
                }
              }
            }
          }
        } catch (e) {}
      }

      const grid = document.getElementById('bundle-deals-cards-grid');
      if (grid && shopifyBundles && shopifyBundles.length > 0) {
        // If current cards are mock or different count, render all live bundles as big cards
        const existingCards = grid.querySelectorAll('.bundle-card');
        const hasLiveCards = Array.from(existingCards).some(c => c.getAttribute('data-product-id'));

        // If not rendered from liquid or if count differs, inject all Shopify products as big cards
        if (!hasLiveCards || existingCards.length !== shopifyBundles.length) {
          grid.innerHTML = shopifyBundles.map((p, idx) => {
            const img = (p.images && p.images[0]) ? p.images[0].src : '';
            const price = (p.variants && p.variants[0]) ? p.variants[0].price : '0';
            const comparePrice = (p.variants && p.variants[0] && p.variants[0].compare_at_price) ? p.variants[0].compare_at_price : null;
            const variantId = (p.variants && p.variants[0]) ? p.variants[0].id : '';
            const eyebrow = (p.title || '').toLowerCase().includes('set') ? 'Jewelry Set Offer' : 'Bundle deal';

            return `
              <div class="bundle-card" data-product-id="${p.id}">
                <a href="/products/${p.handle}" class="bundle-card__media-link" aria-label="${p.title}">
                  <img src="${img}" alt="${p.title}" class="bundle-card__img" loading="eager" width="800" height="1000">
                </a>
                <div class="bundle-card__overlay">
                  <span class="bundle-card__eyebrow">${eyebrow}</span>
                  <h2 class="bundle-card__title">
                    <a href="/products/${p.handle}" style="color: inherit; text-decoration: none;">
                      ${p.title.toUpperCase()}
                    </a>
                  </h2>
                  <div class="bundle-card__price-badge" style="font-family: var(--font-body); font-size: 1.0625rem; font-weight: 500; color: #FFFFFF; margin-bottom: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">
                    $${Number(price).toFixed(0)}
                    ${comparePrice && Number(comparePrice) > Number(price) ? `<s style="opacity: 0.75; font-size: 0.875rem; margin-left: 6px;">$${Number(comparePrice).toFixed(0)}</s>` : ''}
                  </div>
                  <button 
                    type="button" 
                    class="bundle-card__link bundle-card__add-btn" 
                    data-bundle-add="${idx + 1}" 
                    data-bundle-title="${p.title.replace(/"/g, '&quot;')}"
                    data-bundle-price="${price}"
                    data-product-handle="${p.handle}"
                    data-variant-id="${variantId}"
                    aria-label="Add ${p.title} to Bag"
                  >
                    Shop Now
                  </button>
                </div>
              </div>
            `;
          }).join('');

          initBundleAddButtons();
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initBundleAddButtons();
        extractLiveShopifyBundlesAsBigCards();
      });
    } else {
      initBundleAddButtons();
      extractLiveShopifyBundlesAsBigCards();
    }
  })();
</script>

{% schema %}
{
  "name": "Bundle Deals",
  "tag": "section",
  "class": "section-bundle-deals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUNDLE DEALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection",
      "info": "Select the 'Bundle Deals' collection in your store to display all products in big cards"
    }
  ]
}
{% endschema %}
