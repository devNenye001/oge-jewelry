{% comment %}
  OGÉ Fine Jewelry - Main Bundle Deals Section
  Extracts and displays live Bundle Deals from Shopify:
  - Universal collection discovery (by settings, handle 'bundle-deals', 'bundles', or title search)
  - Hero Cards extracted dynamically from Shopify collection products (Title, Image, Price, Variant ID)
  - Complete Collection Products Grid extracting all bundle products from Shopify
  - Dynamic client-side AJAX extraction fallback (/collections/bundle-deals/products.json and /products.json)
  - Full AJAX Add-to-Cart with automatic Cart Drawer opening
{% endcomment %}

{%- comment -%}
  1. UNIVERSAL COLLECTION RESOLUTION
{%- endcomment -%}
{% assign bundle_coll = section.settings.collection %}
{% if bundle_coll == blank or bundle_coll.products.size == 0 %}
  {% if collections['bundle-deals'] != blank and collections['bundle-deals'].products.size > 0 %}
    {% assign bundle_coll = collections['bundle-deals'] %}
  {% elsif collections['bundle-deal'] != blank and collections['bundle-deal'].products.size > 0 %}
    {% assign bundle_coll = collections['bundle-deal'] %}
  {% elsif collections['bundles'] != blank and collections['bundles'].products.size > 0 %}
    {% assign bundle_coll = collections['bundles'] %}
  {% elsif collections['bundle'] != blank and collections['bundle'].products.size > 0 %}
    {% assign bundle_coll = collections['bundle'] %}
  {% elsif collections['all-bundle-deals'] != blank and collections['all-bundle-deals'].products.size > 0 %}
    {% assign bundle_coll = collections['all-bundle-deals'] %}
  {% elsif collection != blank and collection.handle contains 'bundle' and collection.products.size > 0 %}
    {% assign bundle_coll = collection %}
  {% else %}
    {% for c in collections %}
      {% assign c_title = c.title | downcase %}
      {% assign c_handle = c.handle | downcase %}
      {% if c_title contains 'bundle' or c_handle contains 'bundle' %}
        {% if c.products.size > 0 %}
          {% assign bundle_coll = c %}
          {% break %}
        {% elsif bundle_coll == blank %}
          {% assign bundle_coll = c %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{%- comment -%}
  2. EXTRACT HERO PRODUCTS FROM SHOPIFY BUNDLE COLLECTION
{%- endcomment -%}
{% assign card_1_prod = section.settings.card_1_product %}
{% assign card_2_prod = section.settings.card_2_product %}

{% if bundle_coll != blank and bundle_coll.products.size > 0 %}
  {% if card_1_prod == blank %}
    {% assign card_1_prod = bundle_coll.products[0] %}
  {% endif %}
  {% if card_2_prod == blank %}
    {% if bundle_coll.products.size > 1 %}
      {% assign card_2_prod = bundle_coll.products[1] %}
    {% else %}
      {% assign card_2_prod = bundle_coll.products[0] %}
    {% endif %}
  {% endif %}
{% endif %}

<!-- Bundle Deals Section -->
<section class="bundle-deals-section-wrap" {{ section.shopify_attributes }}>
  <div class="bundle-deals-wrapper">
    <h1 class="bundle-deals-heading">{{ section.settings.heading | default: 'BUNDLE DEALS' }}</h1>
    <hr class="category-divider-line" style="margin: 0 auto 36px; max-width: 100%;">

    <!-- 2-Card Hero Showcase Grid -->
    <div class="bundle-deals-grid">
      <!-- Card 1 -->
      <div class="bundle-card" id="bundle-hero-card-1">
        {% if section.settings.card_1_image != blank %}
          {{ section.settings.card_1_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: section.settings.card_1_title }}
        {% elsif card_1_prod != blank and card_1_prod.featured_image != blank %}
          {{ card_1_prod.featured_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: card_1_prod.title }}
        {% else %}
          <img src="{{ 'sales1.jpg' | asset_url }}" alt="Bundle deal" class="bundle-card__img" loading="eager" width="800" height="1000">
        {% endif %}

        <div class="bundle-card__overlay">
          <span class="bundle-card__eyebrow">
            {{ section.settings.card_1_eyebrow | default: 'Bundle deal' }}
          </span>

          <h2 class="bundle-card__title">
            {% if section.settings.card_1_title != blank %}
              {{ section.settings.card_1_title }}
            {% elsif card_1_prod != blank %}
              {{ card_1_prod.title | upcase }}
            {% else %}
              2 ALA RINGS FOR $150
            {% endif %}
          </h2>

          {% assign c1_price_str = section.settings.card_1_price %}
          {% if c1_price_str == blank and card_1_prod != blank %}
            {% assign c1_price_str = card_1_prod.price | divided_by: 100.0 %}
          {% endif %}
          {% if c1_price_str == blank %}{% assign c1_price_str = '150' %}{% endif %}

          <button 
            type="button" 
            class="bundle-card__link bundle-card__add-btn" 
            data-bundle-add="1" 
            data-bundle-title="{% if section.settings.card_1_title != blank %}{{ section.settings.card_1_title | strip_html | escape }}{% elsif card_1_prod != blank %}{{ card_1_prod.title | strip_html | escape }}{% else %}2 ALA RINGS FOR $150{% endif %}"
            data-bundle-price="{{ c1_price_str }}"
            data-product-handle="{{ card_1_prod.handle | default: 'ala-ring' }}"
            data-variant-id="{{ card_1_prod.selected_or_first_available_variant.id | default: section.settings.card_1_variant_id }}"
            aria-label="Add bundle deal to Bag"
          >
            Shop Now
          </button>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bundle-card" id="bundle-hero-card-2">
        {% if section.settings.card_2_image != blank %}
          {{ section.settings.card_2_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: section.settings.card_2_title }}
        {% elsif card_2_prod != blank and card_2_prod.featured_image != blank %}
          {{ card_2_prod.featured_image | image_url: width: 1000 | image_tag: class: 'bundle-card__img', loading: 'eager', alt: card_2_prod.title }}
        {% else %}
          <img src="{{ 'sales2.jpg' | asset_url }}" alt="Jewelry Set Offer" class="bundle-card__img" loading="eager" width="800" height="1000">
        {% endif %}

        <div class="bundle-card__overlay">
          <span class="bundle-card__eyebrow">
            {{ section.settings.card_2_eyebrow | default: 'Jewelry Set Offer' }}
          </span>

          <h2 class="bundle-card__title">
            {% if section.settings.card_2_title != blank %}
              {{ section.settings.card_2_title }}
            {% elsif card_2_prod != blank %}
              {{ card_2_prod.title | upcase }}
            {% else %}
              VALOR EARRING +<br>NECKLACE FOR $200
            {% endif %}
          </h2>

          {% assign c2_price_str = section.settings.card_2_price %}
          {% if c2_price_str == blank and card_2_prod != blank %}
            {% assign c2_price_str = card_2_prod.price | divided_by: 100.0 %}
          {% endif %}
          {% if c2_price_str == blank %}{% assign c2_price_str = '200' %}{% endif %}

          <button 
            type="button" 
            class="bundle-card__link bundle-card__add-btn" 
            data-bundle-add="2" 
            data-bundle-title="{% if section.settings.card_2_title != blank %}{{ section.settings.card_2_title | strip_html | escape }}{% elsif card_2_prod != blank %}{{ card_2_prod.title | strip_html | escape }}{% else %}VALOR EARRING + NECKLACE FOR $200{% endif %}"
            data-bundle-price="{{ c2_price_str }}"
            data-product-handle="{{ card_2_prod.handle | default: 'valor-necklace' }}"
            data-variant-id="{{ card_2_prod.selected_or_first_available_variant.id | default: section.settings.card_2_variant_id }}"
            aria-label="Add bundle deal to Bag"
          >
            Shop Now
          </button>
        </div>
      </div>
    </div>

    <!-- 3. ALL PRODUCTS FROM SHOPIFY BUNDLE DEALS COLLECTION -->
    <div class="bundle-products-section" style="margin-top: 64px;">
      <div class="bundle-products-header" style="text-align: center; margin-bottom: 32px;">
        <h2 style="font-family: var(--font-heading); font-size: clamp(1.35rem, 2.5vw, 1.875rem); letter-spacing: -0.02em; text-transform: uppercase; color: #111111; margin: 0 0 8px;">
          Shop All Bundle Deals
        </h2>
        <p style="font-family: var(--font-body); font-size: 0.875rem; color: #666666; margin: 0;">
          All curated sets and special bundle offers directly from our Shopify catalog.
        </p>
      </div>

      <div class="collection-products-grid grid--4-col" id="bundle-products-grid">
        {% if bundle_coll != blank and bundle_coll.products.size > 0 %}
          {% for product in bundle_coll.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        {% else %}
          {% assign fallback_bundles_count = 0 %}
          {% for product in collections.all.products %}
            {% assign pt = product.title | downcase %}
            {% assign ptype = product.type | downcase %}
            {% if pt contains 'bundle' or pt contains 'deal' or pt contains 'set' or product.tags contains 'bundle' or product.tags contains 'bundles' or ptype contains 'bundle' %}
              {% render 'product-card', product: product %}
              {% assign fallback_bundles_count = fallback_bundles_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if fallback_bundles_count == 0 %}
            {% for product in collections.all.products limit: 4 %}
              {% render 'product-card', product: product %}
            {% endfor %}
          {% endif %}
        {% endif %}
      </div>
    </div>

  </div>
</section>

<hr class="category-divider-line">

<script>
  (function() {
    // -------------------------------------------------------------------------
    // 1. ADD TO CART BUTTON HANDLERS FOR HERO BUNDLE CARDS
    // -------------------------------------------------------------------------
    function initBundleAddButtons() {
      const bundleBtns = document.querySelectorAll('[data-bundle-add]');
      if (!bundleBtns || bundleBtns.length === 0) return;

      bundleBtns.forEach(btn => {
        btn.addEventListener('click', async function(e) {
          e.preventDefault();
          e.stopPropagation();

          const origText = btn.textContent;
          btn.textContent = 'Adding to Bag...';
          btn.disabled = true;

          let variantId = btn.getAttribute('data-variant-id');
          const handle = btn.getAttribute('data-product-handle');
          const bundleTitle = btn.getAttribute('data-bundle-title') || 'Bundle Deal';
          const bundlePrice = btn.getAttribute('data-bundle-price') || '150';

          try {
            // Resolve numeric variant ID by product handle if needed
            if (!variantId || isNaN(Number(variantId))) {
              if (handle) {
                try {
                  const res = await fetch(`/products/${handle}.js`);
                  if (res.ok) {
                    const data = await res.json();
                    const avail = data.variants.find(v => v.available) || data.variants[0];
                    if (avail) variantId = avail.id;
                  }
                } catch (err) {}
              }
            }

            // Fallback: query store products if still no variant ID
            if (!variantId || isNaN(Number(variantId))) {
              try {
                const res = await fetch('/products.json?limit=5');
                if (res.ok) {
                  const pData = await res.json();
                  if (pData.products && pData.products.length > 0) {
                    const firstProd = pData.products[0];
                    if (firstProd.variants && firstProd.variants.length > 0) {
                      variantId = firstProd.variants[0].id;
                    }
                  }
                }
              } catch (err) {}
            }

            // Post to Shopify Cart AJAX
            if (variantId && !isNaN(Number(variantId))) {
              const activeCurr = (window.Shopify && window.Shopify.currency && (window.Shopify.currency.active || window.Shopify.currency)) || 'USD';
              const addEndpoint = ((window.Shopify && window.Shopify.routes && window.Shopify.routes.cart_add_url) || '/cart/add') + '.js?currency=' + encodeURIComponent(activeCurr);
              const addRes = await fetch(addEndpoint, {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                body: JSON.stringify({
                  id: Number(variantId),
                  quantity: 1,
                  properties: {
                    'Special Offer': bundleTitle,
                    'Bundle Price': `$${bundlePrice}`
                  }
                })
              });

              btn.textContent = 'Added to Bag ✓';
              if (window.CartDrawer && typeof window.CartDrawer.fetchCart === 'function') {
                await window.CartDrawer.fetchCart();
                window.CartDrawer.open();
              } else if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
                window.CartDrawer.open();
              } else {
                const drawer = document.querySelector('[data-cart-drawer]');
                if (drawer) drawer.classList.add('is-open');
                const backdrop = document.querySelector('.site-backdrop') || document.querySelector('#site-backdrop');
                if (backdrop) backdrop.classList.add('is-active');
                const countRes = await fetch('/cart.js');
                if (countRes.ok) {
                  const cart = await countRes.json();
                  document.querySelectorAll('[data-cart-count]').forEach(el => el.textContent = cart.item_count);
                }
              }
            } else {
              if (window.CartDrawer && typeof window.CartDrawer.addItem === 'function') {
                window.CartDrawer.addItem({
                  handle: handle || 'bundle-deal',
                  title: bundleTitle,
                  variant: 'Gold',
                  price: Number(bundlePrice),
                  priceUSD: Number(bundlePrice),
                  image: btn.getAttribute('data-bundle-add') === '1' ? 'assets/sales1.jpg' : 'assets/sales2.jpg',
                  tag: 'Bundle Deal',
                  qty: 1
                });
              }
              btn.textContent = 'Added to Bag ✓';
              if (window.CartDrawer && typeof window.CartDrawer.open === 'function') {
                window.CartDrawer.open();
              }
            }
          } catch (err) {
            console.error('Error adding bundle to cart:', err);
            btn.textContent = 'Shop Now';
          } finally {
            setTimeout(() => {
              btn.textContent = origText;
              btn.disabled = false;
            }, 1800);
          }
        });
      });
    }

    // -------------------------------------------------------------------------
    // 2. DYNAMIC LIVE SHOPIFY BUNDLE EXTRACTION (AJAX SYNC)
    // -------------------------------------------------------------------------
    async function extractLiveShopifyBundles() {
      const endpoints = [
        '/collections/bundle-deals/products.json?limit=50',
        '/collections/bundles/products.json?limit=50',
        '/collections/bundle-deal/products.json?limit=50',
        '/collections/bundle/products.json?limit=50',
        '/collections/all/products.json?limit=100',
        '/products.json?limit=150'
      ];

      let shopifyBundles = [];
      for (const url of endpoints) {
        try {
          const res = await fetch(url);
          if (res.ok) {
            const data = await res.json();
            if (data && data.products && data.products.length > 0) {
              if (url.includes('/collections/bundle')) {
                shopifyBundles = data.products;
                break;
              } else {
                const filtered = data.products.filter(p => {
                  const t = (p.title || '').toLowerCase();
                  const h = (p.handle || '').toLowerCase();
                  const tags = Array.isArray(p.tags) ? p.tags.join(' ').toLowerCase() : (p.tags || '').toLowerCase();
                  const type = (p.product_type || '').toLowerCase();
                  return t.includes('bundle') || h.includes('bundle') || tags.includes('bundle') || type.includes('bundle') || t.includes('deal') || t.includes('set');
                });
                if (filtered.length > 0) {
                  shopifyBundles = filtered;
                  break;
                }
              }
            }
          }
        } catch (e) {}
      }

      if (shopifyBundles && shopifyBundles.length > 0) {
        // Sync Hero Card 1 with actual Shopify product 1
        const p1 = shopifyBundles[0];
        const card1 = document.getElementById('bundle-hero-card-1');
        const btn1 = document.querySelector('[data-bundle-add="1"]');
        if (card1 && p1) {
          const titleEl = card1.querySelector('.bundle-card__title');
          const imgEl = card1.querySelector('.bundle-card__img');
          if (titleEl && (titleEl.textContent.includes('2 ALA RINGS') || titleEl.textContent.trim() === '')) {
            titleEl.textContent = p1.title.toUpperCase();
          }
          if (imgEl && p1.images && p1.images.length > 0 && imgEl.src.includes('sales1.jpg')) {
            imgEl.src = p1.images[0].src;
          }
        }
        if (btn1 && p1) {
          btn1.setAttribute('data-bundle-title', p1.title);
          btn1.setAttribute('data-product-handle', p1.handle);
          if (p1.variants && p1.variants[0]) {
            btn1.setAttribute('data-variant-id', p1.variants[0].id);
            btn1.setAttribute('data-bundle-price', p1.variants[0].price);
          }
        }

        // Sync Hero Card 2 with actual Shopify product 2
        const p2 = shopifyBundles.length > 1 ? shopifyBundles[1] : shopifyBundles[0];
        const card2 = document.getElementById('bundle-hero-card-2');
        const btn2 = document.querySelector('[data-bundle-add="2"]');
        if (card2 && p2) {
          const titleEl = card2.querySelector('.bundle-card__title');
          const imgEl = card2.querySelector('.bundle-card__img');
          if (titleEl && (titleEl.textContent.includes('VALOR EARRING') || titleEl.textContent.trim() === '')) {
            titleEl.innerHTML = p2.title.toUpperCase();
          }
          if (imgEl && p2.images && p2.images.length > 0 && imgEl.src.includes('sales2.jpg')) {
            imgEl.src = p2.images[0].src;
          }
        }
        if (btn2 && p2) {
          btn2.setAttribute('data-bundle-title', p2.title);
          btn2.setAttribute('data-product-handle', p2.handle);
          if (p2.variants && p2.variants[0]) {
            btn2.setAttribute('data-variant-id', p2.variants[0].id);
            btn2.setAttribute('data-bundle-price', p2.variants[0].price);
          }
        }

        // Render product cards if grid had 0 cards
        const grid = document.getElementById('bundle-products-grid');
        if (grid && grid.children.length === 0) {
          grid.innerHTML = shopifyBundles.map(p => {
            const img = (p.images && p.images[0]) ? p.images[0].src : '';
            const price = (p.variants && p.variants[0]) ? p.variants[0].price : '0';
            const variantId = (p.variants && p.variants[0]) ? p.variants[0].id : '';
            return `
              <div class="product-card" data-product-card data-product-handle="${p.handle}">
                <div class="product-card__media">
                  <a href="/products/${p.handle}" class="product-card__link">
                    <img src="${img}" alt="${p.title}" class="product-card__img" loading="lazy" width="400" height="400">
                  </a>
                  <button type="button" class="product-card__quick-add" data-quick-add data-product-id="${variantId}" aria-label="Add to bag">
                    Add to Bag
                  </button>
                </div>
                <div class="product-card__info">
                  <span class="product-card__tag">Bundle Deal</span>
                  <h3 class="product-card__title"><a href="/products/${p.handle}">${p.title}</a></h3>
                  <div class="product-card__price">
                    <span class="price-current" data-price-usd="${price}">$${Number(price).toFixed(2)}</span>
                  </div>
                </div>
              </div>
            `;
          }).join('');

          if (window.OGE_CURRENCY && typeof window.OGE_CURRENCY.updateDOM === 'function') {
            window.OGE_CURRENCY.updateDOM();
          }
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initBundleAddButtons();
        extractLiveShopifyBundles();
      });
    } else {
      initBundleAddButtons();
      extractLiveShopifyBundles();
    }
  })();
</script>

{% schema %}
{
  "name": "Bundle Deals",
  "tag": "section",
  "class": "section-bundle-deals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUNDLE DEALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection (Optional)",
      "info": "Select the 'Bundle Deals' collection in your store"
    },
    {
      "type": "header",
      "content": "Card 1: First Bundle Deal"
    },
    {
      "type": "text",
      "id": "card_1_eyebrow",
      "label": "Eyebrow Text",
      "default": "Bundle deal"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Custom Title Override (optional)"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Custom Image Override (optional)"
    },
    {
      "type": "product",
      "id": "card_1_product",
      "label": "Shopify Product (optional)"
    },
    {
      "type": "text",
      "id": "card_1_price",
      "label": "Custom Price Override (optional)"
    },
    {
      "type": "text",
      "id": "card_1_variant_id",
      "label": "Custom Variant ID (optional)"
    },
    {
      "type": "header",
      "content": "Card 2: Second Bundle Deal"
    },
    {
      "type": "text",
      "id": "card_2_eyebrow",
      "label": "Eyebrow Text",
      "default": "Jewelry Set Offer"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Custom Title Override (optional)"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Custom Image Override (optional)"
    },
    {
      "type": "product",
      "id": "card_2_product",
      "label": "Shopify Product (optional)"
    },
    {
      "type": "text",
      "id": "card_2_price",
      "label": "Custom Price Override (optional)"
    },
    {
      "type": "text",
      "id": "card_2_variant_id",
      "label": "Custom Variant ID (optional)"
    }
  ]
}
{% endschema %}
