{% comment %}
  OGÉ Fine Jewelry - Main Category Section (Image 2 Upload Match)
  Features:
  - Minimalist uppercase serif title (e.g., EARRINGS, RINGS, NECKLACES, BRACELETS)
  - Fine horizontal divider line
  - Toolbar with filter & sort + grid layout switcher (1-col, 2-col, 4-col)
  - 4-column product grid with Quick Add (+) & Wishlist heart button
{% endcomment %}

<!-- Category Header -->
<section class="category-page-header">
  <h1 class="category-page-title" data-category-page-title>{{ collection.title | default: page_title | default: 'EARRINGS' | upcase }}</h1>
</section>
<hr class="category-divider-line">

<!-- Category Toolbar -->
<div class="collection-toolbar">
  <div style="position: relative;">
    <button type="button" class="collection-toolbar__filter-btn" id="btn-filter-sort" aria-expanded="false" aria-controls="category-filter-dropdown">
      Filter &amp; Sort
    </button>
    <div class="filter-dropdown-menu" id="category-filter-dropdown" role="menu" style="display: none; position: absolute; top: calc(100% + 8px); left: 0; background: #FFFFFF; border: 1px solid #EAEAEA; box-shadow: 0 4px 16px rgba(0,0,0,0.08); z-index: 50; min-width: 180px; padding: 8px 0; border-radius: 2px;">
      {% assign current_sort_by = collection.sort_by | default: collection.default_sort_by %}
      <a href="{{ collection.url }}?sort_by=manual" class="filter-option-btn {% if current_sort_by == 'manual' %}is-active{% endif %}" style="display: block; padding: 8px 16px; font-size: 0.8125rem; color: #111111; text-decoration: none;">Featured</a>
      <a href="{{ collection.url }}?sort_by=best-selling" class="filter-option-btn {% if current_sort_by == 'best-selling' %}is-active{% endif %}" style="display: block; padding: 8px 16px; font-size: 0.8125rem; color: #111111; text-decoration: none;">Best Selling</a>
      <a href="{{ collection.url }}?sort_by=price-ascending" class="filter-option-btn {% if current_sort_by == 'price-ascending' %}is-active{% endif %}" style="display: block; padding: 8px 16px; font-size: 0.8125rem; color: #111111; text-decoration: none;">Price: Low to High</a>
      <a href="{{ collection.url }}?sort_by=price-descending" class="filter-option-btn {% if current_sort_by == 'price-descending' %}is-active{% endif %}" style="display: block; padding: 8px 16px; font-size: 0.8125rem; color: #111111; text-decoration: none;">Price: High to Low</a>
      <a href="{{ collection.url }}?sort_by=created-descending" class="filter-option-btn {% if current_sort_by == 'created-descending' %}is-active{% endif %}" style="display: block; padding: 8px 16px; font-size: 0.8125rem; color: #111111; text-decoration: none;">Newest</a>
    </div>
  </div>

  <div class="collection-toolbar__view-switchers" aria-label="View Switchers">
    <!-- 1 Column Switcher -->
    <button type="button" class="grid-switch-btn" data-grid-view="1" aria-label="Single Column View" title="1 Column View">
      <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
    <!-- 2 Column Switcher -->
    <button type="button" class="grid-switch-btn" data-grid-view="2" aria-label="Two Columns View" title="2 Columns View">
      <svg viewBox="0 0 24 24"><rect x="4" y="5" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="5" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
    <!-- 4 Column Switcher (Default Active) -->
    <button type="button" class="grid-switch-btn is-active" data-grid-view="4" aria-label="Four Columns View" title="4 Columns View">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="3" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
  </div>
</div>

<!-- Product Catalog -->
<main class="collection-catalog-wrap">
  {% paginate collection.products by section.settings.products_per_page | default: 16 %}
    <div class="collection-products-grid grid--4-col" id="collection-products-grid">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        <!-- Real OGÉ Category Empty State -->
        <div class="wishlist-empty-box collection-empty-state" style="grid-column: 1 / -1; padding: 60px 20px; text-align: center;">
          <h2 class="wishlist-empty-title">No products found</h2>
          <p class="wishlist-empty-desc">There are currently no products available in this category.</p>
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wishlist-shop-btn" style="display: inline-block;">Explore All Jewelry</a>
        </div>
      {% endif %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="collection-pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  {% endpaginate %}
</main>

<hr class="category-divider-line">

{% schema %}
{
  "name": "Category Products Grid",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
