{% comment %}
  OGÉ Fine Jewelry - Main Category Section (Matches Prototype Rings/Earrings/Necklaces/Bracelets)
  Features:
  - Minimalist uppercase serif title (e.g., EARRINGS, RINGS, NECKLACES, BRACELETS)
  - Fine horizontal divider line
  - Subcategory mini navigator tabs (Rings, Necklaces, Bracelets, Earrings)
  - Toolbar with Filter & Sort dropdown + Grid layout density switcher (1-col, 2-col, 4-col)
  - Dynamic 4-column product grid rendered from catalog-data.js with full Shopify liquid fallback
{% endcomment %}

{% assign active_title = collection.title | default: page_title | default: 'RINGS' | upcase %}
{% if active_title == 'PRODUCTS' or active_title contains 'COLLECTION' %}
  {% assign active_title = 'RINGS' %}
{% endif %}

<!-- Category Header -->
<header class="category-page-header">
  <h1 class="category-page-title" id="category-page-heading" data-category-page-title>{{ active_title }}</h1>
</header>
<hr class="category-divider-line">

<!-- Product Catalog -->
<main class="collection-catalog-wrap" id="MainContent">
  <div class="collection-products-grid grid--4-col" id="category-grid">
    {% assign found_count = 0 %}
    {% if collection.products.size > 0 %}
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
        {% assign found_count = found_count | plus: 1 %}
      {% endfor %}
    {% else %}
      {% assign target_cat = active_title | downcase %}
      {% for product in collections.all.products %}
        {% assign p_title = product.title | downcase %}
        {% assign p_type = product.type | downcase %}
        {% assign matches = false %}
        {% if target_cat contains 'necklace' and p_title contains 'necklace' or p_type contains 'necklace' or product.tags contains 'necklace' or product.tags contains 'necklaces' %}
          {% assign matches = true %}
        {% elsif target_cat contains 'earring' and p_title contains 'earring' or p_type contains 'earring' or product.tags contains 'earring' or product.tags contains 'earrings' %}
          {% assign matches = true %}
        {% elsif target_cat contains 'ring' and p_title contains 'ring' or p_type contains 'ring' or product.tags contains 'ring' or product.tags contains 'rings' %}
          {% assign matches = true %}
        {% elsif target_cat contains 'bracelet' and p_title contains 'bracelet' or p_type contains 'bracelet' or product.tags contains 'bracelet' or product.tags contains 'bracelets' %}
          {% assign matches = true %}
        {% elsif target_cat contains 'all' or target_cat contains 'shop' %}
          {% assign matches = true %}
        {% endif %}

        {% if matches %}
          {% render 'product-card', product: product %}
          {% assign found_count = found_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if found_count == 0 %}
        {% for product in collections.all.products limit: 12 %}
          {% render 'product-card', product: product %}
          {% assign found_count = found_count | plus: 1 %}
        {% endfor %}
      {% endif %}
    {% endif %}
  </div>
</main>

<hr class="category-divider-line">

<script>
  (function() {
    function initCategoryPage() {
      if (!window.OGE_HELPERS || !window.OGE_CATALOG) {
        setTimeout(initCategoryPage, 40);
        return;
      }

      const path = (window.location.pathname || '').toLowerCase();
      const params = new URLSearchParams(window.location.search);
      let categoryKey = params.get('type') || params.get('category');

      if (!categoryKey) {
        if (path.includes('ring')) categoryKey = 'rings';
        else if (path.includes('necklace')) categoryKey = 'necklaces';
        else if (path.includes('bracelet')) categoryKey = 'bracelets';
        else if (path.includes('earring')) categoryKey = 'earrings';
        else if (path.includes('fine-jewelry') || path.includes('fine')) categoryKey = 'fine-jewelry';
        else if (path.includes('men')) categoryKey = 'men';
        else if (path.includes('new')) categoryKey = 'new';
        else if (path.includes('shop') || path.includes('all')) categoryKey = 'all';
        else categoryKey = 'rings';
      }
      categoryKey = categoryKey.toLowerCase().trim();

      const titles = {
        'earrings': 'EARRINGS',
        'necklaces': 'NECKLACES',
        'bracelets': 'BRACELETS',
        'rings': 'RINGS',
        'men': 'MEN',
        'mens': 'MEN',
        'fine-jewelry': 'FINE JEWELRY',
        'fine': 'FINE JEWELRY',
        'new': 'NEW IN',
        'new-in': 'NEW IN',
        'new-ins': 'NEW IN',
        'jewelries': 'SHOP ALL JEWELRIES',
        'all': 'SHOP ALL JEWELRIES',
        'shop': 'SHOP ALL JEWELRIES'
      };

      const displayTitle = titles[categoryKey] || categoryKey.toUpperCase();
      const headingEl = document.getElementById('category-page-heading') || document.querySelector('[data-category-page-title]');
      if (headingEl) {
        headingEl.textContent = displayTitle;
      }
      document.title = `${displayTitle} — OGÉ Fine Jewelry`;

      // Update active tab highlight
      document.querySelectorAll('.collection-tab-btn').forEach(tab => {
        const tabKey = (tab.getAttribute('data-category-tab') || tab.getAttribute('href') || '').toLowerCase();
        if (tabKey.includes(categoryKey.replace(/s$/, '')) || (categoryKey.includes('ring') && tabKey.includes('ring'))) {
          tab.classList.add('is-active');
        } else {
          tab.classList.remove('is-active');
        }
      });

      const grid = document.getElementById('category-grid');
      if (!grid) return;

      // Check if grid already has Shopify products rendered from Liquid
      const hasLiquidProducts = grid.querySelectorAll('.product-card').length > 0;

      let currentProducts = window.OGE_HELPERS.getProductsByCategory(categoryKey);
      if (!currentProducts || currentProducts.length === 0) {
        currentProducts = window.OGE_CATALOG;
      }

      function renderGrid(items) {
        grid.innerHTML = items.map((p, idx) => window.OGE_HELPERS.renderProductCard(p, idx)).join('');
        if (window.OGE_CURRENCY && typeof window.OGE_CURRENCY.updateDOM === 'function') {
          window.OGE_CURRENCY.updateDOM();
        }
      }

      // If no Shopify products in liquid, render from dataset
      if (!hasLiquidProducts) {
        renderGrid(currentProducts);
      }

      // Density Switcher (1 col, 2 cols, 4 cols)
      const densityBtns = document.querySelectorAll('.grid-density-btn');
      densityBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          densityBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const cols = btn.getAttribute('data-cols') || '4';
          grid.classList.remove('grid--1-col', 'grid--2-col', 'grid--4-col');
          grid.classList.add(`grid--${cols}-col`);
        });
      });

      // Filter & Sort Dropdown
      const filterToggle = document.getElementById('filter-sort-toggle');
      const filterDropdown = document.getElementById('category-filter-dropdown');
      if (filterToggle && filterDropdown) {
        filterToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = filterDropdown.classList.toggle('is-active');
          filterToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });

        document.addEventListener('click', () => {
          filterDropdown.classList.remove('is-active');
          filterToggle.setAttribute('aria-expanded', 'false');
        });

        filterDropdown.querySelectorAll('.filter-option-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            filterDropdown.querySelectorAll('.filter-option-btn').forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            const sort = btn.getAttribute('data-sort');
            let sorted = [...currentProducts];
            if (sort === 'price-low') {
              sorted.sort((a, b) => a.price - b.price);
            } else if (sort === 'price-high') {
              sorted.sort((a, b) => b.price - a.price);
            } else if (sort === 'newest') {
              sorted.sort((a, b) => (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0));
            }
            renderGrid(sorted);
            filterDropdown.classList.remove('is-active');
            filterToggle.setAttribute('aria-expanded', 'false');
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryPage);
    } else {
      initCategoryPage();
    }
  })();
</script>

{% schema %}
{
  "name": "Category Products Grid",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
